{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldx.local/schemas/diagnostic-accuracy/system-output-1.0.0.schema.json",
  "title": "Diagnostic Accuracy System Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "documentId", "pageId", "sampleId", "status", "failures"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "runId": { "$ref": "#/$defs/stableId" },
    "documentId": { "$ref": "#/$defs/stableId" },
    "pageId": { "$ref": "#/$defs/stableId" },
    "sampleId": { "$ref": "#/$defs/stableId" },
    "status": { "enum": ["success", "failed"] },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localization", "text", "conclusion", "attribution"],
      "properties": {
        "localization": { "$ref": "#/$defs/localization" },
        "text": { "type": "string" },
        "conclusion": { "enum": ["correct", "incorrect", "unreadable", "not-an-item"] },
        "attribution": { "$ref": "#/$defs/attribution" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "failures": { "type": "array", "items": { "$ref": "#/$defs/failure" } }
  },
  "oneOf": [
    {
      "required": ["prediction"],
      "properties": {
        "status": { "const": "success" },
        "failures": { "maxItems": 0 }
      }
    },
    {
      "required": ["failures"],
      "not": { "required": ["prediction"] },
      "properties": {
        "status": { "const": "failed" },
        "failures": { "minItems": 1 }
      }
    }
  ],
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "unit"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["pixel", "normalized"] }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject"],
      "properties": {
        "subject": { "enum": ["math", "chinese", "english"] },
        "math": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primaryNodeId": { "$ref": "#/$defs/stableId" },
            "primaryNodeLabel": { "type": "string" },
            "bottleneckId": { "$ref": "#/$defs/stableId" },
            "bottleneckLabel": { "type": "string" }
          }
        },
        "chinese": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "originalItemLocation": { "type": "string" },
            "errorType": { "type": "string" },
            "review": { "type": "string" },
            "migration": { "type": "string" }
          }
        },
        "english": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wordIdentity": { "type": "string" },
            "recognitionSpelling": { "enum": ["recognized-correctly", "recognized-but-misspelled", "unreadable"] },
            "stateUpdate": { "enum": ["recognition-mastered-spelling-mastered", "recognition-mastered-spelling-needs-practice", "no-state-update"] }
          }
        }
      },
      "oneOf": [
        { "required": ["math"], "properties": { "subject": { "const": "math" }, "math": { "required": ["primaryNodeId", "bottleneckId"] }, "chinese": false, "english": false } },
        { "required": ["chinese"], "properties": { "subject": { "const": "chinese" }, "math": false, "chinese": { "required": ["originalItemLocation", "errorType"] }, "english": false } },
        { "required": ["english"], "properties": { "subject": { "const": "english" }, "math": false, "chinese": false, "english": { "required": ["wordIdentity"] } } }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["load", "model", "parse", "localize", "classify", "attribute", "persist"] },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    }
  }
}
