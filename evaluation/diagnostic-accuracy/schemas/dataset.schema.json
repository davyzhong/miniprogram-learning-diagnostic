{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldx.local/schemas/diagnostic-accuracy/dataset-1.0.0.schema.json",
  "title": "Diagnostic Accuracy Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "profile", "documents", "pageInventoryLock", "redactionVerification"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "datasetId": { "$ref": "#/$defs/stableId" },
    "profile": { "enum": ["formal", "exploratory", "fixture"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "pageInventoryLock": { "$ref": "#/$defs/pageInventoryLock" },
    "redactionVerification": { "$ref": "#/$defs/redactionVerification" }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "enum": ["sha256"] },
        "value": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    },
    "cropRectangle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "unit"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["pixel", "normalized"] }
      }
    },
    "compositeRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "enum": ["standalone", "parent", "child"] },
        "parentSampleId": { "$ref": "#/$defs/stableId" },
        "childSampleIds": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleId", "crop", "composite", "hashes", "annotationRefs"],
      "properties": {
        "sampleId": { "$ref": "#/$defs/stableId" },
        "crop": { "$ref": "#/$defs/cropRectangle" },
        "composite": { "$ref": "#/$defs/compositeRelationship" },
        "hashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } },
        "annotationRefs": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "pageNumber", "hashes", "items"],
      "properties": {
        "pageId": { "$ref": "#/$defs/stableId" },
        "pageNumber": { "type": "integer", "minimum": 1 },
        "hashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "subject", "grade", "sourceType", "hashes", "pages"],
      "properties": {
        "documentId": { "$ref": "#/$defs/stableId" },
        "subject": { "enum": ["math", "chinese", "english"] },
        "grade": { "type": ["string", "integer"] },
        "sourceType": { "enum": ["camera", "scan", "screenshot", "synthetic", "other"] },
        "hashes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hash" } },
        "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
      }
    },
    "pageInventoryLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locked", "pageIds", "inventoryHash", "lockedAt"],
      "properties": {
        "locked": { "const": true },
        "pageIds": { "type": "array", "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "inventoryHash": { "$ref": "#/$defs/hash" },
        "lockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "redactionVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verifiedAt", "verifierId"],
      "properties": {
        "status": { "enum": ["verified"] },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "verifierId": { "$ref": "#/$defs/stableId" },
        "notes": { "type": "string" }
      }
    }
  }
}
