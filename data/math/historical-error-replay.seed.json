  "boundaryChecks": [
    {
      "topic": "小数乘法错位 vs 估算检查缺失",
      "decision": "拆成两个卡点。小数点定位是知识/程序错误，估算检查是元认知错误；同一道题可同时命中。"
    },
    {
      "topic": "分数除法倒数规则 vs 分数除法概念模型",
      "decision": "拆成两个卡点。一个验证规则是否能触发，一个验证是否理解除以真分数结果变大。"
    },
    {
      "topic": "百分数单位 1 vs 折扣方向",
      "decision": "拆成两个卡点。单位 1 是基准量判断，折扣方向是关系式乘除选择。"
    },
    {
      "topic": "比例参照系 vs 方程建模",
      "decision": "当前先修比例参照系；方程建模作为下一批新增卡点。"
    },
    {
      "topic": "单位量纲 vs 公式选择",
      "decision": "拆开。单位量纲关注答案单位和进率，公式选择关注目标量与公式匹配。"
    }
  ]
