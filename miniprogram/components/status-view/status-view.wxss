/* 公共状态组件样式：色彩统一走 B1 token（自定义属性可穿透组件样式隔离） */
.status-view {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  color: var(--b1-ink-muted, #566568);
}

.status-view-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 5rpx solid var(--b1-border, #dedbd2);
  border-top-color: var(--b1-informational-fg, #4168b7);
  border-radius: 50%;
  animation: status-view-spin 0.8s linear infinite;
}

@keyframes status-view-spin {
  to { transform: rotate(360deg); }
}

.status-view-text {
  font-size: 26rpx;
  line-height: 1.5;
}

.status-view-error .status-view-text {
  color: var(--b1-destructive-fg, #a52f3a);
}

.status-view-retry {
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--b1-border, #dedbd2);
  background: var(--b1-surface, #fffdfa);
  color: var(--b1-ink, #253436);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.status-view-retry::after {
  border: none;
}
