.page { min-height: 100vh; background: #f7f8fa; padding-bottom: 40rpx; }
.progress-header { padding: 40rpx 32rpx 20rpx; }
.progress-title { font-size: 36rpx; font-weight: 600; color: #1a202c; display: block; }
.progress-subtitle { font-size: 26rpx; color: #718096; margin-top: 8rpx; display: block; }
.card { margin: 16rpx 24rpx; background: #fff; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.section-heading { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.heading-icon { font-size: 32rpx; color: #6366f1; }
.section-heading text { font-size: 30rpx; font-weight: 600; color: #1a202c; }

.advice-text { font-size: 28rpx; color: #2d3748; line-height: 1.6; display: block; margin-bottom: 24rpx; }
.advice-stats { display: flex; gap: 32rpx; }
.advice-stat { text-align: center; }
.advice-stat-num { font-size: 40rpx; font-weight: 700; display: block; }
.advice-stat-label { font-size: 22rpx; color: #718096; }
.advice-stat-improved { color: #22c55e; }
.advice-stat-pending { color: #f59e0b; }
.advice-stat-persisting { color: #ef4444; }

.timeline { position: relative; }
.timeline-node { display: flex; gap: 20rpx; padding-bottom: 32rpx; position: relative; }
.timeline-node:not(:last-child)::before { content: ''; position: absolute; left: 11rpx; top: 28rpx; bottom: 0; width: 2rpx; background: #e2e8f0; }
.timeline-dot { width: 24rpx; height: 24rpx; border-radius: 50%; flex-shrink: 0; margin-top: 8rpx; z-index: 1; }
.dot-diagnosis { background: #6366f1; }
.dot-verify { background: #22c55e; }
.timeline-content { flex: 1; min-width: 0; }
.timeline-header { display: flex; align-items: center; gap: 16rpx; }
.timeline-type { font-size: 26rpx; font-weight: 600; color: #2d3748; }
.timeline-date { font-size: 22rpx; color: #a0aec0; }
.timeline-summary { font-size: 26rpx; color: #4a5568; margin-top: 8rpx; display: block; line-height: 1.5; }
.timeline-meta { margin-top: 8rpx; }
.timeline-meta-item { font-size: 24rpx; color: #718096; }
.timeline-improved { margin-top: 8rpx; display: flex; align-items: flex-start; gap: 8rpx; }
.improved-label { font-size: 24rpx; color: #22c55e; flex-shrink: 0; }
.improved-names { font-size: 24rpx; color: #2d3748; }
.timeline-link { font-size: 24rpx; color: #6366f1; margin-top: 12rpx; display: inline-block; text-decoration: underline; }

.matrix-row { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.matrix-row:last-child { border-bottom: none; }
.matrix-header-row { border-bottom: 2rpx solid #e2e8f0; }
.matrix-cell { padding: 8rpx 4rpx; text-align: center; }
.matrix-cell-name { flex: 0 0 200rpx; font-size: 24rpx; color: #2d3748; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.matrix-cell-round { flex: 1; font-size: 28rpx; min-width: 60rpx; }
.matrix-status-found { color: #6366f1; }
.matrix-status-persisting { color: #ef4444; }
.matrix-status-improved { color: #22c55e; }
.matrix-status-pending { color: #f59e0b; }
.matrix-status-none { color: #e2e8f0; }
.matrix-legend { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 16rpx; }
.legend-item { font-size: 22rpx; color: #718096; display: flex; align-items: center; gap: 6rpx; }
.legend-found { color: #6366f1; }
.legend-persisting { color: #ef4444; }
.legend-improved { color: #22c55e; }
.legend-pending { color: #f59e0b; }
