/* ========== 页面容器 ========== */
.page-container {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 60rpx;
}

/* ========== Loading ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #4a90d9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

/* ========== 学生信息卡片 ========== */
.student-card {
  display: flex;
  align-items: center;
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.avatar-circle {
  flex-shrink: 0;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4a90d9, #7b61ff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.avatar-text {
  font-size: 40rpx;
  color: #fff;
  font-weight: 600;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  display: block;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #555;
}

/* ========== 操作按钮栏 ========== */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin: 0 24rpx 24rpx;
}

.btn-primary {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, #4a90d9, #7b61ff);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
  line-height: 88rpx;
}

.btn-primary::after {
  border: none;
}

.btn-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.btn-outline {
  width: 100%;
  height: 80rpx;
  background: transparent;
  color: #4a90d9;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid #4a90d9;
  border-radius: 12rpx;
  line-height: 80rpx;
  margin-top: 24rpx;
}

.btn-outline::after {
  border: none;
}

.btn-small {
  width: auto;
  padding: 0 48rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  margin-top: 16rpx;
}

/* ========== 区块 ========== */
.section {
  margin: 0 24rpx 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.section-date {
  font-size: 24rpx;
  color: #999;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

/* ========== 报告摘要卡片 ========== */
.report-summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ========== 卡点全景表（简版） ========== */
.summary-table {
  margin-bottom: 24rpx;
}

.table-header {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #eee;
}

.table-header text {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.table-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.table-row:last-child {
  border-bottom: none;
}

.col-category {
  flex: 2;
  font-size: 26rpx;
  color: #333;
}

.col-freq {
  flex: 1;
  font-size: 26rpx;
  color: #555;
  text-align: center;
}

.col-severity {
  flex: 1;
  font-size: 26rpx;
  text-align: right;
  font-weight: 500;
}

.severity-high {
  color: #e74c3c;
}

.severity-medium {
  color: #f39c12;
}

.severity-low {
  color: #27ae60;
}

/* ========== TOP 3 优先卡点 ========== */
.top-bugs {
  margin-bottom: 8rpx;
}

.top-bugs-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 16rpx;
  display: block;
}

.bug-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  margin-bottom: 12rpx;
  background: #fafbfc;
  border-radius: 12rpx;
  border-left: 6rpx solid #ccc;
}

.bug-priority-1 {
  border-left-color: #e74c3c;
}

.bug-priority-2 {
  border-left-color: #f39c12;
}

.bug-priority-3 {
  border-left-color: #f39c12;
}

.bug-index {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #666;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.bug-priority-1 .bug-index {
  background: #fdecea;
  color: #e74c3c;
}

.bug-priority-2 .bug-index {
  background: #fef5e7;
  color: #f39c12;
}

.bug-content {
  flex: 1;
  min-width: 0;
}

.bug-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.bug-desc {
  font-size: 24rpx;
  color: #888;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 历史报告列表 ========== */
.report-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.report-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.report-item:last-child {
  border-bottom: none;
}

.report-item:active {
  background: #f8f9fc;
}

.report-item-left {
  flex: 1;
  min-width: 0;
}

.report-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.report-meta {
  display: flex;
  gap: 16rpx;
}

.meta-tag {
  font-size: 22rpx;
  color: #888;
  background: #f0f2f5;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.report-item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.trend-text {
  font-size: 24rpx;
  color: #999;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}
