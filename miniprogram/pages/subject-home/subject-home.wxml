<!--pages/subject-home/subject-home.wxml-->
<view class="page page-{{subject}}">
  <view class="top-bar">
    <view class="back" bindtap="onBack">‹</view>
    <view class="top-info">
      <text class="subject-label">{{subjectTitle}}</text>
      <text class="student-name">{{studentName}}<text wx:if="{{grade}}"> · {{grade}}年级</text></text>
    </view>
  </view>

  <view class="workbench-card">
    <view class="workbench-header">
      <view class="subject-mark">{{subjectInitial}}</view>
      <view class="workbench-copy">
        <text class="workbench-eyebrow">{{primaryTask.title}}</text>
        <text class="workbench-title">{{primaryTask.actionText}}</text>
      </view>
    </view>
    <text class="workbench-summary">{{primaryTask.summary}}</text>
    <view class="primary-action" bindtap="onPrimaryAction">
      <text>{{primaryTask.actionText}}</text>
      <text class="primary-arrow">›</text>
    </view>
  </view>

  <view class="analysis-state" wx:if="{{analysisStatus}}" bindtap="onAnalysisCardTap">
    <view class="state-icon state-icon-analyzing">···</view>
    <view class="state-copy">
      <text class="state-title">正在整理本次试卷</text>
      <text class="state-desc">{{analysisStatusText || 'AI 后台分析中，可先查看已有入口'}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="quick-strip">
    <view class="quick-cell" bindtap="onQuickStatTap" data-target="pending">
      <text class="quick-num pending-color">{{taskQueue.length}}</text>
      <text class="quick-label">待处理</text>
    </view>
    <view class="quick-cell" bindtap="onQuickStatTap" data-target="records">
      <text class="quick-num">{{totalReports}}</text>
      <text class="quick-label">诊断记录</text>
    </view>
    <view class="quick-cell" bindtap="onQuickStatTap" data-target="improved">
      <text class="quick-num improved-color">{{improvedCount}}</text>
      <text class="quick-label">已改善</text>
    </view>
  </view>

  <view class="section" wx:if="{{taskQueue.length > 0}}">
    <view class="section-heading">
      <view class="heading-icon">1</view>
      <text>待处理队列</text>
    </view>
    <view class="surface">
      <view
        class="task-row"
        wx:for="{{taskQueue}}"
        wx:key="lpCode"
        bindtap="onTaskTap"
        data-code="{{item.lpCode}}"
      >
        <view class="status-icon status-icon-{{item.statusClass}}">{{item.statusIcon}}</view>
        <view class="row-copy">
          <text class="row-title">{{item.displayName}}</text>
          <text class="row-desc">{{item.evidenceText}}<text wx:if="{{item.severityText}}"> · {{item.severityText}}</text></text>
        </view>
        <text class="status-label status-label-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <view class="empty-queue" wx:if="{{taskQueue.length === 0}}">
    <view class="empty-icon">✓</view>
    <view class="empty-copy">
      <text class="empty-title">{{isFirstUse ? '还没有学科记录' : '暂时没有待处理卡点'}}</text>
      <text class="empty-desc">{{isFirstUse ? '上传第一份试卷后，这里会出现可操作的任务。' : '可以继续上传新试卷，观察最近学习情况。'}}</text>
    </view>
  </view>

  <view class="section tools-section">
    <view class="section-heading">
      <view class="heading-icon">2</view>
      <text>工具</text>
    </view>
    <view class="tool-grid">
      <view
        class="tool-item"
        wx:for="{{tools}}"
        wx:key="key"
        bindtap="onToolTap"
        data-key="{{item.key}}"
      >
        <text class="tool-icon">{{item.icon}}</text>
        <text class="tool-title">{{item.title}}</text>
        <text class="tool-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>
