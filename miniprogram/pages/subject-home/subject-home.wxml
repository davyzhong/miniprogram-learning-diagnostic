<!--pages/subject-home/subject-home.wxml-->
<view class="page page-{{subject}}">
  <view class="top-bar">
    <view class="back" bindtap="onBack">‹</view>
    <view class="top-info">
      <text class="subject-label">{{subjectName}}学习诊断</text>
      <text class="student-name">{{studentName}}<text wx:if="{{grade}}"> · {{grade}}年级</text></text>
    </view>
  </view>

  <view class="diagnosis-hero">
    <image class="hero-image" src="/assets/images/math-diagnostic-guide.jpg" mode="aspectFill"></image>
    <view class="hero-copy">
      <text class="hero-eyebrow">{{isFirstUse ? '从第一份试卷开始' : '当前综合诊断'}}</text>
      <text class="hero-title">{{isFirstUse ? '开始整理学习线索' : '今天的学习线索已经整理好了'}}</text>
      <text class="hero-summary">{{currentSummary}}</text>
    </view>
  </view>

  <view class="analysis-state" wx:if="{{analysisStatus}}" bindtap="onAnalysisCardTap">
    <view class="state-icon state-icon-analyzing">···</view>
    <view class="state-copy">
      <text class="state-title">正在整理本次试卷</text>
      <text class="state-desc">{{analysisStatusText || 'AI 后台分析中，历史综合诊断仍可正常阅读'}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="summary-strip" wx:if="{{hasDiagnosis}}">
    <view class="summary-cell">
      <text class="summary-num persisting-color">{{persistingCount}}</text>
      <text class="summary-label">持续出现</text>
    </view>
    <view class="summary-cell">
      <text class="summary-num pending-color">{{pendingCount}}</text>
      <text class="summary-label">需要验证</text>
    </view>
    <view class="summary-cell">
      <text class="summary-num improved-color">{{improvedCount}}</text>
      <text class="summary-label">已有改善</text>
    </view>
  </view>

  <view class="section" wx:if="{{currentBottlenecks.length > 0}}">
    <view class="section-heading">
      <view class="heading-icon">⌁</view>
      <text>学习卡点</text>
    </view>
    <view class="surface">
      <view class="bottleneck-row" wx:for="{{currentBottlenecks}}" wx:key="lpCode">
        <view class="status-icon status-icon-{{item.statusClass}}">{{item.statusIcon}}</view>
        <view class="row-copy">
          <text class="row-title">{{item.displayName}}</text>
          <text class="row-desc">{{item.detailText}}</text>
        </view>
        <text class="status-label status-label-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{recentChanges.length > 0}}">
    <view class="section-heading">
      <view class="heading-icon">↻</view>
      <text>最近变化</text>
    </view>
    <view class="surface">
      <view class="change-row" wx:for="{{recentChanges}}" wx:key="_id" bindtap="onRecordTap" data-id="{{item._id}}">
        <view class="change-dot"></view>
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-desc">{{item.dateText}} · 点击阅读本次报告</text>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="primary-action" bindtap="onPrimaryAction">
    <view class="primary-icon">{{isFirstUse ? '⌾' : '＋'}}</view>
    <text>{{nextAction}}</text>
  </view>

  <view class="section tools-section">
    <view class="section-heading">
      <view class="heading-icon">＋</view>
      <text>更多操作</text>
    </view>
    <view class="tool-grid">
      <view class="tool-item" bindtap="onDiagnosisTap"><text class="tool-icon">⌾</text><text>拍照诊断</text></view>
      <view class="tool-item" bindtap="onDefaultPaperTap"><text class="tool-icon">□</text><text>默认试卷</text></view>
      <view class="tool-item" bindtap="onUploadHistoryTap"><text class="tool-icon">▧</text><text>学习记录</text></view>
    </view>
  </view>
</view>
