<!--pages/subject-home/subject-home.wxml-->
<view class="page page-{{subject}} bplus-page">
  <view class="workbench-card bplus-section {{subject === 'english' ? 'english-hero-card' : ''}}">
    <view class="workbench-hero-layout">
      <view class="workbench-main">
        <view class="workbench-header">
          <view class="subject-mark">{{subjectInitial}}</view>
          <view class="workbench-copy">
            <text class="workbench-eyebrow">{{primaryTask.title}}</text>
            <text class="workbench-title">{{subject === 'english' ? '英语词汇掌握' : primaryTask.actionText}}</text>
          </view>
        </view>
        <text class="workbench-summary">{{primaryTask.summary}}</text>
        <view class="primary-action" wx:if="{{subject !== 'english'}}" bindtap="onPrimaryAction">
          <text>{{primaryTask.actionText}}</text>
          <text class="primary-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="english-action-grid" wx:if="{{subject === 'english'}}">
    <view
      class="english-action-card {{item.recommended ? 'is-recommended' : ''}} {{item.disabled ? 'is-disabled' : ''}}"
      wx:for="{{englishActionCards}}"
      wx:key="key"
      bindtap="onEnglishActionTap"
      data-action-type="{{item.actionType}}"
      data-disabled="{{item.disabled}}"
    >
      <view class="english-action-top">
        <view class="english-action-icon">{{item.icon}}</view>
        <text class="english-action-badge" wx:if="{{item.badgeText}}">{{item.badgeText}}</text>
      </view>
      <text class="english-action-title">{{item.title}}</text>
      <text class="english-action-subtitle">{{item.subtitle}}</text>
      <text class="english-action-meta">{{item.disabled ? item.disabledText : item.meta}}</text>
      <view class="english-action-button">{{item.disabled ? item.disabledText : item.actionText}}</view>
    </view>
  </view>

  <view class="map-entry" wx:if="{{subject !== 'english'}}" bindtap="onKnowledgeMapTap">
    <text class="map-entry-icon">🗺️</text>
    <view class="map-entry-text">
      <text class="map-entry-title">知识地图</text>
      <text class="map-entry-desc">{{pendingTaskCount > 0 ? pendingTaskCount + ' 个待修复卡点' : '查看知识结构'}}</text>
    </view>
    <text class="map-entry-arrow">›</text>
  </view>

  <view class="analysis-state" wx:if="{{analysisStatus}}" bindtap="onAnalysisCardTap">
    <view class="state-icon state-icon-analyzing">···</view>
    <view class="state-copy">
      <text class="state-title">正在整理本次试卷</text>
      <text class="state-desc">{{analysisStatusText || 'AI 后台分析中，可先查看已有入口'}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="quick-strip" wx:if="{{subject !== 'english'}}">
    <view class="quick-cell" bindtap="onQuickStatTap" data-target="pending">
      <text class="quick-num pending-color">{{pendingTaskCount}}</text>
      <text class="quick-label">待处理</text>
    </view>
    <view class="quick-cell" bindtap="onQuickStatTap" data-target="records">
      <text class="quick-num">{{totalReports}}</text>
      <text class="quick-label">诊断记录</text>
    </view>
    <view class="quick-cell" bindtap="onQuickStatTap" data-target="improved">
      <text class="quick-num improved-color">{{improvedCount}}</text>
      <text class="quick-label">已改善</text>
    </view>
  </view>

  <view class="english-vocab-card" wx:if="{{subject === 'english'}}">
    <view class="section-heading">
      <view class="heading-icon">Aa</view>
      <text>个人词库摘要</text>
    </view>
    <view class="english-vocab-status">
      <text class="english-vocab-status-title">{{englishVocabularyStats.totalWords}} 个词已进入个人词库</text>
      <text class="english-vocab-status-desc">词库作为底座自动维护，日常优先从认词练习和纸面听写开始。</text>
    </view>
    <view class="english-stat-grid">
      <view class="english-stat" wx:for="{{englishQuickStats}}" wx:key="key">
        <text class="english-stat-value">{{item.value}}</text>
        <text class="english-stat-label">{{item.label}}</text>
      </view>
    </view>
    <view class="weak-word-list" wx:if="{{englishVocabularyStats.weakWords.length > 0}}">
      <text class="weak-word-label">最近需要多见几次</text>
      <text class="weak-word-item" wx:for="{{englishVocabularyStats.weakWords}}" wx:key="wordId">{{item.word}}</text>
    </view>
  </view>

  <view class="section" wx:if="{{subject === 'chinese' && hasChineseReviewQueue}}">
    <view class="section-heading">
      <view class="heading-icon">1</view>
      <text>待复测错项</text>
    </view>
    <view class="surface">
      <view class="task-row chinese-review-row" wx:for="{{chineseReviewQueue}}" wx:key="viewId">
        <view class="status-icon status-icon-{{item.statusClass}}">{{item.statusIcon}}</view>
        <view class="row-copy">
          <view class="row-title-line">
            <text class="row-title">{{item.displayName}}</text>
            <text class="review-type">{{item.typeText}}</text>
          </view>
          <text class="row-desc">{{item.detailText}}</text>
        </view>
        <text class="status-label status-label-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{subject !== 'english' && taskQueue.length > 0}}">
    <view class="section-heading">
      <view class="heading-icon">{{subject === 'chinese' && hasChineseReviewQueue ? '1+' : '1'}}</view>
      <text>{{subject === 'chinese' && hasChineseReviewQueue ? '能力型卡点' : '待处理队列'}}</text>
    </view>
    <view class="surface">
      <view
        class="task-row"
        wx:for="{{taskQueue}}"
        wx:key="viewId"
        bindtap="onTaskTap"
        data-code="{{item.lpCode}}"
        data-bottleneck-id="{{item.bottleneckId}}"
        data-view-id="{{item.viewId}}"
      >
        <view class="status-icon status-icon-{{item.statusClass}}">{{item.statusIcon}}</view>
        <view class="row-copy">
          <text class="row-title">{{item.displayName}}</text>
          <text class="row-desc">{{item.evidenceText}}<text wx:if="{{item.severityText}}"> · {{item.severityText}}</text></text>
        </view>
        <text class="status-label status-label-{{item.statusClass}}">{{item.statusText}}</text>
      </view>
    </view>
  </view>

  <view class="empty-queue" wx:if="{{subject !== 'english' && pendingTaskCount === 0}}">
    <view class="empty-icon">✓</view>
    <view class="empty-copy">
      <text class="empty-title">{{isFirstUse ? '还没有学科记录' : '暂时没有待处理卡点'}}</text>
      <text class="empty-desc">{{isFirstUse ? '上传第一份试卷后，这里会出现可操作的任务。' : '可以继续上传新试卷，观察最近学习情况。'}}</text>
    </view>
  </view>

  <view class="section tools-section">
    <view class="section-heading">
      <view class="heading-icon">{{subject === 'english' ? '↺' : '2'}}</view>
      <text>{{subject === 'english' ? '辅助入口' : '工具'}}</text>
    </view>
    <view class="tool-grid">
      <view
        class="tool-item"
        wx:for="{{tools}}"
        wx:key="key"
        bindtap="onToolTap"
        data-key="{{item.key}}"
      >
        <text class="tool-icon">{{item.icon}}</text>
        <text class="tool-title">{{item.title}}</text>
        <text class="tool-desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
</view>
