.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding-top: 24rpx;
  padding-bottom: 48rpx;
}

.workbench-card {
  margin: 0 28rpx 22rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffffff 0%, #edf7ff 100%);
  box-shadow: 0 10rpx 26rpx rgba(31, 79, 130, .12);
}

.workbench-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.subject-mark {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f80c9;
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.page-chinese .subject-mark { background: #2f855a; }
.page-english .subject-mark { background: #c05621; }

.page-english .workbench-card {
  background: linear-gradient(135deg, #fffaf5 0%, #fff7ed 46%, #eff6ff 100%);
  box-shadow: 0 10rpx 28rpx rgba(154, 83, 28, .10);
}

.page-english .workbench-eyebrow {
  color: #9c4f24;
}

.page-english .primary-action {
  background: #c05621;
}

.workbench-copy {
  flex: 1;
  min-width: 0;
}

.workbench-eyebrow {
  display: block;
  color: #517293;
  font-size: 23rpx;
  font-weight: 650;
  margin-bottom: 3rpx;
}

.workbench-title {
  display: block;
  color: #1e3650;
  font-size: 34rpx;
  font-weight: 800;
}

.workbench-summary {
  display: block;
  color: #52677d;
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 20rpx;
}

.primary-action {
  margin-top: 22rpx;
  min-height: 84rpx;
  border-radius: 15rpx;
  background: #2768b4;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 750;
}

.primary-arrow {
  font-size: 34rpx;
  margin-top: -2rpx;
}

.analysis-state {
  margin: 0 28rpx 22rpx;
  padding: 22rpx;
  background: #fff8e5;
  border-left: 6rpx solid #f59e0b;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.state-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  margin-right: 16rpx;
}

.state-icon-analyzing {
  color: #9a5b09;
  background: #ffedbc;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  50% { opacity: .55; }
}

.state-copy,
.row-copy {
  flex: 1;
  min-width: 0;
}

.state-title,
.row-title {
  display: block;
  color: #25364a;
  font-size: 27rpx;
  font-weight: 650;
}

.state-desc,
.row-desc {
  display: block;
  color: #8291a3;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 3rpx;
}

.quick-strip {
  margin: 0 28rpx 24rpx;
  padding: 18rpx 0;
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.quick-cell {
  flex: 1;
  text-align: center;
  border-left: 1rpx solid #edf2f7;
}

.quick-cell:first-child { border-left: 0; }

.quick-num {
  display: block;
  color: #25364a;
  font-size: 34rpx;
  font-weight: 760;
}

.quick-label {
  display: block;
  color: #8795a5;
  font-size: 21rpx;
}

.pending-color { color: #c48619; }
.improved-color { color: #25845f; }

.english-vocab-card {
  margin: 0 28rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #fde7cc;
  box-shadow: 0 2rpx 10rpx rgba(154, 83, 28, .06);
}

.english-vocab-status {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  margin-bottom: 16rpx;
}

.english-vocab-status-title {
  display: block;
  color: #7c2d12;
  font-size: 26rpx;
  font-weight: 800;
}

.english-vocab-status-desc {
  display: block;
  color: #7c5f4a;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 4rpx;
}

.english-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.english-stat {
  min-height: 92rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.english-stat-value {
  color: #9c4f24;
  font-size: 30rpx;
  font-weight: 800;
}

.english-stat-label {
  color: #7c5f4a;
  font-size: 19rpx;
  margin-top: 3rpx;
}

.english-vocab-desc {
  display: block;
  color: #7c5f4a;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 16rpx;
}

.weak-word-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.weak-word-label,
.weak-word-item {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.weak-word-label {
  color: #9c4f24;
  background: #fed7aa;
}

.weak-word-item {
  color: #7c2d12;
  background: #fff7ed;
}

.section {
  margin: 0 28rpx 24rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  color: #25364a;
  font-size: 29rpx;
  font-weight: 700;
}

.heading-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 10rpx;
  background: #e6f2ff;
  color: #2b6cb0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.surface {
  background: #fff;
  border-radius: 14rpx;
  padding: 0 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.task-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.task-row:first-child { border-top: 0; }

.row-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.row-title-line .row-title {
  flex: 1;
  min-width: 0;
}

.chinese-review-row .row-desc {
  color: #607466;
}

.review-type {
  background: #dcfce7;
  border-radius: 999rpx;
  color: #166534;
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 750;
  padding: 4rpx 9rpx;
}

.status-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  flex-shrink: 0;
}

.status-icon-persisting { background: #fee2e2; color: #b91c1c; }
.status-icon-pending { background: #fef3c7; color: #a16207; }
.status-icon-improved { background: #dcfce7; color: #166534; }

.status-label {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-label-persisting { background: #fee2e2; color: #b91c1c; }
.status-label-pending { background: #fef3c7; color: #a16207; }
.status-label-improved { background: #dcfce7; color: #166534; }

.empty-queue {
  margin: 0 28rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.empty-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  background: #dcfce7;
  color: #166534;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.empty-copy { flex: 1; min-width: 0; }

.empty-title {
  display: block;
  color: #25364a;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  color: #8291a3;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 4rpx;
}

.tools-section { margin-bottom: 0; }

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.tool-item {
  min-height: 132rpx;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 18rpx 20rpx;
  color: #52677d;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.tool-icon {
  color: #2b6cb0;
  font-size: 31rpx;
  margin-bottom: 8rpx;
}

.page-english .tool-icon {
  color: #c05621;
}

.tool-title {
  color: #25364a;
  font-size: 24rpx;
  font-weight: 700;
}

.tool-desc {
  color: #8a9aab;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 4rpx;
}

.arrow {
  color: #aebaca;
  font-size: 34rpx;
  flex-shrink: 0;
}

.primary-action:active,
.quick-cell:active,
.task-row:active,
.tool-item:active {
  transform: scale(.985);
}

.map-entry { display: flex; align-items: center; padding: 24rpx; margin: 16rpx 0; background: #fff; border-radius: 16rpx; box-shadow: 0 4rpx 16rpx rgba(15,47,82,.05); }
.map-entry:active { background: #f7fafc; }
.map-entry-icon { font-size: 40rpx; margin-right: 20rpx; }
.map-entry-text { flex: 1; }
.map-entry-title { display: block; font-size: 30rpx; font-weight: 600; color: #1a365d; }
.map-entry-desc { display: block; font-size: 24rpx; color: #718096; margin-top: 4rpx; }
.map-entry-arrow { font-size: 32rpx; color: #cbd5e0; }
