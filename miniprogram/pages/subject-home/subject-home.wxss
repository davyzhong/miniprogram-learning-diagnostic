.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding-top: 24rpx;
  padding-bottom: 48rpx;
}

.workbench-card {
  margin: 0 28rpx 22rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffffff 0%, #edf7ff 100%);
  box-shadow: 0 10rpx 26rpx rgba(31, 79, 130, .12);
}

.workbench-hero-layout {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 20rpx;
}

.workbench-main {
  flex: 1;
  min-width: 0;
}

.workbench-illustration {
  width: 100%;
  height: 390rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, .56);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, .45);
  order: -1;
}

.workbench-header {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.subject-mark {
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #2f80c9;
  color: #fff;
  font-size: 34rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.page-chinese .subject-mark { background: #2f855a; }
.page-english .subject-mark { background: #c05621; }

.page-english .workbench-card {
  background: linear-gradient(135deg, #fffaf5 0%, #fff7ed 46%, #eff6ff 100%);
  box-shadow: 0 10rpx 28rpx rgba(154, 83, 28, .10);
}

.page-english .workbench-eyebrow {
  color: #9c4f24;
}

.page-english .primary-action {
  background: #c05621;
}

.page-english .english-hero-card {
  margin-bottom: 18rpx;
}

.page-english .workbench-illustration {
  box-shadow: 0 8rpx 18rpx rgba(154, 83, 28, .12);
}

.workbench-copy {
  flex: 1;
  min-width: 0;
}

.workbench-eyebrow {
  display: block;
  color: #517293;
  font-size: 23rpx;
  font-weight: 650;
  margin-bottom: 3rpx;
}

.workbench-title {
  display: block;
  color: #1e3650;
  font-size: 34rpx;
  font-weight: 800;
}

.workbench-summary {
  display: block;
  color: #52677d;
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 20rpx;
}

.primary-action {
  margin-top: 22rpx;
  min-height: 84rpx;
  border-radius: 15rpx;
  background: #2768b4;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 750;
}

.primary-arrow {
  font-size: 34rpx;
  margin-top: -2rpx;
}

.analysis-state {
  margin: 0 28rpx 22rpx;
  padding: 22rpx;
  background: #fff8e5;
  border-left: 6rpx solid #f59e0b;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.state-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  margin-right: 16rpx;
}

.state-icon-analyzing {
  color: #9a5b09;
  background: #ffedbc;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  50% { opacity: .55; }
}

.state-copy,
.row-copy {
  flex: 1;
  min-width: 0;
}

.state-title,
.row-title {
  display: block;
  color: #25364a;
  font-size: 27rpx;
  font-weight: 650;
}

.state-desc,
.row-desc {
  display: block;
  color: #8291a3;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 3rpx;
}

.quick-strip {
  margin: 0 28rpx 24rpx;
  padding: 18rpx 0;
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.quick-cell {
  flex: 1;
  text-align: center;
  border-left: 1rpx solid #edf2f7;
}

.quick-cell:first-child { border-left: 0; }

.quick-num {
  display: block;
  color: #25364a;
  font-size: 34rpx;
  font-weight: 760;
}

.quick-label {
  display: block;
  color: #8795a5;
  font-size: 21rpx;
}

.pending-color { color: #c48619; }
.improved-color { color: #25845f; }

.english-vocab-card {
  margin: 0 28rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #fde7cc;
  box-shadow: 0 2rpx 10rpx rgba(154, 83, 28, .06);
}

.english-action-grid {
  margin: 0 28rpx 24rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.english-action-card {
  min-height: 300rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #f6d7bd;
  box-shadow: 0 8rpx 22rpx rgba(154, 83, 28, .08);
  display: flex;
  flex-direction: column;
}

.english-action-card.is-recommended {
  border-color: #c05621;
  box-shadow: 0 10rpx 28rpx rgba(192, 86, 33, .15);
}

.english-action-card.is-disabled {
  opacity: .68;
}

.english-action-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
}

.english-action-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #c05621;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 850;
}

.english-action-badge {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #fed7aa;
  color: #9a3412;
  font-size: 19rpx;
  font-weight: 800;
}

.english-action-title {
  display: block;
  color: #25364a;
  font-size: 31rpx;
  font-weight: 850;
  margin-top: 18rpx;
}

.english-action-subtitle {
  display: block;
  color: #61748b;
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 8rpx;
}

.english-action-meta {
  display: block;
  color: #8a6b55;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 12rpx;
  min-height: 54rpx;
}

.english-action-button {
  margin-top: auto;
  min-height: 64rpx;
  border-radius: 14rpx;
  background: #c05621;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 800;
}

.english-action-card.is-disabled .english-action-button {
  background: #cbd5e1;
}

.english-vocab-status {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  margin-bottom: 16rpx;
}

.english-vocab-status-title {
  display: block;
  color: #7c2d12;
  font-size: 26rpx;
  font-weight: 800;
}

.english-vocab-status-desc {
  display: block;
  color: #7c5f4a;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 4rpx;
}

.english-stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.english-stat {
  min-height: 92rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.english-stat-value {
  color: #9c4f24;
  font-size: 30rpx;
  font-weight: 800;
}

.english-stat-label {
  color: #7c5f4a;
  font-size: 19rpx;
  margin-top: 3rpx;
}

.english-vocab-desc {
  display: block;
  color: #7c5f4a;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 16rpx;
}

.weak-word-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.weak-word-label,
.weak-word-item {
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.weak-word-label {
  color: #9c4f24;
  background: #fed7aa;
}

.weak-word-item {
  color: #7c2d12;
  background: #fff7ed;
}

.section {
  margin: 0 28rpx 24rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
  color: #25364a;
  font-size: 26rpx;
  font-weight: 700;
}

.heading-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 10rpx;
  background: #e6f2ff;
  color: #2b6cb0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.surface {
  background: #fff;
  border-radius: 14rpx;
  padding: 0 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.task-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 88rpx;
  padding: 15rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.task-row:first-child { border-top: 0; }

.row-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.row-title-line .row-title {
  flex: 1;
  min-width: 0;
}

.chinese-review-row .row-desc {
  color: #607466;
}

.review-type {
  background: #dcfce7;
  border-radius: 999rpx;
  color: #166534;
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 750;
  padding: 4rpx 9rpx;
}

.review-stage {
  background: #e8f2fb;
  border-radius: 6rpx;
  color: #245b89;
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 700;
  padding: 4rpx 9rpx;
}

.status-icon {
  width: 46rpx;
  height: 46rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  flex-shrink: 0;
}

.status-icon-persisting { background: #fee2e2; color: #b91c1c; }
.status-icon-pending { background: #fef3c7; color: #a16207; }
.status-icon-improved { background: #dcfce7; color: #166534; }

.queue-status-dot {
  border-radius: 999rpx;
  flex-shrink: 0;
  height: 14rpx;
  width: 14rpx;
}

.queue-status-dot-persisting { background: #dc4c4c; }
.queue-status-dot-pending { background: #d99a18; }
.queue-status-dot-improved { background: #25845f; }

.status-label {
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.status-label-persisting { background: #fee2e2; color: #b91c1c; }
.status-label-pending { background: #fef3c7; color: #a16207; }
.status-label-improved { background: #dcfce7; color: #166534; }

.empty-queue {
  margin: 0 28rpx 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.empty-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #dcfce7;
  color: #166534;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.empty-copy { flex: 1; min-width: 0; }

.empty-title {
  display: block;
  color: #25364a;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  color: #8291a3;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 4rpx;
}

.tools-section { margin-bottom: 0; }

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.tool-item {
  min-height: 132rpx;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 18rpx 20rpx;
  color: #52677d;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
}

.tool-icon {
  color: #2b6cb0;
  font-size: 31rpx;
  margin-bottom: 8rpx;
}

.page-english .tool-icon {
  color: #c05621;
}

.tool-title {
  color: #25364a;
  font-size: 24rpx;
  font-weight: 700;
}

.tool-desc {
  color: #8a9aab;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 4rpx;
}

.arrow {
  color: #aebaca;
  font-size: 34rpx;
  flex-shrink: 0;
}

.primary-action:active,
.quick-cell:active,
.task-row:active,
.tool-item:active {
  transform: scale(.985);
}

.map-entry { display: flex; align-items: center; min-height: 88rpx; padding: 16rpx 20rpx; margin: 16rpx 28rpx; background: #fff; border-radius: 10rpx; box-shadow: 0 4rpx 16rpx rgba(15,47,82,.05); }
.map-entry:active { background: #f7fafc; }
.map-entry-icon { font-size: 30rpx; margin-right: 14rpx; }
.map-entry-text { flex: 1; }
.map-entry-title { display: block; font-size: 26rpx; font-weight: 600; color: #1a365d; }
.map-entry-desc { display: block; font-size: 20rpx; color: #718096; margin-top: 2rpx; }
.map-entry-arrow { font-size: 32rpx; color: #cbd5e0; }

.task-row .row-title { font-size: 24rpx; }
.task-row .row-desc { font-size: 20rpx; line-height: 1.35; }

.latest-diagnosis-card {
  background: #fff;
  border: 1rpx solid #dce5ef;
  border-left: 7rpx solid #3974b8;
  border-radius: 10rpx;
  margin: 16rpx 24rpx;
  padding: 18rpx 20rpx;
}
.latest-diagnosis-card.diagnosis-chinese { border-left-color: #c85d42; }
.latest-diagnosis-card.diagnosis-english { border-left-color: #268469; }
.latest-diagnosis-head { align-items: center; display: flex; gap: 12rpx; }
.latest-diagnosis-title-copy { flex: 1; min-width: 0; }
.latest-diagnosis-title { color: #24364b; display: block; font-size: 28rpx; font-weight: 760; }
.latest-diagnosis-date { color: #8391a1; display: block; font-size: 20rpx; margin-top: 3rpx; }
.latest-diagnosis-link { color: #2865a8; flex-shrink: 0; font-size: 21rpx; font-weight: 700; }
.latest-diagnosis-summary { background: #f7f9fc; border-radius: 7rpx; color: #465b70; display: block; font-size: 23rpx; line-height: 1.45; margin-top: 12rpx; padding: 10rpx 12rpx; }
.latest-diagnosis-footer { align-items: center; display: flex; gap: 12rpx; justify-content: space-between; margin-top: 12rpx; }
.latest-diagnosis-stats { color: #64748b; display: flex; flex-wrap: wrap; font-size: 20rpx; gap: 12rpx; }
.latest-diagnosis-action { color: #2865a8; flex-shrink: 0; font-size: 21rpx; font-weight: 700; }

/* B1 subject palettes: diagnosis remains the first actionable surface. */
.subject-action { box-shadow: 0 10rpx 20rpx rgba(37, 99, 235, .20); }
.page-chinese .workbench-card { background: linear-gradient(135deg, #fff8f7, #fff1f0); box-shadow: 0 10rpx 26rpx rgba(185, 28, 28, .10); }
.page-chinese .subject-mark, .page-chinese .primary-action { background: #b42318; }
.page-chinese .workbench-eyebrow, .page-chinese .latest-diagnosis-link, .page-chinese .latest-diagnosis-action { color: #a61b15; }
.page-chinese .latest-diagnosis-card { border-left-color: #b42318; }
.page-chinese .review-type { background: #fef2f2; color: #b42318; }
.page-chinese .review-stage, .page-chinese .status-label-pending { background: #fff7e6; color: #9a6700; }
.page-english .workbench-card, .page-english .english-vocab-card { border-color: #dbe4ff; background: linear-gradient(135deg, #f8faff, #eef2ff); }
.page-english .workbench-eyebrow, .page-english .english-action-icon, .page-english .tool-icon, .page-english .latest-diagnosis-link, .page-english .latest-diagnosis-action { color: #4338ca; }
.page-english .primary-action, .page-english .english-action-button { background: #4f46e5; }
.page-english .english-action-card { border-color: #dbe4ff; box-shadow: 0 8rpx 22rpx rgba(79, 70, 229, .08); }
.page-english .english-action-card.is-recommended { border-color: #4f46e5; box-shadow: 0 10rpx 28rpx rgba(79, 70, 229, .15); }
.page-english .english-action-icon { background: #eef2ff; }
.page-english .english-action-badge { background: #e0e7ff; color: #3730a3; }
.page-english .latest-diagnosis-card { border-left-color: #4f46e5; }
