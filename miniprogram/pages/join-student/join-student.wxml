<view class="page b1-page">
  <view class="card b1-card form-card code-card" wx:if="{{status === 'code'}}">
    <view class="state-icon">码</view>
    <view class="title">输入家庭邀请码</view>
    <view class="hint">由档案创建者在家长管理中生成。</view>
    <input class="code-input form-input" value="{{inviteCode}}" maxlength="8" placeholder="例如 QY8392AB" bindinput="onInviteCodeInput" />
    <view class="error-text" wx:if="{{error}}">{{error}}</view>
    <button class="b1-button-primary form-primary" loading="{{lookingUp}}" bindtap="onLookupCode">查看孩子档案</button>
  </view>

  <view class="card b1-card form-card" wx:if="{{status === 'loading'}}">
    <view class="state-icon">…</view>
    <view class="title">正在读取邀请</view>
  </view>

  <view class="card b1-card form-card" wx:if="{{status === 'ready' || status === 'joined' || status === 'success'}}">
    <view class="state-icon">{{status === 'success' ? '成功' : '加入'}}</view>
    <view class="title">{{student.name || '孩子档案'}}</view>
    <view class="subtitle" wx:if="{{student.grade}}">{{student.grade}} 年级 · {{role === 'owner' ? '创建者' : '共同家长'}}</view>
    <view class="hint" wx:if="{{status === 'ready'}}">加入后，你可以查看这个孩子的诊断报告、验证试卷和学习记录。</view>
    <view class="hint" wx:if="{{status === 'joined'}}">你已经加入这个孩子档案，可以回到首页查看。</view>
    <view class="hint" wx:if="{{status === 'success'}}">已加入成功，可以回到首页查看孩子档案。</view>

    <view class="join-form" wx:if="{{status === 'ready'}}">
      <view class="form-row">
        <view class="form-label">你的身份</view>
        <picker mode="selector" range="{{relationOptions}}" range-key="name" value="{{relationIndex}}" bindchange="onRelationChange">
          <view class="picker-value">{{relationOptions[relationIndex].name}}</view>
        </picker>
      </view>
      <view class="form-row">
        <view class="form-label">显示名称</view>
        <input class="text-input" value="{{displayName}}" placeholder="例如：青羽妈妈" bindinput="onDisplayNameInput" />
      </view>
    </view>
  </view>

  <view class="card b1-card form-card error-card" wx:if="{{status === 'error'}}">
    <view class="state-icon">!</view>
    <view class="title">无法加入</view>
    <view class="hint">{{error}}</view>
    <button class="secondary" bindtap="onRetry">重新检查</button>
  </view>

  <button wx:if="{{status === 'ready'}}" class="b1-button-primary form-primary" loading="{{accepting}}" bindtap="onAccept">加入孩子档案</button>
  <button wx:if="{{status === 'joined' || status === 'success'}}" class="b1-button-primary form-primary" bindtap="onGoHome">回到首页</button>
</view>
