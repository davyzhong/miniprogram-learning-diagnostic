.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  background: #f7fafc;
  color: #1a202c;
}

.join-illustration {
  background: linear-gradient(135deg, #e8f1ff 0%, #fff7ed 100%);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(26, 54, 93, 0.08);
  display: block;
  height: 390rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.card {
  padding: 52rpx 32rpx;
  border-radius: 18rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(26, 54, 93, 0.08);
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: #ebf8ff;
  color: #2b6cb0;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 96rpx;
}

.error-card .state-icon {
  background: #fff5f5;
  color: #c53030;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
}

.subtitle,
.hint {
  margin-top: 18rpx;
  color: #718096;
  font-size: 28rpx;
}

.join-form {
  margin-top: 32rpx;
  text-align: left;
}

.form-row {
  margin-top: 22rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: #718096;
  font-size: 24rpx;
  font-weight: 700;
}

.text-input,
.picker-value,
.code-input {
  min-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f7fafc;
  color: #1a202c;
  font-size: 28rpx;
  line-height: 76rpx;
}

.code-input {
  margin-top: 28rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
}

.error-text {
  margin-top: 16rpx;
  color: #c53030;
  font-size: 24rpx;
}

.primary,
.secondary {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 14rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
}

.primary {
  background: #2b6cb0;
  color: #ffffff;
}

.secondary {
  background: #ffffff;
  color: #2b6cb0;
  border: 2rpx solid #2b6cb0;
}
