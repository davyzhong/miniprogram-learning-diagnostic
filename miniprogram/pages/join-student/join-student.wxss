.page {
  min-height: 100vh;
  padding: 28rpx;
  background: var(--b1-canvas);
  color: var(--b1-ink);
}

.join-illustration {
  background: linear-gradient(135deg, #e8f1ff 0%, #fff7ed 100%);
  border-radius: 22rpx;
  box-shadow: 0 10rpx 30rpx rgba(26, 54, 93, 0.08);
  display: block;
  height: 390rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.card {
  padding: 32rpx 24rpx;
  border-radius: 10rpx;
  background: var(--b1-surface);
  text-align: center;
  box-shadow: none;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 10rpx;
  background: var(--b1-improved-bg);
  color: var(--b1-improved-fg);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
}

.error-card .state-icon {
  background: var(--b1-destructive-bg);
  color: var(--b1-destructive-fg);
}

.title {
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle,
.hint {
  margin-top: 18rpx;
  color: var(--b1-ink-muted);
  font-size: 28rpx;
}

.join-form {
  margin-top: 32rpx;
  text-align: left;
}

.form-row {
  margin-top: 22rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: var(--b1-ink-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.text-input,
.picker-value,
.code-input {
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--b1-border);
  border-radius: 10rpx;
  background: var(--b1-surface);
  color: var(--b1-ink);
  font-size: 28rpx;
  line-height: 76rpx;
}

.code-input {
  margin-top: 28rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

.error-text {
  margin-top: 16rpx;
  color: var(--b1-destructive-fg);
  font-size: 24rpx;
}

.form-primary,
.secondary {
  margin-top: 32rpx;
  height: 96rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.form-primary {
  background: var(--b1-improved-fg);
  color: var(--b1-surface);
}

.secondary {
  background: var(--b1-surface);
  color: var(--b1-ink);
  border: 2rpx solid var(--b1-border);
}

/* 第四批：emoji 符号 */
.setup-deco { font-size: 72rpx; line-height: 1; margin-bottom: 12rpx; }
.eyebrow-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
.state-icon.b1-symbol { font-size: 56rpx; }
