<view class="page bplus-page"><view class="bplus-state" wx:if="{{loading}}">正在准备语文任务…</view><view wx:elif="{{task}}"><text class="eyebrow">读 语文微任务</text><text class="title">{{task.title}}</text><view class="card bplus-section"><text class="label">先这样做</text><text>{{task.method}}</text><text class="label">试试看</text><text>{{task.prompt}}</text></view><textarea placeholder="写下你的答案" value="{{answer}}" bindinput="onInput" maxlength="500"/><button class="bplus-action" bindtap="onSubmit" loading="{{submitting}}">提交这次练习</button><text wx:if="{{result}}">{{result}}</text></view><view class="bplus-empty" wx:else>暂时没有可练的语文任务。</view></view>
