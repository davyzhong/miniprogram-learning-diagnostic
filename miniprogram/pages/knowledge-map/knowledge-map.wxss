.page { min-height: 100vh; padding: 28rpx 28rpx 80rpx; box-sizing: border-box; background: #f5f8fc; }
.loading { text-align: center; padding: 80rpx; color: #a0aec0; font-size: 28rpx; }
.empty { text-align: center; padding: 80rpx 40rpx; color: #a0aec0; }
.empty-title { display: block; font-size: 30rpx; color: #4a5568; margin-bottom: 12rpx; }
.empty-hint { display: block; font-size: 26rpx; color: #a0aec0; line-height: 1.6; margin-bottom: 32rpx; }
.empty-cta { display: inline-block; padding: 18rpx 48rpx; background: #3182ce; color: #fff; border-radius: 32rpx; font-size: 28rpx; }
.empty-cta:active { background: #2c5aa0; }

.hero { align-items: stretch; display: flex; flex-direction: column; gap: 22rpx; padding: 16rpx 0 24rpx; }
.hero-illustration { background: #eef7ff; border-radius: 20rpx; box-shadow: 0 8rpx 22rpx rgba(26, 54, 93, .10); flex-shrink: 0; height: 390rpx; width: 100%; }
.hero-copy { flex: 1; min-width: 0; }
.hero-title { display: block; font-size: 38rpx; font-weight: 700; color: #1a365d; }
.hero-summary { display: block; font-size: 26rpx; color: #718096; margin-top: 12rpx; }
.hero-hint { display: block; font-size: 22rpx; color: #a0aec0; margin-top: 8rpx; }

/* 优先卡点 CTA：把最该处理的卡点放大置顶 */
.priority-card {
  display: flex; align-items: center; gap: 16rpx;
  padding: 28rpx 24rpx; margin-bottom: 24rpx;
  background: linear-gradient(135deg, #fff 0%, #fffaf0 100%);
  border-radius: 18rpx; border-left: 8rpx solid #f59e0b;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, .15);
}
.priority-card:active { transform: scale(.99); }
.priority-badge {
  flex-shrink: 0; padding: 6rpx 14rpx;
  background: #f59e0b; color: #fff; border-radius: 20rpx;
  font-size: 20rpx; font-weight: 600; white-space: nowrap;
}
.priority-body { flex: 1; min-width: 0; }
.priority-name { display: block; font-size: 30rpx; font-weight: 600; color: #1a365d; }
.priority-symptom { display: block; font-size: 24rpx; color: #4a5568; margin-top: 6rpx; line-height: 1.4; }
.priority-action {
  flex-shrink: 0; display: flex; align-items: center; gap: 4rpx;
  padding: 12rpx 20rpx; background: #3182ce; border-radius: 28rpx;
}
.priority-action-text { font-size: 24rpx; color: #fff; font-weight: 500; }
.priority-action-arrow { font-size: 26rpx; color: #fff; }

.domain-list { display: flex; flex-direction: column; gap: 16rpx; }

.domain-card { background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 4rpx 16rpx rgba(15,47,82,.05); }
.domain-header { display: flex; align-items: center; padding: 24rpx; }
.domain-icon { font-size: 40rpx; margin-right: 18rpx; }
.domain-info { flex: 1; min-width: 0; }
.domain-name { display: block; font-size: 28rpx; font-weight: 600; color: #1a365d; }
.domain-stats { display: block; font-size: 22rpx; color: #718096; margin-top: 4rpx; }

.domain-bottlenecks { border-top: 1rpx solid #edf2f7; padding: 8rpx 0; }
.bn-item { display: flex; align-items: center; padding: 20rpx 24rpx; border-left: 6rpx solid #e2e8f0; }
.bn-item.pending { border-left-color: #fbbf24; }
.bn-item.active { border-left-color: #f87171; }
.bn-item.mastered { border-left-color: #34d399; }
.bn-item:active { background: #f7fafc; }
.bn-icon { font-size: 28rpx; margin-right: 14rpx; flex-shrink: 0; }
.bn-text { flex: 1; min-width: 0; }
.bn-name { display: block; font-size: 26rpx; color: #2d3748; font-weight: 500; }
.bn-symptom { display: block; font-size: 22rpx; color: #718096; margin-top: 4rpx; line-height: 1.4; }
.bn-cta {
  flex-shrink: 0; display: flex; align-items: center; gap: 4rpx;
  padding: 8rpx 16rpx; background: #ebf8ff; border-radius: 24rpx;
}
.bn-cta-text { font-size: 22rpx; color: #3182ce; }
.bn-arrow { font-size: 28rpx; color: #3182ce; }

/* 置信度标签 */
.bn-name-row { display: flex; align-items: center; gap: 8rpx; }
.bn-confidence { font-size: 18rpx; padding: 2rpx 8rpx; border-radius: 4rpx; flex-shrink: 0; }
.bn-confidence.high { color: #c53030; background: #fed7d7; }
.bn-confidence.medium { color: #b7791f; background: #fefcbf; }
.bn-confidence.low { color: #718096; background: #e2e8f0; }
