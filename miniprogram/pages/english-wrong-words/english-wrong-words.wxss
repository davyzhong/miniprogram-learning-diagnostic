.page {
  min-height: 100vh;
  background: #f7fafc;
  padding-bottom: 48rpx;
}

.hero {
  background: #9c4f24;
  color: #fff;
  padding: 42rpx 28rpx 34rpx;
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
}

.back {
  width: 62rpx;
  font-size: 48rpx;
  line-height: 1;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow,
.subtitle {
  display: block;
  opacity: .86;
  font-size: 23rpx;
  line-height: 1.45;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  margin: 8rpx 0;
}

.content,
.state-card {
  margin: 24rpx 28rpx 0;
}

.state-card,
.summary-card,
.group-list,
.word-card,
.empty-card {
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, .06);
}

.state-card {
  padding: 28rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.state-card.error {
  background: #fff1f2;
  border-color: #fecdd3;
}

.state-title,
.section-title,
.empty-title {
  display: block;
  color: #25364a;
  font-size: 30rpx;
  font-weight: 760;
}

.state-desc,
.empty-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.summary-card {
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.summary-value {
  color: #9c4f24;
  font-size: 36rpx;
  font-weight: 850;
}

.summary-label {
  color: #7c5f4a;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.section {
  margin-top: 26rpx;
}

.group-list {
  margin-top: 14rpx;
  padding: 4rpx 22rpx;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.group-row:first-child {
  border-top: 0;
}

.group-count {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #9c4f24;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.group-copy {
  flex: 1;
  min-width: 0;
}

.group-title {
  display: block;
  color: #25364a;
  font-size: 26rpx;
  font-weight: 760;
}

.group-desc {
  display: block;
  color: #7c8aa0;
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}

.word-card,
.empty-card {
  margin-top: 14rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.word-main {
  flex: 1;
  min-width: 0;
}

.word-title {
  display: block;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 850;
}

.word-meaning {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  margin-top: 5rpx;
}

.word-tag {
  color: #c2410c;
  background: #ffedd5;
  border-radius: 999rpx;
  padding: 7rpx 12rpx;
  font-size: 20rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.empty-card {
  display: block;
}

.action-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.primary-btn,
.secondary-btn {
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary-btn {
  background: #c05621;
  color: #fff;
}

.secondary-btn {
  background: #fff;
  color: #9c4f24;
  border: 2rpx solid #fed7aa;
}
