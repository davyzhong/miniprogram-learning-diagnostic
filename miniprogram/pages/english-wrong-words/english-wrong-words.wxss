.page {
  min-height: 100vh;
  background: #f7fafc;
  padding-bottom: 48rpx;
}

.hero {
  background: var(--b1-subject-english-fg);
  color: #fff;
  padding: 22rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: stretch;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-illustration {
  width: 100%;
  height: 390rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, .15);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .14);
  order: -1;
}

.eyebrow,
.subtitle {
  display: block;
  opacity: .86;
  font-size: 23rpx;
  line-height: 1.45;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  margin: 8rpx 0;
}

.content,
.state-card {
  margin: 24rpx 28rpx 0;
}

.state-card,
.group-list,
.word-card,
.empty-card {
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, .06);
}

.state-card {
  padding: 28rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.state-card.error {
  background: #fff1f2;
  border-color: #fecdd3;
}

.state-title,
.section-title,
.empty-title {
  display: block;
  color: #25364a;
  font-size: 30rpx;
  font-weight: 760;
}

.state-desc,
.empty-desc {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.composition-card {
  margin-top: 16rpx;
  padding: 20rpx 18rpx;
  border-radius: 16rpx;
  background: var(--b1-surface);
  border: 1rpx solid var(--b1-border);
}

.composition-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--b1-ink-muted);
  margin-bottom: 12rpx;
}

.section {
  margin-top: 26rpx;
}

.group-list {
  margin-top: 14rpx;
  padding: 4rpx 22rpx;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.group-row:first-child {
  border-top: 0;
}

.group-count {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  color: var(--b1-subject-english-fg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.group-copy {
  flex: 1;
  min-width: 0;
}

.group-title {
  display: block;
  color: #25364a;
  font-size: 26rpx;
  font-weight: 760;
}

.group-desc {
  display: block;
  color: #7c8aa0;
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}

.word-card,
.empty-card {
  margin-top: 14rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.word-main {
  flex: 1;
  min-width: 0;
}

.word-title {
  display: block;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 850;
}

.word-meaning {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  margin-top: 5rpx;
}

.word-tag {
  color: #c2410c;
  background: #ffedd5;
  border-radius: 999rpx;
  padding: 7rpx 12rpx;
  font-size: 20rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.empty-card {
  display: block;
}

.word-more {
  margin-top: 8rpx;
  padding: 8rpx 0 2rpx;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 700;
  text-align: center;
}

.action-row {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.primary-btn,
.secondary-btn {
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
}

/* English B1: indigo guides the vocabulary review flow. */
.page { background: #f7f8ff; }
.hero, .primary-btn { background: #4f46e5; }
.state-card { background: #eef2ff; border-color: #c7d2fe; }
.state-card.error { background: #fff1f2; border-color: #fecdd3; }
.group-count { color: #4338ca; }
.group-count { background: #eef2ff; }
.word-tag { color: #4338ca; background: #e0e7ff; }
.secondary-btn { color: #4338ca; border-color: #c7d2fe; }

.primary-btn {
  background: var(--b1-subject-english-fg);
  color: #fff;
}

.secondary-btn {
  background: #fff;
  color: var(--b1-subject-english-fg);
  border: 2rpx solid #fed7aa;
}

/* 第四批：emoji 符号 */
.hero-symbol, .title-symbol, .eyebrow-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
.finish-mark.b1-symbol { font-size: 64rpx; }
