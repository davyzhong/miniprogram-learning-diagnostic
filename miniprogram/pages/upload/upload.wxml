<!--pages/upload/upload.wxml-->
<view class="page b1-page">
  <!-- 顶部说明 -->
  <view class="tip-bar">
    <view class="tip-content">
      <text class="tip-title">{{pageTitle}}</text>
      <text class="tip-desc">{{pageDesc}}</text>
    </view>
  </view>

  <view class="paper-context" wx:if="{{paperId}}">
    <text class="context-label">正在上传到</text>
    <text class="context-code">{{paperCodeText || '当前验证试卷'}}</text>
    <text class="context-meta">{{paperName}}<text wx:if="{{paperQuestionCount > 0}}"> · {{paperQuestionCount}} 题</text></text>
  </view>

  <!-- 拍照提示 -->
  <view class="photo-tips">
    <text class="tip-item">光线充足</text>
    <text class="tip-item">试卷铺平</text>
    <text class="tip-item">字迹清晰</text>
    <text class="tip-item">红笔可见</text>
  </view>

  <!-- 照片网格 -->
  <view class="photo-grid">
    <!-- 已选照片 -->
    <view
      class="photo-slot has-image"
      wx:for="{{images}}"
      wx:key="tempPath"
    >
      <image class="preview-img" src="{{item.tempPath}}" mode="aspectFill" binderror="onImageLoadError" data-index="{{index}}" />
      <view class="name-warning" wx:if="{{item.nameDuplicate}}">同名</view>
      <view class="format-badge" wx:if="{{item.convertedFromHeif}}">已转JPG</view>
      <view class="delete-btn" catchtap="onDeleteImage" data-index="{{index}}">删除</view>
    </view>

    <!-- 添加按钮 -->
    <view
      class="photo-slot add-slot"
      wx:if="{{images.length < 20}}"
      bindtap="onChooseImage"
    >
      <text class="add-icon">+</text>
      <text class="add-text">拍照/相册</text>
    </view>
  </view>

  <view class="image-count">已选 {{images.length}}/20 张</view>

  <!-- 上传进度 -->
  <view class="upload-progress" wx:if="{{uploading}}">
    <view class="progress-info">
      <text>上传中 {{uploadedCount}}/{{images.length}}</text>
      <text>{{uploadProgress}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width:{{uploadProgress}}%;"></view>
    </view>
  </view>

  <!-- 异步提示 -->
  <view class="async-tip">
    <text class="async-icon">处理中</text>
    <text class="async-text">上传完成后即可返回，AI 将在后台分析，完成后可在学习记录查看</text>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <button
      class="btn-primary {{canSubmit ? '' : 'btn-disabled'}}"
      bindtap="onSubmit"
      disabled="{{!canSubmit || uploading}}"
    >
      {{submitBtnText}}
    </button>
  </view>

  <!-- 内测授权遮罩（系统 modal 不可靠时的 fallback） -->
  <view class="consent-overlay" wx:if="{{showConsentOverlay}}">
    <view class="consent-card">
      <view class="consent-title">内测说明与授权</view>
      <view class="consent-body">本小程序为内测版本，会收集孩子姓名、年级、试卷照片和 AI 识别结果，用于生成学习诊断、验证卷和卡点追踪。\n\nAI 诊断可能出错，仅供家庭学习参考，不替代老师或专业评估。内测期间数据保留用于连续学习记录和问题排查。家长可在「AI 用量」页申请删除。\n\n请尽量只上传试卷内容，避免含身份证号、住址等敏感信息。</view>
      <view class="consent-actions">
        <view class="consent-btn consent-decline" catchtap="onConsentDecline">暂不同意</view>
        <view class="consent-btn consent-agree" catchtap="onConsentAgree">同意并继续</view>
      </view>
    </view>
  </view>
</view>
