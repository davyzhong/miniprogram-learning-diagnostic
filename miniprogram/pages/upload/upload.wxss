/* pages/upload/upload.wxss */

.page {
  min-height: 100vh;
  background: #f8f5ef;
  padding-bottom: 180rpx;
}

/* ========== 顶部说明 ========== */
.tip-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 18rpx;
  background: #e1e8fa;
  border-bottom: 1rpx solid #cbd6ed;
  border-radius: 0 0 12rpx 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-content {
  flex: 1;
  min-width: 0;
}

.tip-illustration {
  width: 100%;
  height: 390rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, .68);
  box-shadow: 0 6rpx 16rpx rgba(43, 108, 176, .12);
  order: -1;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #26383a;
  margin-bottom: 4rpx;
}

.tip-desc {
  display: block;
  font-size: 24rpx;
  color: #566568;
  line-height: 1.5;
}

.paper-context {
  background: #fffdfa;
  border: 1rpx solid #dedbd2;
  border-left: 6rpx solid #b37808;
  border-radius: 10rpx;
  box-shadow: none;
  margin: 0 28rpx 18rpx;
  padding: 20rpx 24rpx;
}

.context-label {
  color: #718096;
  display: block;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.context-code {
  color: #6d5000;
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.context-meta {
  color: #53657a;
  display: block;
  font-size: 23rpx;
}

/* ========== 拍照提示 ========== */
.photo-tips {
  display: grid;
  gap: 8rpx;
  grid-template-columns: repeat(4, 1fr);
  padding: 0 28rpx;
  margin-bottom: 12rpx;
}

.tip-item {
  background: #fffdfa;
  border: 1rpx solid #dedbd2;
  border-radius: 6rpx;
  color: #566568;
  font-size: 20rpx;
  padding: 10rpx 0;
  text-align: center;
}

/* ========== 照片网格 ========== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.photo-slot {
  width: calc(25% - 9rpx);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.photo-slot.has-image {
  border: 2rpx solid #dedbd2;
}

.preview-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.name-warning {
  position: absolute;
  left: 4rpx;
  bottom: 4rpx;
  background: rgba(192, 86, 33, 0.9);
  border-radius: 6rpx;
  color: #ffffff;
  font-size: 20rpx;
  padding: 3rpx 7rpx;
}

.format-badge {
  position: absolute;
  left: 4rpx;
  top: 4rpx;
  background: rgba(65, 104, 183, 0.92);
  border-radius: 6rpx;
  color: #ffffff;
  font-size: 20rpx;
  padding: 3rpx 7rpx;
}

.add-slot {
  border: 2rpx dashed #b9b6ad;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fffdfa;
}

.add-icon {
  font-size: 48rpx;
  color: #4168b7;
  line-height: 1;
  margin-bottom: 4rpx;
}

.add-text {
  font-size: 20rpx;
  color: #566568;
}

.image-count {
  text-align: center;
  font-size: 24rpx;
  color: #a0aec0;
  margin-bottom: 20rpx;
}

/* ========== 上传进度 ========== */
.upload-progress {
  margin: 0 28rpx 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #4a5568;
  margin-bottom: 10rpx;
}

.progress-bar {
  height: 10rpx;
  background: #edf2f7;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--b1-informational-fg);
  border-radius: 5rpx;
  transition: width 0.3s ease;
}

/* ========== 异步提示 ========== */
.async-tip {
  display: flex;
  align-items: center;
  margin: 0 28rpx 28rpx;
  padding: 16rpx 20rpx;
  background: #fae9b7;
  border: 1rpx solid #e4cc86;
  border-radius: 8rpx;
}

.async-state {
  color: #6d5000;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.async-text {
  font-size: 24rpx;
  color: #6d5000;
  line-height: 1.4;
}

/* ========== 底部按钮 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fffdfa;
  border-top: 1rpx solid #dedbd2;
  box-shadow: none;
  z-index: 100;
}

.bottom-bar button {
  background: #16775e;
  color: #ffffff;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
  width: 100%;
  line-height: 1.4;
}

.bottom-bar button::after { border: none; }

.bottom-bar button.btn-disabled {
  background: #a5afaa;
  color: #ffffff;
}

.bottom-bar button[disabled] {
  background: #a5afaa;
  color: #ffffff;
}

/* ========== 内测授权遮罩 ========== */
.consent-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.consent-card {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
}
.consent-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  text-align: center;
  margin-bottom: 24rpx;
}
.consent-body {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  white-space: pre-wrap;
  margin-bottom: 36rpx;
}
.consent-actions {
  display: flex;
  gap: 24rpx;
}
.consent-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
}
.consent-decline {
  background: #f0f0f0;
  color: #888;
}
.consent-agree {
  background: #4a6cf7;
  color: #fff;
}

/* 第四批：emoji 符号 */
.tip-title-row { display: flex; align-items: center; gap: 8rpx; }
.tip-symbol, .title-symbol, .kicker-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
