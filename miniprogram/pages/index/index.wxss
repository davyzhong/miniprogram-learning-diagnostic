  font-size: 24rpx;
  line-height: 1.5;
}

.empty-action {
  width: 320rpx;
  margin-top: 30rpx;
}

.home-error-actions {
  width: 100%;
  max-width: 520rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 30rpx;
}

.home-error-actions .empty-action,
.home-error-actions .secondary-action {
  width: auto;
  margin-top: 0;
}

/* 知识地图卡片 */
.map-card {
  padding: 28rpx 24rpx;
}

/* === 知识地图紧凑条（单行，约 88rpx 高）=== */
.map-compact-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
