/* 趋势状态 pill：稳步改善/仍需跟进/等待验证（文字保留，符号只辅助识别） */
.trend-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.trend-pill-symbol {
