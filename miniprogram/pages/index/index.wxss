  border-radius: 24rpx;
}

.map-compact-action-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.map-compact-action-arrow {
  font-size: 26rpx;
  color: #fff;
}

.section-more {
  float: right;
  font-size: 22rpx;
  color: #2b6cb0;
  font-weight: 400;
}

.map-summary {
  display: block;
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 20rpx;
}

.map-domains {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.map-domain {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(25% - 12rpx);
  padding: 20rpx 8rpx;
  background: #f7fafc;
  border-radius: 14rpx;
