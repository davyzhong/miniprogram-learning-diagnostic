  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.child-priority-action {
  margin-top: 8rpx;
  padding: 10rpx 12rpx;
  border-radius: 8rpx;
  gap: 10rpx;
}

.priority-title {
  margin-top: 3rpx;
  font-size: 23rpx;
}

.priority-summary {
  margin-top: 3rpx;
  font-size: 20rpx;
  line-height: 1.3;
}

.priority-action-text {
  font-size: 20rpx;
}

.secondary-action-grid {
  gap: 6rpx;
  margin-top: 6rpx;
}

.secondary-action-card {
  min-width: 0;
  min-height: 86rpx;
  padding: 7rpx 9rpx;
  border-radius: 7rpx;
}

.secondary-action-title {
  font-size: 20rpx;
}

.secondary-action-summary {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.child-status-segments {
  margin-top: 7rpx;
}

.child-status-segments .b1-seg-legend {
  margin-top: 4rpx;
}

.child-panel-label {
  margin-top: 8rpx;
  font-size: 20rpx;
}

.child-subject-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
  margin-top: 5rpx;
}

.child-subject-row {
  min-width: 0;
  min-height: 86rpx;
  margin-top: 0;
  padding: 6rpx 8rpx;
  border-radius: 6rpx;
  gap: 4rpx;
  box-sizing: border-box;
}

.child-subject-row .subject-row-name {
  margin-right: 0;
  font-size: 20rpx;
}

.child-subject-row .subject-row-status {
  min-width: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .quick-link-title,
  .child-subject-row .subject-row-status {
    font-size: 20rpx;
  }
}
