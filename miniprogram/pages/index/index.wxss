/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.profile-home {
  display: flex;
  flex-direction: column;
}

.top-row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: #173f6b;
  margin-bottom: 14rpx;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.top-copy {
  flex: 1;
  min-width: 0;
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  color: #7a8ca4;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.45;
  margin-top: 8rpx;
}

.manage-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-shrink: 0;
}

.manage-link {
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #e0f2fe;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.family-manage-link {
  min-height: 60rpx;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  gap: 6rpx;
  background: #fff;
  border: 1rpx solid #cddce7;
  color: #245f8c;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.manage-icon {
  font-size: 23rpx;
  line-height: 1;
}

.switch-student-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  background: #2563eb;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, .25);
}

.switch-student-btn:active {
  background: #1d4ed8;
  transform: scale(.97);
}

.switch-icon {
  font-size: 26rpx;
  line-height: 1;
}

.switch-text {
  font-size: 24rpx;
}

.child-workbench-section {
  margin-top: 8rpx;
}

.child-card {
  margin-top: 10rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #d7e2e8;
  box-shadow: 0 3rpx 12rpx rgba(27, 57, 78, .06);
}

.child-card-pending {
  border-left: 6rpx solid #2468a8;
}

.child-card-clear {
  border-left: 6rpx solid #2f7d64;
}

.child-card-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.child-identity-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.child-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  background: #173f6b;
  color: #fff;
  font-size: 26rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.child-identity-copy {
  flex: 1;
  min-width: 0;
}

.child-identity-title,
.child-identity-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.child-identity-status {
  margin-top: 3rpx;
}

.child-name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

.child-meta-inline,
.child-updated {
  overflow: hidden;
  color: #718392;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.child-meta-inline {
  flex: 1;
  min-width: 0;
}

.child-updated {
  flex: 1;
  min-width: 36rpx;
}

.child-status {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.child-status-pending {
  color: #be123c;
}

.child-status-clear {
  color: #15803d;
}

.child-status-icon {
  font-size: 14rpx;
  line-height: 1;
}

.child-profile-link {
  color: #245f8c;
  font-size: 19rpx;
  font-weight: 750;
  white-space: nowrap;
  flex-shrink: 0;
}

.family-metric-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}

.child-metric-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-top: 1rpx solid #e3ebef;
  border-bottom: 1rpx solid #e3ebef;
}

.child-metric-cell {
  min-height: 64rpx;
  padding: 8rpx 6rpx;
  border-right: 1rpx solid #e3ebef;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 24rpx minmax(0, 1fr);
  grid-template-rows: 29rpx 19rpx;
  align-items: center;
  column-gap: 3rpx;
}

.child-metric-cell:last-child {
  border-right: 0;
}

.status-cell-warning {
  color: #c2410c;
}

.status-cell-primary {
  color: #1d4ed8;
}

.status-cell-danger {
  color: #b91c1c;
}

.status-cell-success {
  color: #15803d;
}

.child-metric-icon {
  grid-row: 1;
  grid-column: 1;
  font-size: 20rpx;
  line-height: 1;
}

.child-metric-num {
  grid-row: 1;
  grid-column: 2;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1;
}

.child-metric-label {
  grid-row: 2;
  grid-column: 1 / 3;
  overflow: hidden;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1.1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.child-subject-status {
  display: flex;
  flex-direction: column;
}

.child-subject-row {
  min-height: 64rpx;
  padding: 8rpx 10rpx;
  border-top: 1rpx solid #e3ebef;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.child-subject-row.is-hidden {
  color: #8291a5;
}

.subject-row-copy {
  flex: 1;
  min-width: 0;
}

.subject-row-icon {
  width: 28rpx;
  flex: 0 0 28rpx;
  font-size: 22rpx;
  line-height: 1;
  text-align: center;
}

.subject-row-accent {
  width: 4rpx;
  height: 32rpx;
  border-radius: 2rpx;
  background: #2468a8;
  flex: 0 0 auto;
}

.child-subject-chinese .subject-row-accent { background: #9b5142; }
.child-subject-english .subject-row-accent { background: #8a6b2f; }

.subject-name-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.subject-row-name {
  color: #1f2937;
  font-size: 21rpx;
  font-weight: 850;
  flex: 0 0 auto;
}

.subject-row-summary {
  overflow: hidden;
  color: #64748b;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subject-row-status {
  color: #1d4ed8;
  font-size: 18rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.subject-row-action {
  color: #52677d;
  font-size: 18rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.child-priority-row {
  min-height: 70rpx;
  padding: 10rpx 12rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-left: 6rpx solid #2468a8;
  background: #eaf3fb;
  box-sizing: border-box;
}

.priority-paper {
  border-left-color: #2468a8;
  background: #e8f1fb;
}

.priority-verification {
  border-left-color: #7255a5;
  background: #f2eef9;
}

.priority-upload {
  border-left-color: #c76b18;
  background: #fff5e8;
}

.priority-icon {
  width: 34rpx;
  flex: 0 0 34rpx;
  font-size: 27rpx;
  line-height: 1;
  text-align: center;
}

.priority-copy {
  flex: 1;
  min-width: 0;
}

.child-panel-label {
  display: block;
  color: #52677d;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1.2;
}

.priority-title {
  display: block;
  color: #1f2937;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
}

.priority-summary {
  display: block;
  overflow: hidden;
  color: #475569;
  font-size: 18rpx;
  line-height: 1.3;
  margin-top: 2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.priority-action-text {
  color: #1d4ed8;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.child-secondary-actions {
  display: flex;
  flex-direction: column;
}

.child-secondary-action {
  min-height: 58rpx;
  padding: 8rpx 10rpx;
  border-top: 1rpx solid #e3ebef;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 28rpx auto minmax(0, 1fr) 14rpx;
  align-items: center;
  gap: 7rpx;
}

.secondary-action-icon {
  font-size: 22rpx;
  line-height: 1;
}

.secondary-action-title {
  color: #1f2937;
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.secondary-action-summary {
  overflow: hidden;
  color: #64748b;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-chevron {
  color: #718392;
  font-size: 22rpx;
  text-align: right;
}

.child-quick-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}

.child-quick-link {
  min-height: 78rpx;
  border-radius: 8rpx;
  padding: 8rpx 6rpx;
  background: #eef5f7;
  box-sizing: border-box;
  text-align: center;
}

.quick-link-icon {
  display: block;
  font-size: 22rpx;
  line-height: 1;
}

.quick-link-title {
  display: block;
  color: #1e3a8a;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.15;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-link-summary {
  display: block;
  color: #64748b;
  font-size: 15rpx;
  line-height: 1.15;
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-workbench-hero {
  margin-top: 8rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #eef5f7;
  border: 1rpx solid #cbdde3;
  box-shadow: 0 3rpx 12rpx rgba(27, 57, 78, .06);
}

.family-workbench-hero:active,
.personal-hero-card:active,
.personal-primary-action:active,
.personal-report-card:active,
.personal-action-card:active,
.personal-subject-row:active {
  transform: scale(.99);
  opacity: .9;
}

.family-hero-copy {
  padding: 14rpx 16rpx;
  background: #eef5f7;
}

.family-summary-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.family-summary-icon {
  width: 40rpx;
  flex: 0 0 40rpx;
  font-size: 29rpx;
  line-height: 1;
  text-align: center;
}

.family-summary-copy {
  flex: 1;
  min-width: 0;
}

.family-hero-title {
  display: block;
  overflow: hidden;
  color: #173f6b;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-hero-summary {
  display: block;
  overflow: hidden;
  margin-top: 2rpx;
  color: #52677d;
  font-size: 18rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-metric-strip {
  margin-top: 10rpx;
}

.family-metric-cell {
  min-height: 60rpx;
  padding: 7rpx 5rpx;
  border-right: 1rpx solid #cbdde3;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 22rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 3rpx;
}

.family-metric-cell:last-child {
  border-right: 0;
}

.family-metric-icon {
  grid-row: 1;
  font-size: 18rpx;
  line-height: 1;
}

.family-metric-value {
  grid-row: 1;
  color: #1d4ed8;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.family-metric-label {
  grid-column: 1 / 3;
  overflow: hidden;
  color: #64748b;
  font-size: 16rpx;
  font-weight: 750;
  line-height: 1.1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-hero-action {
  color: #1d4ed8;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.personal-hero-card {
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(31, 79, 130, .10);
  border: 1rpx solid #dbeafe;
}

.personal-hero-copy {
  padding: 26rpx;
  background: linear-gradient(135deg, #eef7ff 0%, #fff 100%);
}

.personal-hero-title {
  display: block;
  color: #173f6b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.personal-hero-summary {
  display: block;
  color: #52677d;
  font-size: 23rpx;
  line-height: 1.55;
  margin-top: 12rpx;
}

.personal-hero-action {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
}

.personal-primary-action {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #173f6b 0%, #2563eb 100%);
  color: #fff;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, .22);
}

.personal-action-badge {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  flex-shrink: 0;
}

.personal-primary-copy {
  flex: 1;
  min-width: 0;
}

.personal-primary-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.personal-primary-summary {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .82);
  font-size: 22rpx;
  line-height: 1.45;
}

.personal-primary-link {
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.personal-report-card {
  margin-top: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 20rpx;
  background: #fff;
  border-left: 8rpx solid #f97316;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.report-empty-report {
  border-left-color: #94a3b8;
}

.report-empty-report .report-mark {
  background: #f1f5f9;
  color: #475569;
  border-color: #e2e8f0;
}

.section-subtitle-inline {
  color: #7b8da3;
  font-size: 21rpx;
  font-weight: 700;
}

.personal-action-queue {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.personal-action-card {
  min-height: 164rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 6rpx 18rpx rgba(31, 79, 130, .06);
  box-sizing: border-box;
}

.personal-action-title {
  display: block;
  color: #173f6b;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.personal-action-summary {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.38;
}

.personal-action-link {
  display: block;
  margin-top: 12rpx;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 900;
}

.personal-subject-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.personal-subject-row {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e0ecfa;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.personal-subject-copy {
  flex: 1;
  min-width: 0;
}

.personal-subject-name {
  display: block;
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 900;
}

.personal-subject-summary {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
}

.personal-subject-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.personal-subject-status {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 19rpx;
  font-weight: 850;
}

.personal-subject-action {
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.hero-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
}

.hero-image {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #dbeafe;
}

.hero-copy {
  padding: 26rpx 26rpx 30rpx;
  background: #eef7ff;
}

.student-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mini-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #36b9aa;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-copy {
  min-width: 0;
}

.hero-action {
  margin-left: auto;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.student-name {
  display: block;
  color: #173f6b;
  font-size: 32rpx;
  font-weight: 800;
}

.student-meta {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.section-kicker {
  display: block;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.hero-title {
  display: block;
  color: #173f6b;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.hero-summary {
  display: block;
  color: #52677d;
  font-size: 24rpx;
  line-height: 1.65;
  margin-top: 14rpx;
}

.primary-report-card {
  margin-top: 20rpx;
  padding: 24rpx 22rpx;
  border-radius: 18rpx;
  background: #fff;
  border-left: 8rpx solid #f97316;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.report-mark {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 850;
  background: #ffedd5;
  color: #c2410c;
  border: 2rpx solid #fed7aa;
}

.report-verification-report {
  background: #dcfce7;
  color: #15803d;
  border-color: #bbf7d0;
}

.primary-report-copy {
  flex: 1;
  min-width: 0;
}

.report-title-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  justify-content: space-between;
}

.report-title-copy {
  flex: 1;
  min-width: 0;
}

.primary-report-title {
  display: block;
  color: #1f2937;
