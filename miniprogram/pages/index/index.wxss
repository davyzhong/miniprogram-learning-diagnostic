}

.next-card {
  padding: 24rpx;
}

.next-title {
  display: block;
  color: #173f6b;
  font-size: 28rpx;
  font-weight: 800;
}

.next-desc {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.action-grid {
