}

/* 知识地图卡片 */
.map-card {
  padding: 28rpx 24rpx;
}

/* === 知识地图紧凑条（单行，约 88rpx 高）=== */
.map-compact-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #2563eb;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, .08);
}

.map-compact-bar:active {
  transform: scale(.99);
  opacity: .9;
}

.map-compact-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.map-compact-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.map-compact-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
}

.map-compact-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a365d;
  line-height: 1.3;
}

.map-compact-summary {
  font-size: 22rpx;
  color: #4a5568;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-compact-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background: #2563eb;
  border-radius: 24rpx;
}

.map-compact-action-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.map-compact-action-arrow {
  font-size: 26rpx;
  color: #fff;
}

.section-more {
  float: right;
  font-size: 22rpx;
  color: var(--b1-informational-fg);
  font-weight: 400;
}

.map-summary {
  display: block;
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 20rpx;
}

.map-domains {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.map-domain {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(25% - 12rpx);
  padding: 20rpx 8rpx;
  background: #f7fafc;
  border-radius: 14rpx;
