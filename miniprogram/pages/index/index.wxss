/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.profile-home {
  display: flex;
  flex-direction: column;
}

.top-row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: #173f6b;
  margin-bottom: 14rpx;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.top-copy {
  flex: 1;
  min-width: 0;
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  color: #7a8ca4;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.45;
  margin-top: 8rpx;
}

.manage-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-shrink: 0;
}

.manage-link {
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #e0f2fe;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.switch-student-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  background: #2563eb;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, .25);
}

.switch-student-btn:active {
  background: #1d4ed8;
  transform: scale(.97);
}

.switch-icon {
  font-size: 26rpx;
  line-height: 1;
}

.switch-text {
  font-size: 24rpx;
}

.child-workbench-section {
  margin-top: 10rpx;
}

.child-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
}

.child-card-pending {
  border-left: 8rpx solid #2563eb;
}

.child-card-clear {
  border-left: 8rpx solid #22c55e;
}

.child-card-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.child-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #173f6b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.child-main {
  flex: 1;
  min-width: 0;
}

.child-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.child-name {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.25;
}

.child-status {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.child-status-pending {
  background: #ffe4e6;
  color: #be123c;
}

.child-status-clear {
  background: #dcfce7;
  color: #15803d;
}

.child-meta {
  display: block;
  color: #64748b;
  font-size: 21rpx;
  margin-top: 5rpx;
  line-height: 1.35;
}

.child-subject-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.child-subject-row {
  min-height: 76rpx;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  background: #f8fbff;
  border: 1rpx solid #e0ecfa;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.child-subject-row.is-hidden {
  background: #f8fafc;
  border-color: #e2e8f0;
}

.subject-row-copy {
  min-width: 0;
}

.subject-row-name {
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 850;
  margin-right: 12rpx;
}

.subject-row-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-width: 0;
}

.subject-row-symbol {
  font-size: 28rpx;
}

.subject-row-summary {
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
}

.subject-row-status {
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.child-priority-action {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #bfdbfe;
  background: linear-gradient(135deg, #eff6ff 0%, #f8fbff 100%);
}

.priority-paper {
  border-color: #93c5fd;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
}

.priority-verification {
  border-color: #c4b5fd;
  background: linear-gradient(135deg, #f5f3ff 0%, #eef2ff 100%);
}

.priority-upload {
  border-color: #fed7aa;
  background: linear-gradient(135deg, #fff7ed 0%, #fffbeb 100%);
}

.priority-copy {
  flex: 1;
  min-width: 0;
}

.mini-section-label,
.child-panel-label {
  display: block;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 850;
  letter-spacing: .04em;
}

.priority-title {
  display: block;
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.3;
  margin-top: 6rpx;
}

.priority-summary {
  display: block;
  color: #475569;
  font-size: 21rpx;
  line-height: 1.45;
  margin-top: 6rpx;
}

.priority-action-text {
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.secondary-action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.secondary-action-card {
  min-height: 112rpx;
  border-radius: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.secondary-action-title {
  display: block;
  color: #1f2937;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1.3;
}

.secondary-action-summary {
  display: block;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 8rpx;
}

.child-panel-label {
  color: #475569;
  margin-top: 18rpx;
}

.child-quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 14rpx;
}

.child-quick-link {
  min-height: 96rpx;
  border-radius: 16rpx;
  padding: 12rpx 10rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  box-sizing: border-box;
}

.quick-link-title {
  display: block;
  color: #1e3a8a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
}

.quick-link-summary {
  display: block;
  color: #64748b;
  font-size: 20rpx;
  line-height: 1.25;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.family-summary-strip {
  box-sizing: border-box;
  height: 68rpx;
  margin-top: 10rpx;
  padding: 0 16rpx;
  border: 1rpx solid #b9d8cd;
  border-radius: 8rpx;
  background: #edf7f3;
  display: flex;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}

.family-summary-label {
  flex: 0 0 auto;
  color: #285f53;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
  white-space: nowrap;
}

.family-summary-metrics {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  overflow: hidden;
  white-space: nowrap;
}

.family-summary-idle,
.family-summary-separator,
.family-summary-metric {
  flex: 0 0 auto;
  font-size: 20rpx;
  font-weight: 750;
  line-height: 28rpx;
  white-space: nowrap;
}

.family-summary-idle {
  color: var(--b1-neutral-fg);
}

.family-summary-separator {
  color: var(--b1-ink-muted);
}

.family-summary-metric-waiting {
  color: var(--b1-waiting-fg);
}

.family-summary-metric-destructive {
  color: var(--b1-destructive-fg);
}

.family-summary-metric-improved {
  color: var(--b1-improved-fg);
}

.icon-compatibility-entry {
  min-height: 76rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #bfd7ef;
  border-radius: 12rpx;
  background: #eef6ff;
}

.icon-compatibility-entry:active {
  opacity: .82;
}

.icon-compatibility-entry-copy {
  min-width: 0;
  flex: 1;
}

.icon-compatibility-entry-title,
.icon-compatibility-entry-meta {
  display: block;
}

.icon-compatibility-entry-title {
  color: #294d73;
  font-size: 22rpx;
  font-weight: 800;
}

.icon-compatibility-entry-meta {
  margin-top: 4rpx;
  color: #64748b;
  font-size: 20rpx;
}

.icon-compatibility-entry-action {
  flex-shrink: 0;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 700;
}

.personal-action-card:active,
.personal-subject-row:active {
  transform: scale(.99);
  opacity: .9;
}

.section-subtitle-inline {
  color: #7b8da3;
  font-size: 21rpx;
  font-weight: 700;
}

.personal-action-queue {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.personal-action-card {
  min-height: 164rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 6rpx 18rpx rgba(31, 79, 130, .06);
  box-sizing: border-box;
}

.personal-action-title {
  display: block;
  color: #173f6b;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.personal-action-summary {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.38;
}

.personal-action-link {
  display: block;
  margin-top: 12rpx;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 900;
}

.personal-subject-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.personal-subject-row {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e0ecfa;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.personal-subject-copy {
  flex: 1;
  min-width: 0;
}

.personal-subject-name {
  display: block;
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 900;
}

.personal-subject-name-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.personal-subject-name-line .personal-subject-name {
  flex: 1;
  min-width: 0;
}

.confidence-tag {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  border-radius: 7rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.confidence-tag.confidence-high { background: var(--b1-priority-bg); color: var(--b1-priority-fg); }
.confidence-tag.confidence-medium { background: var(--b1-waiting-bg); color: var(--b1-waiting-fg); }
.confidence-tag.confidence-low { background: var(--b1-neutral-bg); color: var(--b1-neutral-fg); }

.personal-subject-summary {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
}

.personal-subject-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

/* Compact functional layer on the restored visual baseline. */
.child-card { border-radius: 12rpx; margin-top: 12rpx; padding: 16rpx 18rpx; }
.child-card-top { gap: 12rpx; }
.child-avatar { border-radius: 10rpx; height: 62rpx; width: 62rpx; }
.child-meta { margin-top: 2rpx; }
.child-priority-action { margin-top: 11rpx; padding: 13rpx 15rpx; }
.secondary-action-grid { gap: 8rpx; margin-top: 10rpx; }
.secondary-action-card { min-height: 82rpx; padding: 11rpx 13rpx; }
.child-panel-label { margin-top: 12rpx; }
.child-subject-list { gap: 7rpx; margin-top: 8rpx; }
.child-subject-row { border-radius: 8rpx; min-height: 58rpx; padding: 9rpx 12rpx; }
.child-quick-grid { gap: 8rpx; margin-top: 8rpx; }
.child-quick-link { min-height: 76rpx; padding: 10rpx 12rpx; }

.profile-summary-line { align-items: baseline; display: flex; flex-wrap: wrap; gap: 6rpx 12rpx; margin-top: 4rpx; }
.profile-summary-name { color: #24364b; font-size: 24rpx; font-weight: 760; }
.profile-summary-meta { color: #718096; font-size: 20rpx; line-height: 1.35; }

.child-diagnosis-list { border-top: 1rpx solid #dce5ef; margin-top: 11rpx; padding-top: 9rpx; }
.child-diagnosis-head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 4rpx; }
.child-diagnosis-count { color: #718096; font-size: 20rpx; }

.child-latest-diagnosis {
  align-items: center;
  background: #f5f9fd;
  border-left: 5rpx solid #3974b8;
  display: flex;
  gap: 14rpx;
  margin-top: 5rpx;
  padding: 9rpx 11rpx;
}
.child-diagnosis-copy { flex: 1; min-width: 0; }
.child-diagnosis-label { color: #64748b; display: block; font-size: 20rpx; }
.child-diagnosis-title-line { align-items: baseline; display: flex; gap: 10rpx; }
.child-diagnosis-title { color: #24364b; font-size: 23rpx; font-weight: 780; margin-right: 10rpx; }
.child-diagnosis-date { color: #8391a1; flex-shrink: 0; font-size: 20rpx; }
.child-diagnosis-summary { color: #64748b; display: block; font-size: 20rpx; line-height: 1.35; margin-top: 3rpx; }
.child-diagnosis-action { color: #2865a8; flex-shrink: 0; font-size: 21rpx; font-weight: 720; }

.diagnosis-workbench-section { margin-bottom: 16rpx; }
.diagnosis-section-head { align-items: baseline; display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.diagnosis-section-title { color: #24364b; font-size: 29rpx; font-weight: 800; }
.diagnosis-section-meta { color: #7b8a9a; font-size: 20rpx; }
.diagnosis-workbench { background: #fff; border: 1rpx solid #dce5ef; border-left: 6rpx solid #3974b8; margin-top: 8rpx; padding: 14rpx 16rpx; }
.diagnosis-workbench.diagnosis-chinese { border-left-color: #c85d42; }
.diagnosis-workbench.diagnosis-english { border-left-color: #268469; }
.diagnosis-head { align-items: center; display: flex; gap: 12rpx; }
.diagnosis-title-copy { flex: 1; min-width: 0; }
.diagnosis-title { color: #24364b; display: block; font-size: 25rpx; font-weight: 780; }
.diagnosis-date { color: #8391a1; display: block; font-size: 20rpx; margin-top: 2rpx; }
.diagnosis-report-link { color: #2865a8; flex-shrink: 0; font-size: 20rpx; font-weight: 700; }
.diagnosis-judgment { background: #f7f9fc; color: #465b70; display: block; font-size: 21rpx; line-height: 1.4; margin-top: 9rpx; padding: 8rpx 10rpx; }
.diagnosis-next { align-items: center; border-top: 1rpx solid #edf2f7; display: flex; gap: 12rpx; margin-top: 9rpx; padding-top: 9rpx; }
.diagnosis-next-copy { flex: 1; min-width: 0; }
.diagnosis-next-title { color: #24364b; display: block; font-size: 22rpx; font-weight: 750; }
.diagnosis-next-summary { color: #64748b; display: block; font-size: 20rpx; line-height: 1.35; margin-top: 2rpx; }
.diagnosis-next-action { color: #2865a8; flex-shrink: 0; font-size: 20rpx; font-weight: 720; }
.diagnosis-load-state { background: #f8fafc; color: #64748b; font-size: 21rpx; margin-bottom: 14rpx; padding: 14rpx; }

.personal-subject-status {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 850;
}

.personal-subject-action {
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

/* Task 3: B1 family workbench. Keep the restored compact information hierarchy. */
.page {
  background: var(--b1-canvas);
}

.top-row,
.page-title,
.child-name,
.priority-title,
.diagnosis-title,
.diagnosis-section-title {
  color: var(--b1-ink-strong);
}

.page-subtitle,
.child-meta,
.priority-summary,
.child-diagnosis-summary,
.diagnosis-next-summary {
  color: var(--b1-ink-muted);
}

.manage-link {
  background: var(--b1-informational-bg);
  color: var(--b1-informational-fg);
}

.child-card {
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--b1-surface);
  border-color: var(--b1-border);
  box-shadow: 0 5rpx 16rpx rgba(38, 56, 58, .06);
}

.child-card-pending { border-left-color: var(--b1-priority-fg); }
.child-card-clear { border-left-color: var(--b1-improved-fg); }

.child-avatar {
  width: 62rpx;
  height: 62rpx;
  background: var(--b1-ink-strong);
}

.b1-metric {
  border: 1rpx solid transparent;
}

.b1-metric-waiting { background: var(--b1-waiting-bg); border-color: #E7CC7C; color: var(--b1-waiting-fg); }
.b1-metric-informational { background: var(--b1-informational-bg); border-color: #C5D2EE; color: var(--b1-informational-fg); }
.b1-metric-destructive { background: var(--b1-destructive-bg); border-color: #E9BAC0; color: var(--b1-destructive-fg); }
.b1-metric-improved { background: var(--b1-improved-bg); border-color: #B6DCCD; color: var(--b1-improved-fg); }

.b1-priority {
  border-color: #EEB6AD;
  background: var(--b1-priority-bg);
}

.b1-priority .mini-section-label,
.b1-priority .priority-action-text {
  color: var(--b1-priority-fg);
}

.secondary-action-card,
.child-quick-link {
  min-height: 86rpx;
  padding: 10rpx 12rpx;
  background: var(--b1-surface);
  border-color: var(--b1-border);
}

.child-subject-row,
.child-latest-diagnosis {
  min-height: 86rpx;
  margin-top: 5rpx;
  padding: 9rpx 12rpx;
  border-color: transparent;
}

.child-latest-diagnosis { border-left: 5rpx solid var(--b1-border); margin-top: 5rpx; padding: 9rpx 12rpx; }

.child-subject-row.b1-subject-chinese,
.child-latest-diagnosis.b1-subject-chinese { border-left-color: var(--b1-subject-chinese-fg); }
.child-subject-row.b1-subject-math,
.child-latest-diagnosis.b1-subject-math { border-left-color: var(--b1-subject-math-fg); }
.child-subject-row.b1-subject-english,
.child-latest-diagnosis.b1-subject-english { border-left-color: var(--b1-subject-english-fg); }

.child-subject-row .subject-row-name,
.child-latest-diagnosis .child-diagnosis-title,
.child-latest-diagnosis .child-diagnosis-action {
  color: inherit;
}

.b1-profile-report {
  background: var(--b1-surface);
  border-color: var(--b1-border);
}

.b1-profile-report .diagnosis-judgment {
  background: var(--b1-neutral-bg);
  color: var(--b1-ink);
}

.b1-profile-report .diagnosis-next { border-top-color: var(--b1-border); }

.hero-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
}

.hero-image {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #dbeafe;
}

.hero-copy {
  padding: 26rpx 26rpx 30rpx;
  background: #eef7ff;
}

.student-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mini-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #36b9aa;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-copy {
  min-width: 0;
}

.hero-action {
  margin-left: auto;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.student-name {
  display: block;
