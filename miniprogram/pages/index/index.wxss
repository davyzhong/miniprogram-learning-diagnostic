  text-align: center;
}

.domain-badge {
  font-size: 20rpx;
  margin-top: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #edf2f7;
  color: #a0aec0;
}

.domain-badge.active {
  background: #fed7d7;
  color: #c53030;
}

.domain-badge.mastered {
  background: #c6f6d5;
  color: var(--b1-improved-fg);
}

/* ========== 第三批：emoji 符号行 + 状态构成条 + 趋势 pill ========== */
.child-status-segments {
  margin-top: 14rpx;
}

.diagnosis-status-segments {
  margin-top: 12rpx;
}

.subject-row-segments {
  margin-top: 8rpx;
