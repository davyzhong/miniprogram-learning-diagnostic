/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.profile-home {
  display: flex;
  flex-direction: column;
}

.top-row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  color: #173f6b;
  margin-bottom: 14rpx;
}

.top-left {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}

.top-copy {
  flex: 1;
  min-width: 0;
}

.page-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.page-subtitle {
  display: block;
  color: #7a8ca4;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.45;
  margin-top: 8rpx;
}

.manage-actions {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-shrink: 0;
}

.manage-link {
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #e0f2fe;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.switch-student-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 22rpx;
  border-radius: 32rpx;
  background: #2563eb;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, .25);
}

.switch-student-btn:active {
  background: #1d4ed8;
  transform: scale(.97);
}

.switch-icon {
  font-size: 26rpx;
  line-height: 1;
}

.switch-text {
  font-size: 24rpx;
}

.child-workbench-section {
  margin-top: 10rpx;
}

.child-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
}

.child-card-pending {
  border-left: 8rpx solid #2563eb;
}

.child-card-clear {
  border-left: 8rpx solid #22c55e;
}

.child-card-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.child-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #173f6b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.child-main {
  flex: 1;
  min-width: 0;
}

.child-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.child-name {
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.25;
}

.child-status {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.child-status-pending {
  background: #ffe4e6;
  color: #be123c;
}

.child-status-clear {
  background: #dcfce7;
  color: #15803d;
}

.child-meta {
  display: block;
  color: #64748b;
  font-size: 21rpx;
  margin-top: 5rpx;
  line-height: 1.35;
}

.child-status-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.child-status-cell {
  min-height: 94rpx;
  border-radius: 16rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.status-cell-warning {
  background: #fff7ed;
  color: #c2410c;
}

.status-cell-primary {
  background: #eff6ff;
  color: #1d4ed8;
}

.status-cell-danger {
  background: #fef2f2;
  color: #b91c1c;
}

.status-cell-success {
  background: #ecfdf5;
  color: #15803d;
}

.child-status-num {
  display: block;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.1;
}

.child-status-label {
  display: block;
  font-size: 19rpx;
  font-weight: 700;
  margin-top: 7rpx;
}

.child-subject-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.child-subject-row {
  min-height: 76rpx;
  border-radius: 16rpx;
  padding: 14rpx 16rpx;
  background: #f8fbff;
  border: 1rpx solid #e0ecfa;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.child-subject-row.is-hidden {
  background: #f8fafc;
  border-color: #e2e8f0;
}

.subject-row-copy {
  min-width: 0;
}

.subject-row-name {
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 850;
  margin-right: 12rpx;
}

.subject-row-summary {
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
}

.subject-row-status {
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.child-priority-action {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border: 1rpx solid #bfdbfe;
  background: linear-gradient(135deg, #eff6ff 0%, #f8fbff 100%);
}

.priority-paper {
  border-color: #93c5fd;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
}

.priority-verification {
  border-color: #c4b5fd;
  background: linear-gradient(135deg, #f5f3ff 0%, #eef2ff 100%);
}

.priority-upload {
  border-color: #fed7aa;
  background: linear-gradient(135deg, #fff7ed 0%, #fffbeb 100%);
}

.priority-copy {
  flex: 1;
  min-width: 0;
}

.mini-section-label,
.child-panel-label {
  display: block;
  color: #2563eb;
  font-size: 19rpx;
  font-weight: 850;
  letter-spacing: .04em;
}

.priority-title {
  display: block;
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.3;
  margin-top: 6rpx;
}

.priority-summary {
  display: block;
  color: #475569;
  font-size: 21rpx;
  line-height: 1.45;
  margin-top: 6rpx;
}

.priority-action-text {
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.secondary-action-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.secondary-action-card {
  min-height: 112rpx;
  border-radius: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.secondary-action-title {
  display: block;
  color: #1f2937;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1.3;
}

.secondary-action-summary {
  display: block;
  color: #64748b;
  font-size: 19rpx;
  line-height: 1.35;
  margin-top: 8rpx;
}

.child-panel-label {
  color: #475569;
  margin-top: 18rpx;
}

.child-quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 14rpx;
}

.child-quick-link {
  min-height: 96rpx;
  border-radius: 16rpx;
  padding: 12rpx 10rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  box-sizing: border-box;
}

.quick-link-title {
  display: block;
  color: #1e3a8a;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
}

.quick-link-summary {
  display: block;
  color: #64748b;
  font-size: 17rpx;
  line-height: 1.25;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.family-workbench-hero {
  margin-top: 10rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 10rpx 28rpx rgba(31, 79, 130, .10);
}

.family-workbench-hero:active,
.personal-action-card:active,
.personal-subject-row:active {
  transform: scale(.99);
  opacity: .9;
}

.family-hero-copy {
  padding: 24rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #fff 100%);
}

.family-hero-kicker {
  display: block;
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: .04em;
}

.family-hero-title {
  display: block;
  margin-top: 8rpx;
  color: #173f6b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.family-hero-summary {
  display: block;
  margin-top: 10rpx;
  color: #52677d;
  font-size: 23rpx;
  line-height: 1.55;
}

.family-hero-footer {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.family-hero-stats {
  display: flex;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}

.family-hero-stat {
  min-width: 92rpx;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #dbeafe;
  box-sizing: border-box;
}

.family-hero-stat-value {
  display: block;
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
}

.family-hero-stat-label {
  display: block;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 750;
  margin-top: 4rpx;
}

.family-hero-action {
  color: #1d4ed8;
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.section-subtitle-inline {
  color: #7b8da3;
  font-size: 21rpx;
  font-weight: 700;
}

.personal-action-queue {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.personal-action-card {
  min-height: 164rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #dbeafe;
  box-shadow: 0 6rpx 18rpx rgba(31, 79, 130, .06);
  box-sizing: border-box;
}

.personal-action-title {
  display: block;
  color: #173f6b;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.personal-action-summary {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.38;
}

.personal-action-link {
  display: block;
  margin-top: 12rpx;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 900;
}

.personal-subject-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.personal-subject-row {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e0ecfa;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .04);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.personal-subject-copy {
  flex: 1;
  min-width: 0;
}

.personal-subject-name {
  display: block;
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 900;
}

.personal-subject-summary {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
}

.personal-subject-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

/* Compact functional layer on the restored visual baseline. */
.child-card { border-radius: 12rpx; margin-top: 12rpx; padding: 16rpx 18rpx; }
.child-card-top { gap: 12rpx; }
.child-avatar { border-radius: 10rpx; height: 62rpx; width: 62rpx; }
.child-meta { margin-top: 2rpx; }
.child-status-grid { display: grid; gap: 7rpx; grid-template-columns: repeat(4, 1fr); margin-top: 12rpx; }
.child-status-cell { border-radius: 8rpx; min-height: 72rpx; padding: 9rpx 10rpx; }
.child-status-num { font-size: 27rpx; }
.child-status-label { margin-top: 3rpx; }
.child-priority-action { margin-top: 11rpx; padding: 13rpx 15rpx; }
.secondary-action-grid { gap: 8rpx; margin-top: 10rpx; }
.secondary-action-card { min-height: 82rpx; padding: 11rpx 13rpx; }
.child-panel-label { margin-top: 12rpx; }
.child-subject-list { gap: 7rpx; margin-top: 8rpx; }
.child-subject-row { border-radius: 8rpx; min-height: 58rpx; padding: 9rpx 12rpx; }
.child-quick-grid { gap: 8rpx; margin-top: 8rpx; }
.child-quick-link { min-height: 76rpx; padding: 10rpx 12rpx; }

.profile-summary-line { align-items: baseline; display: flex; flex-wrap: wrap; gap: 6rpx 12rpx; margin-top: 4rpx; }
.profile-summary-name { color: #24364b; font-size: 24rpx; font-weight: 760; }
.profile-summary-meta { color: #718096; font-size: 20rpx; line-height: 1.35; }

.child-diagnosis-list { border-top: 1rpx solid #dce5ef; margin-top: 11rpx; padding-top: 9rpx; }
.child-diagnosis-head { align-items: center; display: flex; justify-content: space-between; margin-bottom: 4rpx; }
.child-diagnosis-count { color: #718096; font-size: 18rpx; }

.child-latest-diagnosis {
  align-items: center;
  background: #f5f9fd;
  border-left: 5rpx solid #3974b8;
  display: flex;
  gap: 14rpx;
  margin-top: 5rpx;
  padding: 9rpx 11rpx;
}
.child-diagnosis-copy { flex: 1; min-width: 0; }
.child-diagnosis-label { color: #64748b; display: block; font-size: 18rpx; }
.child-diagnosis-title-line { align-items: baseline; display: flex; gap: 10rpx; }
.child-diagnosis-title { color: #24364b; font-size: 23rpx; font-weight: 780; margin-right: 10rpx; }
.child-diagnosis-date { color: #8391a1; flex-shrink: 0; font-size: 18rpx; }
.child-diagnosis-summary { color: #64748b; display: block; font-size: 20rpx; line-height: 1.35; margin-top: 3rpx; }
.child-diagnosis-action { color: #2865a8; flex-shrink: 0; font-size: 21rpx; font-weight: 720; }

.diagnosis-workbench-section { margin-bottom: 16rpx; }
.diagnosis-section-head { align-items: baseline; display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.diagnosis-section-title { color: #24364b; font-size: 29rpx; font-weight: 800; }
.diagnosis-section-meta { color: #7b8a9a; font-size: 20rpx; }
.diagnosis-workbench { background: #fff; border: 1rpx solid #dce5ef; border-left: 6rpx solid #3974b8; margin-top: 8rpx; padding: 14rpx 16rpx; }
.diagnosis-workbench.diagnosis-chinese { border-left-color: #c85d42; }
.diagnosis-workbench.diagnosis-english { border-left-color: #268469; }
.diagnosis-head { align-items: center; display: flex; gap: 12rpx; }
.diagnosis-title-copy { flex: 1; min-width: 0; }
.diagnosis-title { color: #24364b; display: block; font-size: 25rpx; font-weight: 780; }
.diagnosis-date { color: #8391a1; display: block; font-size: 19rpx; margin-top: 2rpx; }
.diagnosis-report-link { color: #2865a8; flex-shrink: 0; font-size: 20rpx; font-weight: 700; }
.diagnosis-judgment { background: #f7f9fc; color: #465b70; display: block; font-size: 21rpx; line-height: 1.4; margin-top: 9rpx; padding: 8rpx 10rpx; }
.diagnosis-signal-line { color: #64748b; display: flex; flex-wrap: wrap; font-size: 19rpx; gap: 12rpx; margin-top: 8rpx; }
.diagnosis-next { align-items: center; border-top: 1rpx solid #edf2f7; display: flex; gap: 12rpx; margin-top: 9rpx; padding-top: 9rpx; }
.diagnosis-next-copy { flex: 1; min-width: 0; }
.diagnosis-next-title { color: #24364b; display: block; font-size: 22rpx; font-weight: 750; }
.diagnosis-next-summary { color: #64748b; display: block; font-size: 19rpx; line-height: 1.35; margin-top: 2rpx; }
.diagnosis-next-action { color: #2865a8; flex-shrink: 0; font-size: 20rpx; font-weight: 720; }
.diagnosis-load-state { background: #f8fafc; color: #64748b; font-size: 21rpx; margin-bottom: 14rpx; padding: 14rpx; }

.personal-subject-status {
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 19rpx;
  font-weight: 850;
}

.personal-subject-action {
  color: #2563eb;
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.hero-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
}

.hero-image {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #dbeafe;
}

.hero-copy {
  padding: 26rpx 26rpx 30rpx;
  background: #eef7ff;
}

.student-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mini-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #36b9aa;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-copy {
  min-width: 0;
}

.hero-action {
  margin-left: auto;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.student-name {
  display: block;
  color: #173f6b;
  font-size: 32rpx;
  font-weight: 800;
}

.student-meta {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.section-kicker {
  display: block;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.hero-title {
  display: block;
  color: #173f6b;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.hero-summary {
  display: block;
  color: #52677d;
  font-size: 24rpx;
  line-height: 1.65;
  margin-top: 14rpx;
}

.primary-report-card {
  margin-top: 20rpx;
  padding: 24rpx 22rpx;
  border-radius: 18rpx;
  background: #fff;
  border-left: 8rpx solid #f97316;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.report-mark {
  width: 70rpx;
  height: 70rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 850;
  background: #ffedd5;
  color: #c2410c;
  border: 2rpx solid #fed7aa;
}

.report-verification-report {
  background: #dcfce7;
  color: #15803d;
  border-color: #bbf7d0;
}

.primary-report-copy {
  flex: 1;
  min-width: 0;
}

.report-title-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  justify-content: space-between;
}

.report-title-copy {
  flex: 1;
  min-width: 0;
}

.primary-report-title {
  display: block;
  color: #1f2937;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 850;
}

.primary-report-time {
  display: block;
  margin-top: 6rpx;
  color: #8291a5;
  font-size: 21rpx;
  line-height: 1.25;
  font-weight: 700;
}

.report-action {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.primary-report-finding {
  display: block;
  margin-top: 12rpx;
  color: #173f6b;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 800;
}

.primary-report-summary {
  display: block;
  margin-top: 8rpx;
  color: #52677d;
  font-size: 23rpx;
  line-height: 1.5;
}

.report-info-grid {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.report-info-cell {
  min-width: 0;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.report-info-label,
.report-info-value {
  display: block;
}

.report-info-label {
  color: #8291a5;
  font-size: 20rpx;
  font-weight: 700;
}

.report-info-value {
  margin-top: 4rpx;
  color: #334155;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 800;
}

.report-chip-row {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.report-chip {
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
  color: #52677d;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
}

.report-chip-main {
  background: #fff7ed;
  color: #c2410c;
}

.coverage-card {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #9a3412;
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  font-size: 23rpx;
  line-height: 1.55;
}

.coverage-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: #ffedd5;
  color: #c2410c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.coverage-copy {
  flex: 1;
  min-width: 0;
}

.coverage-label {
  display: block;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 3rpx;
}

.coverage-text {
  display: block;
}

.metric-strip {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.metric-cell {
  min-height: 108rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.metric-value {
  font-size: 34rpx;
  font-weight: 850;
  color: #2563eb;
}

.metric-warning .metric-value { color: #c2410c; }
.metric-success .metric-value { color: #0f766e; }

.metric-label {
  color: #64748b;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.section-block {
  margin-top: 28rpx;
}

.section-heading {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0 4rpx 12rpx;
}

.section-subtitle {
  display: block;
  color: #7b8da3;
  font-size: 21rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.link-text {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.bottleneck-board {
  padding: 22rpx 20rpx;
  border-radius: 20rpx;
  background: #eef6ff;
  border: 1rpx solid #dbeafe;
}

.bottleneck-board .section-heading {
  margin-bottom: 14rpx;
}

.bottleneck-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.bottleneck-stat {
  min-height: 78rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e0ecfa;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 18rpx;
}

.stat-value {
  color: #173f6b;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.1;
}

.stat-label {
  color: #64748b;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.bottleneck-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.bottleneck-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border-left: 8rpx solid #3b82f6;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .05);
}

.bottleneck-recurring,
.bottleneck-persisting {
  border-left-color: #f97316;
}

.bottleneck-pending {
  border-left-color: #3b82f6;
}

.bottleneck-improved,
.bottleneck-declining {
  border-left-color: #22c55e;
}

.bottleneck-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bottleneck-copy {
  flex: 1;
  min-width: 0;
}

.bottleneck-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.bottleneck-name {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.3;
}

.bottleneck-subject {
  padding: 5rpx 9rpx;
  border-radius: 9rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 18rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.bottleneck-evidence,
.bottleneck-time {
  display: block;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.45;
  margin-top: 5rpx;
}

.bottleneck-time {
  color: #8a97a8;
  margin-top: 2rpx;
}

.bottleneck-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.bottleneck-chip {
  padding: 6rpx 10rpx;
  border-radius: 9rpx;
  background: #f1f5f9;
  color: #52677d;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
}

.priority-high {
  background: #ffedd5;
  color: #c2410c;
}

.priority-medium {
  background: #fef3c7;
  color: #92400e;
}

.priority-low {
  background: #ecfdf5;
  color: #15803d;
}

.bottleneck-action {
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #2563eb;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
  flex-shrink: 0;
}

.surface,
.next-card {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .05);
  padding: 0 22rpx;
}

.highlight-row,
.record-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 106rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.highlight-row:first-child,
.record-row:first-child {
  border-top: 0;
}

.subject-pill,
.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  flex-shrink: 0;
}

.subject-pill {
  background: #e0f2fe;
  color: #1d4ed8;
}

.record-icon {
  background: #dbeafe;
  color: #1d4ed8;
}

.record-verification-report {
  background: #dcfce7;
  color: #15803d;
}

.row-copy {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 800;
}

.row-desc {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 5rpx;
}

.row-meta {
  display: block;
  color: #8a97a8;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-tag {
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
}

.state-pending {
  background: #fef3c7;
  color: #92400e;
}

.state-improved {
  background: #dcfce7;
  color: #15803d;
}

.arrow {
  color: #94a3b8;
  font-size: 34rpx;
  flex-shrink: 0;
}

.empty-records {
  padding: 24rpx;
  color: #64748b;
  font-size: 23rpx;
}

.next-card {
  padding: 24rpx;
}

.next-title {
  display: block;
  color: #173f6b;
  font-size: 28rpx;
  font-weight: 800;
}

.next-desc {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.primary-action,
.secondary-action,
.empty-action {
  min-height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.primary-action,
.empty-action {
  background: #2563eb;
  color: #fff;
}

.secondary-action {
  border: 1rpx solid #bfdbfe;
  color: #2563eb;
  background: #fff;
}

.subject-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.subject-entry {
  min-height: 104rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.subject-name {
  font-size: 25rpx;
  color: #2563eb;
  font-weight: 800;
}

.subject-chinese .subject-name { color: #15803d; }
.subject-english .subject-name { color: #c2410c; }

.subject-status {
  color: #64748b;
  font-size: 20rpx;
  margin-top: 5rpx;
}

.empty-state,
.home-error-state {
  min-height: 82vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.loading-state {
  min-height: 82vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 25rpx;
}

.loading-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(26, 94, 173, .14);
}

.empty-logo {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 24rpx;
  border-radius: 34rpx;
  box-shadow: 0 12rpx 30rpx rgba(26, 94, 173, .16);
}

.empty-state .text,
.home-error-state .text {
  font-size: 31rpx;
  font-weight: 800;
  color: #1f2937;
}

.empty-state .sub-text,
.home-error-state .sub-text {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-action {
  width: 320rpx;
  margin-top: 30rpx;
}

.home-error-actions {
  width: 100%;
  max-width: 520rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 30rpx;
}

.home-error-actions .empty-action,
.home-error-actions .secondary-action {
  width: auto;
  margin-top: 0;
}

/* 知识地图卡片 */
.map-card {
  padding: 28rpx 24rpx;
}

/* === 知识地图紧凑条（单行，约 88rpx 高）=== */
.map-compact-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #2563eb;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, .08);
}

.map-compact-bar:active {
  transform: scale(.99);
  opacity: .9;
}

.map-compact-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.map-compact-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.map-compact-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
}

.map-compact-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a365d;
  line-height: 1.3;
}

.map-compact-summary {
  font-size: 22rpx;
  color: #4a5568;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-compact-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background: #2563eb;
  border-radius: 24rpx;
}

.map-compact-action-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.map-compact-action-arrow {
  font-size: 26rpx;
  color: #fff;
}

.section-more {
  float: right;
  font-size: 22rpx;
  color: #2b6cb0;
  font-weight: 400;
}

.map-summary {
  display: block;
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 20rpx;
}

.map-domains {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.map-domain {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: calc(25% - 12rpx);
  padding: 20rpx 8rpx;
  background: #f7fafc;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
}

.domain-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.domain-name {
  font-size: 22rpx;
  color: #4a5568;
  text-align: center;
}

.domain-badge {
  font-size: 20rpx;
  margin-top: 6rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #edf2f7;
  color: #a0aec0;
}

.domain-badge.active {
  background: #fed7d7;
  color: #c53030;
}

.domain-badge.mastered {
  background: #c6f6d5;
  color: #276749;
}
