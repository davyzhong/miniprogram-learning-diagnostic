/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: #f7fafc;
  padding-bottom: 160rpx;
}

/* ========== 顶部标题 ========== */
.header {
  background: linear-gradient(135deg, #1a365d 0%, #2b6cb0 100%);
  padding: 60rpx 36rpx 48rpx;
  color: #ffffff;
}

.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.header-sub {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
}

/* ========== 学生列表 ========== */
.student-list {
  padding: 24rpx 28rpx;
  margin-top: -20rpx;
}

.student-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 头像 */
.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

/* 信息 */
.info {
  flex: 1;
  margin-left: 24rpx;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a202c;
}

.grade-tag {
  font-size: 22rpx;
  color: #718096;
  background: #edf2f7;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.meta {
  font-size: 24rpx;
  color: #a0aec0;
}

.dot {
  margin: 0 8rpx;
}

/* 箭头 */
.arrow {
  font-size: 40rpx;
  color: #cbd5e0;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 40rpx;
}

.empty-state .icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-state .text {
  font-size: 30rpx;
  color: #718096;
  margin-bottom: 8rpx;
}

.empty-state .sub-text {
  font-size: 26rpx;
  color: #a0aec0;
}

/* ========== 底部按钮 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-add {
  background: linear-gradient(135deg, #2b6cb0 0%, #3182ce 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
  width: 100%;
  line-height: 1.4;
}

.btn-add::after { border: none; }
