  flex-shrink: 0;
}

.map-compact-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
  flex: 1;
}

.map-compact-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a365d;
  line-height: 1.3;
}

.map-compact-summary {
  font-size: 22rpx;
  color: #4a5568;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-compact-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
