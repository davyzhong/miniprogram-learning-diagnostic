/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding: 24rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.profile-home {
  display: flex;
  flex-direction: column;
}

.top-row {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #173f6b;
  margin-bottom: 14rpx;
}

.page-title {
  font-size: 34rpx;
  font-weight: 800;
}

.manage-link {
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: #e0f2fe;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
}

.hero-image {
  display: block;
  width: 100%;
  height: 280rpx;
  background: #dbeafe;
}

.hero-copy {
  padding: 26rpx 26rpx 30rpx;
  background: #eef7ff;
}

.student-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mini-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #36b9aa;
  color: #fff;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-copy {
  min-width: 0;
}

.student-name {
  display: block;
  color: #173f6b;
  font-size: 32rpx;
  font-weight: 800;
}

.student-meta {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.section-kicker {
  display: block;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.hero-title {
  display: block;
  color: #173f6b;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.hero-summary {
  display: block;
  color: #52677d;
  font-size: 24rpx;
  line-height: 1.65;
  margin-top: 14rpx;
}

.coverage-card {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 16rpx;
  background: #fff7ed;
  color: #9a3412;
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  font-size: 23rpx;
  line-height: 1.55;
}

.coverage-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: #ffedd5;
  color: #c2410c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.coverage-copy {
  flex: 1;
  min-width: 0;
}

.coverage-label {
  display: block;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 800;
  margin-bottom: 3rpx;
}

.coverage-text {
  display: block;
}

.metric-strip {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.metric-cell {
  min-height: 108rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.metric-value {
  font-size: 34rpx;
  font-weight: 850;
  color: #2563eb;
}

.metric-warning .metric-value { color: #c2410c; }
.metric-success .metric-value { color: #0f766e; }

.metric-label {
  color: #64748b;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.section-block {
  margin-top: 28rpx;
}

.section-heading {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 800;
  margin: 0 4rpx 12rpx;
}

.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.link-text {
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
}

.surface,
.next-card {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .05);
  padding: 0 22rpx;
}

.observation-row,
.record-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 106rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.observation-row:first-child,
.record-row:first-child {
  border-top: 0;
}

.subject-pill,
.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  flex-shrink: 0;
}

.subject-pill {
  background: #e0f2fe;
  color: #1d4ed8;
}

.record-icon {
  background: #dbeafe;
  color: #1d4ed8;
}

.record-verification-report {
  background: #dcfce7;
  color: #15803d;
}

.row-copy {
  flex: 1;
  min-width: 0;
}

.row-title {
  display: block;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 800;
}

.row-desc {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 5rpx;
}

.state-tag {
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
}

.state-pending {
  background: #fef3c7;
  color: #92400e;
}

.state-improved {
  background: #dcfce7;
  color: #15803d;
}

.arrow {
  color: #94a3b8;
  font-size: 34rpx;
  flex-shrink: 0;
}

.empty-records {
  padding: 24rpx;
  color: #64748b;
  font-size: 23rpx;
}

.next-card {
  padding: 24rpx;
}

.next-title {
  display: block;
  color: #173f6b;
  font-size: 28rpx;
  font-weight: 800;
}

.next-desc {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.primary-action,
.secondary-action,
.empty-action {
  min-height: 84rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
}

.primary-action,
.empty-action {
  background: #2563eb;
  color: #fff;
}

.secondary-action {
  border: 1rpx solid #bfdbfe;
  color: #2563eb;
  background: #fff;
}

.subject-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.subject-entry {
  min-height: 104rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .04);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.subject-name {
  font-size: 25rpx;
  color: #2563eb;
  font-weight: 800;
}

.subject-chinese .subject-name { color: #15803d; }
.subject-english .subject-name { color: #c2410c; }

.subject-status {
  color: #64748b;
  font-size: 20rpx;
  margin-top: 5rpx;
}

.empty-state {
  min-height: 82vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.loading-state {
  min-height: 82vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 25rpx;
}

.loading-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 22rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(26, 94, 173, .14);
}

.empty-logo {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 24rpx;
  border-radius: 34rpx;
  box-shadow: 0 12rpx 30rpx rgba(26, 94, 173, .16);
}

.empty-state .text {
  font-size: 31rpx;
  font-weight: 800;
  color: #1f2937;
}

.empty-state .sub-text {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-action {
  width: 320rpx;
  margin-top: 30rpx;
}
