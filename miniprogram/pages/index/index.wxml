<!--pages/index/index.wxml-->
<view class="page">
  <view class="loading-state" wx:if="{{loading}}">
    <image class="loading-logo" src="/assets/images/app-logo-share.jpg" mode="aspectFit" />
    <text>正在整理学习档案...</text>
  </view>

  <view class="profile-home" wx:elif="{{hasStudents}}">
    <view class="top-row">
      <view class="top-copy">
        <text class="page-title">{{homeMode === 'family-workbench' ? '家庭学习工作台' : '学习档案'}}</text>
        <text class="page-subtitle" wx:if="{{homeMode === 'family-workbench'}}">点击数字、状态、学科和编号可直接追溯</text>
      </view>
      <view class="manage-actions">
        <view class="manage-link" wx:if="{{homeMode === 'single-profile' && permissions.canManageParents}}" bindtap="onParentManagement">家长管理</view>
        <view class="manage-link" bindtap="onManageStudents">{{homeMode === 'family-workbench' ? '添加孩子' : '管理孩子'}}</view>
      </view>
    </view>

    <view class="section-block child-workbench-section" wx:if="{{homeMode === 'family-workbench' && childCards.length > 0}}">
      <view
        class="child-card child-card-{{child.statusClass}}"
        wx:for="{{childCards}}"
        wx:key="id"
        wx:for-item="child"
        bindtap="onStudentTap"
        data-id="{{child.id}}"
        data-name="{{child.name}}"
        data-grade="{{child.gradeText}}"
      >
        <view class="child-card-top">
          <view class="child-avatar">{{child.avatarText}}</view>
          <view class="child-main">
            <view class="child-title-line">
              <text class="child-name">{{child.name}}</text>
              <text class="child-status child-status-{{child.statusClass}}">{{child.statusText}}</text>
            </view>
            <text class="child-meta">{{child.gradeText}}<text wx:if="{{child.gradeText && child.roleText}}"> · </text>{{child.roleText}}<text wx:if="{{child.memberText}}"> · {{child.memberText}}</text></text>
            <text class="child-meta">最近更新：{{child.recentUpdateText}}</text>
          </view>
          <text class="arrow">›</text>
        </view>

        <view class="child-status-grid">
          <view
            class="child-status-cell status-cell-{{item.tone}}"
            wx:for="{{child.statusItems}}"
            wx:key="key"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <text class="child-status-num">{{item.value}}</text>
            <text class="child-status-label">{{item.label}}</text>
          </view>
        </view>

        <view class="child-subject-list">
          <view
            class="child-subject-row child-subject-{{item.key}} {{item.hidden ? 'is-hidden' : ''}}"
            wx:for="{{child.subjectRows}}"
            wx:key="key"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <view class="subject-row-copy">
              <text class="subject-row-name">{{item.name}}</text>
              <text class="subject-row-summary">{{item.summary}}</text>
            </view>
            <text class="subject-row-status">{{item.statusText}}</text>
          </view>
        </view>

        <view
          class="child-latest-row"
          wx:if="{{child.latestValue}}"
          catchtap="onTraceableUrlTap"
          data-url="{{child.latestValue.url}}"
        >
          <text class="latest-label">{{child.latestValue.kind === 'paper' ? '最近试卷' : '最新报告'}}</text>
          <view class="latest-copy">
            <text class="latest-title">{{child.latestValue.title}}</text>
            <text class="latest-summary">{{child.latestValue.summary}}</text>
          </view>
          <text class="latest-action">查看 ›</text>
        </view>

        <view
          class="child-next-row"
          catchtap="onTraceableUrlTap"
          data-url="{{child.nextAction.url}}"
        >
          <view>
            <text class="next-mini-title">{{child.nextAction.title}}</text>
            <text class="next-mini-summary">{{child.nextAction.summary}}</text>
          </view>
          <text class="next-mini-action">{{child.nextAction.actionText}} ›</text>
        </view>
      </view>
    </view>

    <block wx:if="{{homeMode === 'single-profile'}}">
    <view
      class="hero-card"
      bindtap="onStudentTap"
      data-id="{{home.studentId}}"
      data-name="{{home.studentName}}"
      data-grade="{{home.gradeText}}"
    >
      <image class="hero-image" src="/assets/images/math-diagnostic-guide.jpg" mode="aspectFill"></image>
      <view class="hero-copy">
        <view class="student-line">
          <view class="mini-avatar">{{home.avatarText}}</view>
          <view class="student-copy">
            <text class="student-name">{{home.studentName}}</text>
            <text class="student-meta">{{home.gradeText}}<text wx:if="{{home.gradeText}}"> · </text>最近更新：{{home.recentUpdateText}}</text>
          </view>
          <text class="hero-action">查看档案 ›</text>
        </view>
        <text class="section-kicker">当前综合摘要</text>
        <text class="hero-title">{{home.headline}}</text>
        <text class="hero-summary">{{home.summary}}</text>
      </view>
    </view>

    <view class="primary-report-card" wx:if="{{home.primaryReport}}" bindtap="onPrimaryReportTap">
      <view class="report-mark report-{{home.primaryReport.kind}}">{{home.primaryReport.icon}}</view>
      <view class="primary-report-copy">
        <view class="report-title-line">
          <view class="report-title-copy">
            <text class="primary-report-title">{{home.primaryReport.title}}</text>
            <text class="primary-report-time" wx:if="{{home.primaryReport.generatedAtText}}">生成于 {{home.primaryReport.generatedAtText}}</text>
          </view>
          <text class="report-action">{{home.primaryReport.actionText}}</text>
        </view>
        <text class="primary-report-finding" wx:if="{{home.primaryReport.findingText}}">{{home.primaryReport.findingText}}</text>
        <text class="primary-report-summary">{{home.primaryReport.summary}}</text>
        <view class="report-info-grid" wx:if="{{home.primaryReport.generatedAtText || home.primaryReport.evidenceTimeText}}">
          <view class="report-info-cell" wx:if="{{home.primaryReport.generatedAtText}}">
            <text class="report-info-label">报告生成</text>
            <text class="report-info-value">{{home.primaryReport.generatedAtText}}</text>
          </view>
          <view class="report-info-cell" wx:if="{{home.primaryReport.evidenceTimeText}}">
            <text class="report-info-label">证据时间</text>
            <text class="report-info-value">{{home.primaryReport.evidenceTimeText}}</text>
          </view>
        </view>
        <view class="report-chip-row">
          <text class="report-chip report-chip-main" wx:if="{{home.primaryReport.bottleneckText}}">{{home.primaryReport.bottleneckText}}</text>
          <text class="report-chip" wx:if="{{home.primaryReport.evidenceText}}">{{home.primaryReport.evidenceText}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="section-block bottleneck-board" wx:if="{{home.hasBottleneckBoard}}">
      <view class="section-heading between">
        <view>
          <text>当前学习卡点</text>
          <text class="section-subtitle">优先处理最近仍在影响作答的观察</text>
        </view>
        <text class="link-text" bindtap="onViewAllBottlenecks">查看全部</text>
      </view>
      <view class="bottleneck-stats">
        <view class="bottleneck-stat">
          <text class="stat-value">{{home.bottleneckStats.activeCount}}</text>
          <text class="stat-label">待跟进</text>
        </view>
        <view class="bottleneck-stat">
          <text class="stat-value">{{home.bottleneckStats.persistingCount}}</text>
          <text class="stat-label">持续出现</text>
        </view>
        <view class="bottleneck-stat">
          <text class="stat-value">{{home.bottleneckStats.improvedCount}}</text>
          <text class="stat-label">已改善</text>
        </view>
      </view>
      <view class="bottleneck-list">
        <view
          class="bottleneck-card bottleneck-{{item.statusClass}}"
          wx:for="{{home.priorityBottlenecks}}"
          wx:key="lpCode"
          bindtap="onBottleneckTap"
          data-subject="{{item.subject}}"
          data-lp-code="{{item.lpCode}}"
        >
          <view class="bottleneck-icon">{{item.statusIcon}}</view>
          <view class="bottleneck-copy">
            <view class="bottleneck-title-line">
              <text class="bottleneck-name">{{item.displayName}}</text>
              <text class="bottleneck-subject">{{item.subjectName}}</text>
            </view>
            <text class="bottleneck-evidence">{{item.evidenceText}}</text>
            <text class="bottleneck-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
            <view class="bottleneck-chip-row">
              <text class="bottleneck-chip priority-{{item.priorityClass}}">{{item.priorityText}}</text>
              <text class="bottleneck-chip state-{{item.statusClass}}">{{item.statusText}}</text>
            </view>
          </view>
          <view
            class="bottleneck-action"
            catchtap="onBottleneckAction"
            data-subject="{{item.subject}}"
            data-lp-code="{{item.lpCode}}"
          >{{item.actionText}}</view>
        </view>
      </view>
    </view>

    <view class="coverage-card">
      <view class="coverage-icon">i</view>
      <view class="coverage-copy">
        <text class="coverage-label">样本覆盖</text>
        <text class="coverage-text">{{home.sampleCoverageText}}</text>
      </view>
    </view>

    <view class="metric-strip">
      <view class="metric-cell metric-{{item.tone}}" wx:for="{{home.metrics}}" wx:key="label">
        <text class="metric-value">{{item.value}}</text>
        <text class="metric-label">{{item.label}}</text>
      </view>
    </view>

    <view class="section-block" wx:if="{{home.knowledgeMapCard.visible}}"
          bindtap="onKnowledgeMapTap">
      <view class="section-heading">🗺️ {{home.knowledgeMapCard.title}} <text class="section-more">查看详情 ›</text></view>
      <view class="surface map-card">
        <text class="map-summary">{{home.knowledgeMapCard.summary}}</text>
        <view class="map-domains">
          <view class="map-domain" wx:for="{{home.knowledgeMapCard.domains}}" wx:key="name">
            <text class="domain-icon">{{item.icon}}</text>
            <text class="domain-name">{{item.name}}</text>
            <text class="domain-badge {{item.status === 'active' ? 'active' : item.status === 'mastered' ? 'mastered' : ''}}">
              {{item.status === 'active' ? item.pendingCount + '待修' : item.status === 'mastered' ? '✓' : '—'}}
            </text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-block" wx:if="{{home.priorityHighlights.length > 0}}">
      <view class="section-heading">重点提示</view>
      <view class="surface">
        <view
          class="highlight-row"
          wx:for="{{home.priorityHighlights}}"
          wx:key="subject"
          bindtap="onHighlightTap"
          data-subject="{{item.subject}}"
        >
          <view class="subject-pill">{{item.subjectShortName}}</view>
          <view class="row-copy">
            <text class="row-title">{{item.title}}</text>
            <text class="row-desc">{{item.summary}}</text>
            <text class="row-meta" wx:if="{{item.metaText}}">{{item.metaText}}</text>
          </view>
          <text class="state-tag state-{{item.statusClass}}">{{item.statusText}}</text>
        </view>
      </view>
    </view>

    <view class="section-block">
      <view class="section-heading between">
        <text>学习记录</text>
        <text class="link-text" bindtap="onViewAllRecords">查看全部</text>
      </view>
      <view class="surface" wx:if="{{home.recentRecords.length > 0}}">
        <view
          class="record-row"
          wx:for="{{home.recentRecords}}"
          wx:key="title"
          bindtap="onRecordTap"
          data-index="{{index}}"
        >
          <view class="record-icon record-{{item.kind}}">{{item.icon}}</view>
          <view class="row-copy">
            <text class="row-title">{{item.title}}</text>
            <text class="row-desc">{{item.summary}}</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="surface empty-records" wx:else>
        <text>暂无学习记录，上传试卷后会自动整理。</text>
      </view>
    </view>

    <view class="section-block">
      <view class="section-heading">下一步建议</view>
      <view class="next-card">
        <text class="next-title">{{home.nextAction.title}}</text>
        <text class="next-desc">{{home.nextAction.summary}}</text>
        <view class="action-grid">
          <view class="primary-action" bindtap="onPrimaryAction">{{home.nextAction.primaryText}}</view>
          <view class="secondary-action" wx:if="{{home.nextAction.secondaryText}}" bindtap="onSecondaryAction">{{home.nextAction.secondaryText}}</view>
        </view>
      </view>
    </view>

    <view class="section-block">
      <view class="section-heading">学科入口</view>
      <view class="subject-grid">
        <view
          class="subject-entry subject-{{item.key}}"
          wx:for="{{home.subjects}}"
          wx:key="key"
          bindtap="onSubjectTap"
          data-subject="{{item.key}}"
        >
          <text class="subject-name">{{item.name}}</text>
          <text class="subject-status">{{item.statusText}}</text>
        </view>
      </view>
    </view>
    </block>
  </view>

  <view class="empty-state" wx:else>
    <image class="empty-logo" src="/assets/images/app-logo-share.jpg" mode="aspectFit" />
    <text class="text">还没有学习档案</text>
    <text class="sub-text">添加第一个孩子后，上传试卷建立学习记录。</text>
    <view class="empty-action" bindtap="onAddStudent">添加第一个孩子</view>
  </view>
</view>
