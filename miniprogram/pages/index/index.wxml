<!--pages/index/index.wxml-->
<view class="page b1-page">
  <view class="loading-state" wx:if="{{loading}}">
    <text>正在整理学习档案...</text>
  </view>

  <view class="home-error-state" wx:elif="{{errorText}}">
    <text class="text">首页暂时没有加载出来</text>
    <text class="sub-text">{{errorText}}</text>
    <view class="home-error-actions">
      <view class="empty-action" bindtap="onRetryLoadStudents">重新加载</view>
      <view class="secondary-action" bindtap="onAddStudent">添加孩子</view>
    </view>
  </view>

  <view class="profile-home" wx:elif="{{hasStudents}}">
    <view class="top-row">
      <view class="top-copy">
        <text class="page-title">{{homeMode === 'family-workbench' ? '家庭学习工作台' : '学习档案'}}</text>
        <text class="page-subtitle" wx:if="{{homeMode === 'family-workbench'}}">点击数字、状态、学科和编号可直接追溯</text>
        <view class="profile-summary-line" wx:if="{{homeMode === 'single-profile'}}">
          <text class="profile-summary-name">{{home.studentName}}</text>
          <text class="profile-summary-meta">{{home.gradeText}}<text wx:if="{{home.gradeText}}"> · </text>最近更新：{{home.recentUpdateText}}</text>
        </view>
      </view>
      <view class="manage-actions">
        <view class="manage-link" wx:if="{{homeMode === 'single-profile' && permissions.canManageParents}}" bindtap="onParentManagement">家长管理</view>
        <view class="manage-link" bindtap="onTraceableUrlTap" data-url="/pages/ai-usage/ai-usage">AI 用量</view>
        <view class="manage-link" bindtap="onManageStudents">{{homeMode === 'family-workbench' ? '添加孩子' : '管理孩子'}}</view>
      </view>
    </view>

    <view
      class="icon-compatibility-entry"
      wx:if="{{homeMode === 'family-workbench' && showIconCompatibilityEntry}}"
      catchtap="onTraceableUrlTap"
      data-url="/pages/icon-compatibility/icon-compatibility"
    >
      <view class="icon-compatibility-entry-copy">
        <text class="icon-compatibility-entry-title">图标兼容性测试</text>
        <text class="icon-compatibility-entry-meta">1202 项候选 · 2 批次 · Android 真机</text>
      </view>
      <text class="icon-compatibility-entry-action">开始测试 ›</text>
    </view>

    <view
      class="family-workbench-hero b1-family-summary"
      wx:if="{{homeMode === 'family-workbench' && familyHero}}"
      catchtap="onTraceableUrlTap"
      data-url="{{familyHero.url}}"
    >
      <view class="family-hero-copy">
        <view class="family-hero-kicker-row">
          <text class="b1-symbol family-hero-kicker-symbol" wx:if="{{familyHero.kickerSymbol}}">{{familyHero.kickerSymbol}}</text>
          <text class="family-hero-kicker">家庭今日总览</text>
        </view>
        <text class="family-hero-title">{{familyHero.title}}</text>
        <text class="family-hero-summary">{{familyHero.summary}}</text>
        <view class="family-hero-footer">
          <view class="family-hero-stats">
            <view class="family-hero-stat b1-family-stat" wx:for="{{familyHero.stats}}" wx:key="label">
              <text class="family-hero-stat-value">{{item.value}}</text>
              <text class="family-hero-stat-label">{{item.label}}</text>
            </view>
          </view>
          <text class="family-hero-action">{{familyHero.actionText}} ›</text>
        </view>
        <view class="family-hero-segments" wx:if="{{familyHero.statusSegments.length > 0}}">
          <view class="b1-seg-bar">
            <view class="b1-seg b1-seg-{{item.tone}}" wx:for="{{familyHero.statusSegments}}" wx:key="key" style="width: {{item.widthPercent}}%;"></view>
          </view>
          <view class="b1-seg-legend">
            <view class="b1-seg-legend-item" wx:for="{{familyHero.statusSegments}}" wx:key="key">
              <view class="b1-seg-dot b1-seg-{{item.tone}}"></view>
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section-block child-workbench-section" wx:if="{{homeMode === 'family-workbench' && childCards.length > 0}}">
      <view
        class="child-card child-card-{{child.statusClass}}"
        wx:for="{{childCards}}"
        wx:key="id"
        wx:for-item="child"
        bindtap="onStudentTap"
        data-id="{{child.id}}"
        data-name="{{child.name}}"
        data-grade="{{child.gradeText}}"
      >
        <view class="child-card-top child-identity-row">
          <view class="child-avatar">{{child.avatarText}}</view>
          <view class="child-main">
            <view class="child-title-line">
              <text class="child-name">{{child.name}}</text>
              <text class="child-status child-status-{{child.statusClass}}"><text class="child-status-dot" wx:if="{{child.statusClass === 'pending'}}"></text>{{child.statusText}}</text>
            </view>
            <text class="child-meta">{{child.gradeText}}<text wx:if="{{child.gradeText && child.roleText}}"> · </text>{{child.roleText}}<text wx:if="{{child.memberText}}"> · {{child.memberText}}</text></text>
            <text class="child-meta">最近更新：{{child.recentUpdateText}}</text>
            <text class="child-profile-link" catchtap="onTraceableUrlTap" data-url="{{child.profileUrl}}">查看档案 ›</text>
          </view>
          <text class="arrow">›</text>
        </view>

        <view class="child-status-grid">
          <view
            class="child-status-cell child-metric-cell b1-metric b1-metric-{{item.tone}}"
            wx:for="{{child.statusItems}}"
            wx:key="key"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <text class="child-status-num">{{item.value}}</text>
            <view class="child-status-label-row">
              <text class="b1-symbol child-status-symbol" wx:if="{{item.symbol}}">{{item.symbol}}</text>
              <text class="child-status-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <view class="child-status-segments" wx:if="{{child.statusSegments.length > 0}}">
          <view class="b1-seg-bar">
            <view class="b1-seg b1-seg-{{item.tone}}" wx:for="{{child.statusSegments}}" wx:key="key" style="width: {{item.widthPercent}}%;"></view>
          </view>
          <view class="b1-seg-legend">
            <view class="b1-seg-legend-item" wx:for="{{child.statusSegments}}" wx:key="key">
              <view class="b1-seg-dot b1-seg-{{item.tone}}"></view>
              <text>{{item.label}}</text>
            </view>
          </view>
        </view>

        <view
          class="child-priority-action child-priority-row b1-priority priority-{{child.priorityAction.tone}}"
          catchtap="onTraceableUrlTap"
          data-url="{{child.priorityAction.url}}"
        >
          <view class="priority-copy">
            <text class="mini-section-label">今日优先行动</text>
            <text class="priority-title">{{child.priorityAction.title}}</text>
            <text class="priority-summary">{{child.priorityAction.summary}}</text>
          </view>
          <text class="priority-action-text">{{child.priorityAction.actionText}} ›</text>
        </view>

        <view class="secondary-action-grid" wx:if="{{child.secondaryActions.length > 0}}">
          <view
            class="secondary-action-card child-secondary-action b1-subject-{{item.subject}}"
            wx:for="{{child.secondaryActions}}"
            wx:key="subject"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <text class="secondary-action-title">{{item.title}}</text>
            <text class="secondary-action-summary">{{item.summary}}</text>
          </view>
        </view>

        <view class="child-panel-label">三科学习状态</view>
        <view class="child-subject-list">
          <view
            class="child-subject-row b1-subject-{{item.key}} child-subject-{{item.key}} {{item.hidden ? 'is-hidden' : ''}}"
            wx:for="{{child.subjectRows}}"
            wx:key="key"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <view class="subject-row-copy">
              <view class="subject-name-line">
                <text class="subject-row-name">{{item.name}}</text>
                <text class="subject-row-action">{{item.actionText}}</text>
              </view>
              <text class="subject-row-summary">{{item.summary}}</text>
              <view class="subject-row-segments" wx:if="{{item.statusSegments.length > 0}}">
                <view class="b1-seg-bar">
                  <view class="b1-seg b1-seg-{{seg.tone}}" wx:for="{{item.statusSegments}}" wx:for-item="seg" wx:key="key" style="width: {{seg.widthPercent}}%;"></view>
                </view>
              </view>
            </view>
            <text class="subject-row-status">{{item.statusText}}</text>
          </view>
        </view>

        <view class="child-diagnosis-list" wx:if="{{child.diagnosisReports.length > 0}}">
          <view class="child-diagnosis-head">
            <text class="child-diagnosis-label">最新学科诊断</text>
            <text class="child-diagnosis-count">{{child.diagnosisCoverageText}}</text>
          </view>
          <view class="child-latest-diagnosis child-diagnosis-row b1-subject-{{item.subject}}" wx:for="{{child.diagnosisReports}}" wx:key="subject" catchtap="onTraceableUrlTap" data-url="{{item.url}}">
            <view class="child-diagnosis-copy">
              <view class="child-diagnosis-title-line">
                <text class="child-diagnosis-title">{{item.title}}</text>
                <text class="child-diagnosis-date" wx:if="{{item.dateText}}">{{item.dateText}}</text>
              </view>
              <text class="child-diagnosis-summary">{{item.summary}}</text>
            </view>
            <text class="child-diagnosis-action">查看 ›</text>
          </view>
        </view>

        <view class="child-panel-label">快捷入口</view>
        <view class="child-quick-grid">
          <view
            class="child-quick-link"
            wx:for="{{child.quickLinks}}"
            wx:key="key"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <view class="quick-link-title-row">
              <text class="b1-symbol quick-link-symbol" wx:if="{{item.symbol}}">{{item.symbol}}</text>
              <text class="quick-link-title">{{item.title}}</text>
            </view>
            <text class="quick-link-summary">{{item.summary}}</text>
          </view>
        </view>
      </view>
    </view>

    <block wx:if="{{homeMode === 'single-profile'}}">
      <view class="diagnosis-workbench-section" wx:if="{{home.diagnosisWorkbenches.length > 0}}">
        <view class="diagnosis-section-head">
          <text class="diagnosis-section-title">最新学科诊断</text>
          <text class="diagnosis-section-meta">{{home.diagnosisWorkbenches.length}} 份正式报告</text>
        </view>
        <view class="diagnosis-workbench b1-profile-report b1-subject-{{item.subject}} diagnosis-{{item.subject}}" wx:for="{{home.diagnosisWorkbenches}}" wx:key="key">
          <view class="diagnosis-head">
            <view class="diagnosis-title-copy">
              <text class="diagnosis-title">{{item.title}}</text>
              <text class="diagnosis-date">{{item.generatedAtText}} · 正式诊断</text>
            </view>
            <view class="trend-pill trend-pill-{{item.trendClass}}" wx:if="{{item.trendText}}">
              <text class="b1-symbol trend-pill-symbol" wx:if="{{item.trendSymbol}}">{{item.trendSymbol}}</text>
              <text>{{item.trendText}}</text>
            </view>
            <text class="diagnosis-report-link" catchtap="onTraceableUrlTap" data-url="{{item.reportUrl}}">完整报告 ›</text>
          </view>
          <text class="diagnosis-judgment">{{item.judgment}}</text>
          <view class="diagnosis-signal-line">
            <text>{{item.evidenceCount}} 条证据</text>
            <text>{{item.improvedCount}} 项改善</text>
            <text wx:if="{{item.persistingCount > 0}}">{{item.persistingCount}} 项持续</text>
            <text wx:if="{{item.waitingCount > 0}}">{{item.waitingCount}} 项待验证</text>
          </view>
          <view class="diagnosis-status-segments" wx:if="{{item.diagnosisSegments.length > 0}}">
            <view class="b1-seg-bar">
              <view class="b1-seg b1-seg-{{seg.tone}}" wx:for="{{item.diagnosisSegments}}" wx:for-item="seg" wx:key="key" style="width: {{seg.widthPercent}}%;"></view>
            </view>
          </view>
          <view class="diagnosis-status-segments" wx:if="{{item.statusSegments.length > 0}}">
            <view class="b1-seg-bar">
              <view class="b1-seg b1-seg-{{seg.tone}}" wx:for="{{item.statusSegments}}" wx:for-item="seg" wx:key="key" style="width: {{seg.widthPercent}}%;"></view>
            </view>
            <view class="b1-seg-legend">
              <view class="b1-seg-legend-item" wx:for="{{item.statusSegments}}" wx:for-item="seg" wx:key="key">
                <view class="b1-seg-dot b1-seg-{{seg.tone}}"></view>
                <text>{{seg.label}}</text>
              </view>
            </view>
          </view>
          <view class="diagnosis-next" catchtap="onTraceableUrlTap" data-url="{{item.primaryAction.url}}">
            <view class="diagnosis-next-copy">
              <text class="diagnosis-next-title">下一步：{{item.primaryAction.text}}</text>
              <text class="diagnosis-next-summary">{{item.primaryAction.summary}}</text>
            </view>
            <text class="diagnosis-next-action">去完成 ›</text>
          </view>
        </view>
      </view>

      <view class="diagnosis-load-state" wx:elif="{{home.diagnosisDataUnavailable}}">
        <text>学科诊断暂时没有加载出来，请稍后重试。</text>
      </view>

      <view class="section-block personal-action-section">
        <view class="section-heading between">
          <text>接下来可以做什么</text>
          <text class="section-subtitle-inline">每块都可点击</text>
        </view>
        <view class="personal-action-queue">
          <view
            class="personal-action-card personal-action-{{item.key}}"
            wx:for="{{home.personalActionQueue}}"
            wx:key="key"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <view class="personal-action-title-row">
              <text class="b1-symbol personal-action-symbol" wx:if="{{item.symbol}}">{{item.symbol}}</text>
              <text class="personal-action-title">{{item.title}}</text>
            </view>
            <text class="personal-action-summary">{{item.summary}}</text>
            <text class="personal-action-link">{{item.actionText}} ›</text>
          </view>
        </view>
      </view>

      <view class="section-block personal-subject-section">
        <view class="section-heading">三科学习入口</view>
        <view class="personal-subject-list">
          <view
            class="personal-subject-row personal-subject-{{item.key}}"
            wx:for="{{home.subjects}}"
            wx:key="key"
            catchtap="onTraceableUrlTap"
            data-url="{{item.url}}"
          >
            <view class="personal-subject-copy">
              <view class="personal-subject-name-line">
                <text class="b1-symbol personal-subject-symbol" wx:if="{{item.symbol}}">{{item.symbol}}</text>
                <text class="personal-subject-name">{{item.name}}</text>
                <text class="confidence-tag confidence-{{item.confidenceLevel}}" wx:if="{{item.confidenceText}}">{{item.confidenceText}}</text>
              </view>
              <text class="personal-subject-summary">{{item.summary}}</text>
              <view class="personal-subject-segments" wx:if="{{item.statusSegments.length > 0}}">
                <view class="b1-seg-bar">
                  <view class="b1-seg b1-seg-{{seg.tone}}" wx:for="{{item.statusSegments}}" wx:for-item="seg" wx:key="key" style="width: {{seg.widthPercent}}%;"></view>
                </view>
              </view>
            </view>
            <view class="personal-subject-right">
              <text class="personal-subject-status">{{item.statusText}}</text>
              <text class="personal-subject-action">{{item.actionText}} ›</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-state" wx:else>
    <text class="text">还没有学习档案</text>
    <text class="sub-text">添加第一个孩子后，上传试卷建立学习记录。</text>
    <view class="empty-action" bindtap="onAddStudent">添加第一个孩子</view>
  </view>
</view>
