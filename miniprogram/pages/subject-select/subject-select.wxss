/* pages/subject-select/subject-select.wxss */

.page {
  min-height: 100vh;
  background: #f7fafc;
  padding: 24rpx 28rpx;
  padding-top: 16rpx;
}

/* ========== 顶部提示 ========== */
.tip-bar {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tip-text {
  display: block;
  font-size: 28rpx;
  color: #4a5568;
  font-weight: 700;
}

.tip-sub {
  display: block;
  font-size: 23rpx;
  color: #8a9aad;
  line-height: 1.45;
  margin-top: 8rpx;
}

/* ========== 学科卡片 ========== */
.subject-list {
  display: flex;
  flex-direction: column;
}

.subject-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s;
}

.subject-card:active {
  transform: scale(0.98);
}

/* 学科左边框颜色 */
.subject-card-math    { border-left: 8rpx solid #2b6cb0; }
.subject-card-chinese { border-left: 8rpx solid #276749; }
.subject-card-english { border-left: 8rpx solid #c05621; }

/* 图标 */
.subject-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.subject-card-math    .subject-icon-wrap { background: #ebf8ff; }
.subject-card-chinese .subject-icon-wrap { background: #f0fff4; }
.subject-card-english .subject-icon-wrap { background: #fffaf0; }

.subject-icon {
  font-size: 44rpx;
}

/* 文字信息 */
.subject-info {
  flex: 1;
  margin-left: 24rpx;
}

.subject-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 6rpx;
}

.subject-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #a0aec0;
}

.meta-dot {
  margin: 0 8rpx;
}

.meta-item.pending {
  color: #dd6b20;
  font-weight: 600;
}

/* 箭头 */
.arrow {
  font-size: 44rpx;
  color: #cbd5e0;
  flex-shrink: 0;
  margin-left: 12rpx;
}
