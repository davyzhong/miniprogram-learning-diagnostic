<!--pages/generate-verification/generate-verification.wxml-->
<view class="page">
  <view class="config-hero">
    <text class="config-kicker">出卷配置</text>
    <text class="config-title">{{subjectName}}纸面验证卷</text>
    <text class="config-desc">选择本次要验证的学习卡点，生成 A4 PDF 后打印作答，完成后拍照上传批复。</text>
  </view>

  <view class="config-card" wx:if="{{selectedCount > 0}}">
    <view class="section-title">试卷配置</view>
    <text class="scope-text">{{paperConfig.scopeText}}</text>
    <text class="strategy-text">{{paperConfig.strategyText}}</text>
    <view class="task-pack" wx:if="{{paperConfig.taskPages.length > 0}}">
      <view class="task-pack-head">
        <text class="task-pack-title">任务包预览</text>
        <text class="task-pack-meta">{{paperConfig.taskPageCount}} 个任务页，可批量打印，做完任意页后按页面编号拍照回传。</text>
      </view>
      <view class="task-page" wx:for="{{paperConfig.taskPages}}" wx:key="pageIndex">
        <view class="task-page-title">
          <text>{{item.title}}</text>
          <text class="task-page-count">{{item.targetCount}} 个{{paperConfig.targetUnitLabel || '目标'}} · {{item.questionCount}} 题</text>
        </view>
        <text class="task-page-scope">{{item.scopeText}}</text>
      </view>
    </view>
    <view class="preview-stats">
      <view class="preview-stat">
        <text class="preview-num">{{selectedCount}}</text>
        <text class="preview-label">{{paperConfig.targetUnitLabel || '卡点数'}}</text>
      </view>
      <view class="preview-stat">
        <text class="preview-num">{{paperConfig.questionCount}}</text>
        <text class="preview-label">题目数</text>
      </view>
      <view class="preview-stat">
        <text class="preview-num">{{paperConfig.estimatedMinutes}}</text>
        <text class="preview-label">分钟</text>
      </view>
      <view class="preview-stat">
        <text class="preview-num">{{paperConfig.paperSize}}</text>
        <text class="preview-label">{{paperConfig.pages}} 页</text>
      </view>
    </view>
  </view>

  <view class="section-title range-title">出题范围（已选 {{selectedCount}} 个卡点）</view>
  <view class="bottleneck-list">
    <view
      class="bottleneck-item {{item.selected ? 'selected' : ''}}"
      wx:for="{{bottlenecks}}"
      wx:key="viewId"
      bindtap="onToggleBottleneck"
      data-index="{{index}}"
    >
      <view class="checkbox {{item.selected ? 'checked' : ''}}">
        <text wx:if="{{item.selected}}">✓</text>
      </view>
      <view class="bottleneck-info">
        <view class="bottleneck-header">
          <text class="lp-name">{{item.displayName}}</text>
          <view class="confidence-badge confidence-{{item.confidenceClass}}">
            <text>{{item.confidenceLabel}}·{{item.expectedQuestions}}题</text>
          </view>
        </view>
        <text class="bottleneck-date">{{item.rangeText}}</text>
      </view>
    </view>

    <view class="empty-tip" wx:if="{{bottlenecks.length === 0 && !loading}}">
      <text class="empty-icon">✓</text>
      <text class="empty-text">暂无待验证卡点</text>
      <text class="empty-hint">请先通过拍照诊断发现卡点</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-secondary" bindtap="onPreview" disabled="{{selectedCount === 0 || previewing}}">
      {{previewing ? '预览生成中...' : '预览 PDF'}}
    </button>
    <button
      class="btn-primary"
      bindtap="onGenerate"
      disabled="{{selectedCount === 0 || generating}}"
    >
      {{generating ? '生成中...' : '生成 A4 试卷'}}
    </button>
  </view>
</view>
