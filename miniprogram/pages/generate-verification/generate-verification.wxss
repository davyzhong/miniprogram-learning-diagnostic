.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding-bottom: 200rpx;
}

.config-hero {
  padding: 22rpx 28rpx;
  background: var(--b1-subject-math-fg);
  color: #fff;
  border-radius: 0 0 22rpx 22rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  align-items: stretch;
}

.config-hero-copy {
  flex: 1;
  min-width: 0;
}

.config-hero-image {
  width: 100%;
  height: 390rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, .12);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, .14);
  order: -1;
}

.config-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 750;
  opacity: .84;
  margin-bottom: 8rpx;
}

.config-title {
  display: block;
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.3;
}

.config-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, .84);
  font-size: 24rpx;
  line-height: 1.55;
}

.config-card {
  margin: 20rpx 28rpx 22rpx;
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 79, 130, .08);
}

.section-title {
  color: #25364a;
  font-size: 29rpx;
  font-weight: 800;
}

.range-title {
  margin: 0 32rpx 14rpx;
}

.scope-text {
  display: block;
  margin-top: 10rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #eef7ff;
  color: #244b71;
  font-size: 24rpx;
  line-height: 1.45;
}

.strategy-text {
  display: block;
  margin-top: 10rpx;
  color: #53657a;
  font-size: 23rpx;
  line-height: 1.4;
}

.task-pack {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f7fbff;
  border: 2rpx solid #d9ebfb;
}

.task-pack-head {
  margin-bottom: 10rpx;
}

.task-pack-title {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
  color: var(--b1-subject-math-fg);
  margin-bottom: 4rpx;
}

.task-pack-meta {
  display: block;
  color: #607089;
  font-size: 21rpx;
  line-height: 1.45;
}

.task-page {
  padding: 14rpx 0;
  border-top: 1rpx solid #dbe8f5;
}

.task-page-title {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  color: #25364a;
  font-size: 23rpx;
  font-weight: 750;
}

.task-page-count {
  flex-shrink: 0;
  color: #2f78b7;
  font-size: 21rpx;
  font-weight: 700;
}

.task-page-scope {
  display: block;
  margin-top: 6rpx;
  color: #6b7b90;
  font-size: 21rpx;
  line-height: 1.45;
}

.preview-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.preview-stat {
  min-height: 92rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.preview-num {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
  color: #1a365d;
  line-height: 1.2;
}

.preview-label {
  display: block;
  font-size: 20rpx;
  color: #8795a5;
  margin-top: 4rpx;
}

.bottleneck-list {
  padding: 0 28rpx;
  margin-bottom: 20rpx;
}

.bottleneck-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, .04);
  border: 2rpx solid transparent;
  transition: all .15s;
}

.bottleneck-item.selected {
  border-color: #2f80c9;
  background: #f1f8ff;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #cbd5e0;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 24rpx;
  color: #ffffff;
  transition: all .15s;
}

.checkbox.checked {
  background: #2f80c9;
  border-color: #2f80c9;
}

.bottleneck-info {
  flex: 1;
  min-width: 0;
}

.bottleneck-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.lp-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a202c;
  flex: 1;
  min-width: 0;
}

.severity-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 7rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.severity-high { background: #fee2e2; color: #9b2c2c; }
.severity-medium { background: #fef3c7; color: #975a16; }
.severity-low { background: #dcfce7; color: var(--b1-improved-fg); }

.confidence-badge {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 7rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.confidence-high { background: #ede9fe; color: #5b21b6; }
.confidence-medium { background: #fef3c7; color: #975a16; }
.confidence-low { background: #e0f2fe; color: #075985; }

.bottleneck-date {
  display: block;
  font-size: 22rpx;
  color: #8a9aab;
}

.bottleneck-hierarchy {
  color: #52677d;
  display: block;
  font-size: 21rpx;
  line-height: 1.4;
  margin-top: 6rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 18rpx;
}

.empty-icon {
  display: block;
  font-size: 64rpx;
  color: #166534;
  margin-bottom: 16rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #25364a;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #8a9aab;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, .05);
  z-index: 100;
}

.bottom-bar .btn-primary {
  width: 100%;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 14rpx;
  background: #2768b4;
  color: #ffffff;
  border: none;
}

.bottom-bar .btn-primary[disabled] {
  background: #a0aec0;
}

.bottleneck-item:active,
.bottom-bar .btn-primary:active {
  transform: scale(.985);
}

/* B1 paper identity and semantic state layer. */
.config-hero.b1-paper-header {
  background: var(--b1-surface);
  border: 1rpx solid var(--b1-border);
  border-left: 8rpx solid var(--b1-subject-math-fg);
  border-radius: 10rpx;
  box-shadow: none;
  margin: 20rpx 28rpx 16rpx;
  padding: 20rpx;
}

.config-hero.b1-subject-chinese { border-left-color: var(--b1-subject-chinese-fg); }
.config-hero.b1-subject-english { border-left-color: var(--b1-subject-english-fg); }

.paper-header-band {
  align-items: center;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.paper-state {
  background: var(--b1-waiting-bg);
  border-radius: 7rpx;
  color: var(--b1-waiting-fg);
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  padding: 5rpx 10rpx;
}

.config-card,
.bottleneck-item {
  border: 1rpx solid var(--b1-border);
  border-radius: 10rpx;
  box-shadow: none;
}

.bottleneck-item.selected {
  background: var(--b1-subject-math-bg);
  border-color: var(--b1-subject-math-fg);
}

.bottom-bar .btn-primary {
  background: var(--b1-ink-strong);
  border-radius: 9rpx;
}

/* 第四批：emoji 符号 */
.tip-title-row { display: flex; align-items: center; gap: 8rpx; }
.tip-symbol, .title-symbol, .kicker-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
