.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding: 28rpx 28rpx 156rpx;
  box-sizing: border-box;
}

.knowledge-position { padding: 24rpx; margin-bottom: 16rpx; background: #fff; border-radius: 16rpx; }
.position-domain { display: flex; align-items: center; margin: 12rpx 0; }
.position-icon { font-size: 36rpx; margin-right: 12rpx; }
.position-text { font-size: 26rpx; color: #2d3748; }
.position-chain { margin: 8rpx 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8rpx; }
.chain-label { font-size: 22rpx; color: #a0aec0; }
.chain-node { font-size: 22rpx; color: #4a5568; background: #edf2f7; padding: 4rpx 12rpx; border-radius: 6rpx; }

.loading-state,
.empty-state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
}

.hero-card {
  border-radius: 22rpx;
  background: #fff;
  border-left: 10rpx solid #3b82f6;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
  padding: 28rpx 26rpx;
}

.bottleneck-recurring,
.bottleneck-persisting {
  border-left-color: #f97316;
}

.bottleneck-improved,
.bottleneck-declining {
  border-left-color: #22c55e;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 18rpx;
}

.status-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-illustration {
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 79, 130, .08);
  flex-shrink: 0;
  height: 390rpx;
  width: 100%;
  background: #eef7ff;
  order: -1;
}

.kicker {
  display: block;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 850;
}

.title {
  display: block;
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.3;
  margin-top: 5rpx;
}

.summary {
  display: block;
  color: #52677d;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 10rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.chip {
  padding: 8rpx 12rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
  color: #52677d;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.2;
}

.priority-high {
  background: #ffedd5;
  color: #c2410c;
}

.priority-medium {
  background: #fef3c7;
  color: #92400e;
}

.priority-low {
  background: #ecfdf5;
  color: #15803d;
}

.state-recurring,
.state-persisting {
  background: #fff7ed;
  color: #c2410c;
}

.state-pending {
  background: #eff6ff;
  color: #1d4ed8;
}

.state-improved,
.state-declining {
  background: #dcfce7;
  color: #15803d;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.metric {
  min-height: 92rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 14rpx;
}

.metric:active,
.evidence-row:active,
.evidence-card:active,
.expand-row:active,
.compact-row:active,
.primary-action:active,
.secondary-action:active {
  opacity: 0.74;
}

.metric-value {
  color: #173f6b;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.1;
}

.metric-label {
  color: #64748b;
  font-size: 19rpx;
  margin-top: 5rpx;
}

.time-card {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #eef6ff;
  border: 1rpx solid #dbeafe;
}

.time-title {
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 850;
  margin-right: 14rpx;
}

.time-text {
  color: #52677d;
  font-size: 22rpx;
  font-weight: 700;
}

.section {
  margin-top: 28rpx;
}

.section-heading {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 850;
  margin: 0 4rpx 12rpx;
}

.section-title-line {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.section-title-line .section-heading {
  margin-bottom: 4rpx;
}

.section-subtitle {
  display: block;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
}

.section-count {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 850;
}

.surface,
.compact-list {
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .05);
  padding: 0 22rpx;
}

.evidence-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.evidence-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #dbe7f3;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .05);
  padding: 20rpx 18rpx;
  border-left: 8rpx solid #3b82f6;
}

.evidence-diagnosis-report {
  border-left-color: #f97316;
}

.evidence-verification-report {
  border-left-color: #22c55e;
}

.evidence-verification-paper {
  border-left-color: #2563eb;
}

.evidence-row,
.compact-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 106rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf2f7;
}

.evidence-row:first-child,
.compact-row:first-child {
  border-top: 0;
}

.row-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.evidence-icon {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-report {
  background: #ffedd5;
  color: #c2410c;
}

.evidence-copy {
  flex: 1;
  min-width: 0;
}

.evidence-head,
.evidence-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.evidence-category {
  color: #64748b;
  font-size: 20rpx;
  font-weight: 850;
}

.evidence-status {
  flex-shrink: 0;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #2563eb;
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1.2;
}

.status-diagnosis {
  background: #fff7ed;
  color: #c2410c;
}

.status-feedback,
.status-done {
  background: #dcfce7;
  color: #15803d;
}

.status-pending {
  background: #eff6ff;
  color: #1d4ed8;
}

.evidence-title {
  color: #172033;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.35;
  min-width: 0;
  word-break: break-all;
}

.evidence-desc {
  display: block;
  color: #52677d;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 8rpx;
}

.evidence-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.evidence-chip {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #52677d;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
}

.expand-row {
  height: 72rpx;
  border-radius: 16rpx;
  background: #eef6ff;
  border: 1rpx solid #bfdbfe;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.learning-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #fff7e8;
  border: 2rpx solid #fed7aa;
  box-shadow: 0 4rpx 16rpx rgba(120, 72, 24, .06);
}

.learning-entry:active {
  opacity: 0.74;
}

.learning-copy {
  flex: 1;
  min-width: 0;
}

.learning-title {
  display: block;
  color: #172033;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.35;
}

.learning-desc {
  display: block;
  margin-top: 8rpx;
  color: #7b4b19;
  font-size: 25rpx;
  line-height: 1.5;
}

.row-copy {
  flex: 1;
  min-width: 0;
}

.row-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.row-title,
.compact-title {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 850;
}

.row-time {
  color: #94a3b8;
  font-size: 20rpx;
  white-space: nowrap;
}

.row-desc,
.compact-desc {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 5rpx;
}

.compact-row {
  align-items: flex-start;
}

.compact-row .compact-title,
.compact-row .compact-desc {
  flex: 1;
  min-width: 0;
}

.arrow {
  color: #94a3b8;
  font-size: 34rpx;
  flex-shrink: 0;
}

.empty {
  padding: 26rpx 22rpx;
  color: #64748b;
  font-size: 23rpx;
}

.action-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 28rpx 34rpx;
  background: rgba(244, 247, 250, .96);
  box-shadow: 0 -8rpx 24rpx rgba(31, 79, 130, .08);
}

.primary-action,
.secondary-action {
  height: 86rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.primary-action {
  background: #2563eb;
  color: #fff;
}

.secondary-action {
  background: #fff;
  color: #2563eb;
  border: 2rpx solid #bfdbfe;
}

.primary-action.small {
  margin-top: 24rpx;
  width: 320rpx;
}

.empty-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 850;
}

/* 置信度仪表盘 */
.confidence-card {
  margin: 16rpx 0;
  padding: 24rpx;
  background: #f7fafc;
  border-radius: 16rpx;
  border-left: 6rpx solid #3182ce;
}
.confidence-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.confidence-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a365d;
}
.confidence-level {
  font-size: 26rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.confidence-level.high { color: #c53030; background: #fed7d7; }
.confidence-level.medium { color: #b7791f; background: #fefcbf; }
.confidence-level.low { color: #718096; background: #e2e8f0; }
.confidence-detail {
  display: block;
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.5;
}
.confidence-trend {
  display: block;
  font-size: 22rpx;
  color: #718096;
  margin-top: 6rpx;
}

/* 报告页置信度标签 */
.confidence-tag {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}
.confidence-tag.high { color: #c53030; background: #fed7d7; }
.confidence-tag.medium { color: #b7791f; background: #fefcbf; }
.confidence-tag.low { color: #718096; background: #e2e8f0; }
.hero-card.b1-subject-math { border-left: 10rpx solid var(--b1-math, #b7791f); }
.hero-card.b1-subject-chinese { border-left: 10rpx solid var(--b1-chinese, #b84040); }
.hero-card.b1-subject-english { border-left: 10rpx solid var(--b1-english, #2f855a); }
.section { border-radius: 0; box-shadow: none; border-top: 2rpx solid #ded8cc; }
