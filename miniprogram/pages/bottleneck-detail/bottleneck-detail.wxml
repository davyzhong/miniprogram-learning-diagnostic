<view class="page">
  <view class="loading-state" wx:if="{{loading}}">
    <text>正在整理卡点证据...</text>
  </view>

  <view wx:elif="{{bottleneck}}">
    <view class="hero-card bottleneck-{{bottleneck.statusClass}}">
      <view class="hero-top">
        <view class="status-icon">{{bottleneck.statusIcon}}</view>
        <view class="hero-copy">
          <text class="kicker">{{subjectName}}学习卡点</text>
          <text class="title">{{bottleneck.displayName}}</text>
          <text class="summary" wx:if="{{bottleneck.parentDescription}}">{{bottleneck.parentDescription}}</text>
          <text class="summary">{{bottleneck.evidenceText}}</text>
        </view>
      </view>
      <view class="chip-row">
        <text class="chip priority-{{bottleneck.priorityClass}}">{{bottleneck.priorityText}}</text>
        <text class="chip" wx:if="{{bottleneck.category}}">{{bottleneck.category}}</text>
        <text class="chip state-{{bottleneck.statusClass}}">{{bottleneck.statusText}}</text>
        <text class="chip" wx:if="{{bottleneck.weightText}}">{{bottleneck.weightText}}</text>
      </view>
    </view>

    <view class="metrics">
      <view class="metric" bindtap="onMetricTap" data-target="reports">
        <text class="metric-value">{{bottleneck.evidenceCount}}</text>
        <text class="metric-label">证据</text>
      </view>
      <view class="metric" bindtap="onMetricTap" data-target="reports">
        <text class="metric-value">{{bottleneck.recentErrorCount}}</text>
        <text class="metric-label">相关错题</text>
      </view>
      <view class="metric" bindtap="onMetricTap" data-target="papers">
        <text class="metric-value">{{bottleneck.verificationPassCount}}</text>
        <text class="metric-label">通过</text>
      </view>
      <view class="metric" bindtap="onMetricTap" data-target="papers">
        <text class="metric-value">{{bottleneck.verificationFailCount}}</text>
        <text class="metric-label">未通过</text>
      </view>
    </view>

    <view class="time-card" wx:if="{{bottleneck.timeText}}">
      <text class="time-title">时间线索</text>
      <text class="time-text">{{bottleneck.timeText}}</text>
    </view>

    <view class="section">
      <view class="section-title-line">
        <view>
          <view class="section-heading">卡点证据链</view>
          <text class="section-subtitle">按时间串起诊断、验证卷和反馈，避免重复列表混在一起。</text>
        </view>
        <text class="section-count" wx:if="{{evidenceChain.length > 0}}">{{evidenceChain.length}} 条</text>
      </view>
      <view class="evidence-list" wx:if="{{visibleEvidenceChain.length > 0}}">
        <view
          class="evidence-card evidence-{{item.kind}}"
          wx:for="{{visibleEvidenceChain}}"
          wx:key="id"
          bindtap="onEvidenceTap"
          data-id="{{item.id}}"
          data-type="{{item.type}}"
          data-url="{{item.url}}"
        >
          <view class="evidence-icon row-{{item.type}}">{{item.icon}}</view>
          <view class="evidence-copy">
            <view class="evidence-head">
              <text class="evidence-category">{{item.category}}</text>
              <text class="evidence-status status-{{item.statusClass}}">{{item.statusText}}</text>
            </view>
            <view class="evidence-title-line">
              <text class="evidence-title">{{item.title}}</text>
              <text class="row-time">{{item.timeText}}</text>
            </view>
            <text class="evidence-desc">{{item.summary}}</text>
            <view class="evidence-chip-row" wx:if="{{item.metaChips.length > 0}}">
              <text class="evidence-chip" wx:for="{{item.metaChips}}" wx:for-item="chip" wx:key="*this">{{chip}}</text>
            </view>
          </view>
          <text class="arrow">›</text>
        </view>
        <view class="expand-row" wx:if="{{hiddenEvidenceCount > 0}}" bindtap="onToggleEvidence">
          展开全部 {{hiddenEvidenceCount}} 条证据
        </view>
        <view class="expand-row" wx:elif="{{showAllEvidence && evidenceChain.length > 3}}" bindtap="onToggleEvidence">
          收起证据链
        </view>
      </view>
      <view class="surface empty" wx:else>
        <text>还没有关联证据，完成一次诊断或验证后会自动补充。</text>
      </view>
    </view>

    <view class="action-panel">
      <view class="secondary-action" bindtap="onBackToCenter">返回卡点中心</view>
      <view class="primary-action" bindtap="onGenerateVerification">生成验证卷</view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="empty-title">{{emptyText || '没有找到这个学习卡点'}}</text>
    <view class="primary-action small" bindtap="onBackToCenter">返回卡点中心</view>
  </view>
</view>
