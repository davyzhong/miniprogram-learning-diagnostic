.page-container {
  padding: 24rpx 24rpx 200rpx;
  background: #f5f6fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ========== 顶部提示区 ========== */
.tips-box {
  background: #e8f4fd;
  border: 1rpx solid #b3d8f0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 28rpx;
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a73e8;
  margin-bottom: 12rpx;
}

.tips-item {
  font-size: 26rpx;
  color: #3a6ea5;
  line-height: 1.8;
}

/* ========== 照片数量提示 ========== */
.photo-count {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

/* ========== 照片预览网格 ========== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.photo-item {
  position: relative;
  width: calc((100% - 32rpx) / 3);
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #e0e0e0;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 12rpx;
}

/* ========== 底部操作栏 ========== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

.btn-camera {
  flex: 1;
  background: #1a73e8;
  color: #fff;
}

.btn-album {
  flex: 1;
  background: #fff;
  color: #1a73e8;
  border: 2rpx solid #1a73e8;
}

.btn-analyze {
  width: 100%;
  background: #34a853;
  color: #fff;
  font-size: 32rpx;
}

.btn-analyze[disabled] {
  background: #c8c8c8;
  color: #fff;
}

/* ========== 进度遮罩 ========== */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #1a73e8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #333;
  text-align: center;
}
