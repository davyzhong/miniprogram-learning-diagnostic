<!-- 学习记录 -->
<view class="page b1-page">
  <view class="header compact-header">
    <view class="header-copy">
      <view class="title-row">
        <text class="b1-symbol title-symbol">{{headerSymbol}}</text>
        <text class="title">{{titleText}}</text>
      </view>
      <text class="subtitle">诊断、验证卷和反馈按学习闭环整理。</text>
    </view>
  </view>

  <view class="filter-card">
    <view class="summary-text">{{summaryText}}</view>
    <view class="summary-grid" wx:if="{{summaryCards.length > 0}}">
      <view class="summary-cell" wx:for="{{summaryCards}}" wx:key="key">
        <text class="summary-value">{{item.value}}</text>
        <text class="summary-label">{{item.label}}</text>
      </view>
    </view>
    <view class="filter-bar">
      <view
        class="filter-pill filter-{{item.key || 'all'}} {{item.active ? 'is-active' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        bindtap="onFilterTap"
        data-subject="{{item.key}}"
      >
        <text class="filter-name">{{item.name}}</text>
        <text class="filter-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <view class="cleanup-card" wx:if="{{cleanup.hasCandidates}}">
    <view class="cleanup-copy">
      <text class="cleanup-title">{{cleanup.title}}</text>
      <text class="cleanup-desc">{{cleanup.desc}}</text>
    </view>
    <button class="cleanup-btn" wx:if="{{cleanup.canCleanup}}" bindtap="onCleanupStaleRecords" disabled="{{cleaningStaleRecords}}">{{cleaningStaleRecords ? '清理中...' : '清理'}}</button>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载学习记录...</view>

  <view class="empty" wx:if="{{!loading && days.length === 0}}">
    <text class="empty-deco">{{emptySymbol}}</text>
    <text class="empty-title">{{emptyTitle}}</text>
    <text class="empty-desc">{{emptyDesc}}</text>
  </view>

  <view class="day-group" wx:for="{{days}}" wx:key="dateKey" wx:for-item="day" wx:for-index="dayIndex">
    <view class="day-header">
      <text class="day-title">{{day.dayLabel}}</text>
      <text class="day-meta">{{day.events.length}} 条主记录</text>
    </view>

    <view
      class="status-strip status-{{status.status}}"
      wx:for="{{day.statusItems}}"
      wx:key="id"
      wx:for-item="status"
      wx:for-index="statusIndex"
      bindtap="onStatusTap"
      data-day-index="{{dayIndex}}"
      data-status-index="{{statusIndex}}"
    >
      <text class="status-dot">{{status.statusIcon}}</text>
      <view class="status-copy">
        <text class="status-title">{{status.title}}</text>
        <text class="status-text">{{status.statusText}}</text>
      </view>
      <text class="status-time">{{status.timeText}}</text>
    </view>

    <view class="timeline">
      <view
        class="record-card subject-{{event.subject}} record-{{event.kind}}"
        wx:for="{{day.events}}"
        wx:key="id"
        wx:for-item="event"
        wx:for-index="eventIndex"
        bindtap="onEventTap"
        data-day-index="{{dayIndex}}"
        data-event-index="{{eventIndex}}"
      >
        <view class="event-marker">{{event.icon}}</view>
        <view class="event-body">
          <view class="event-topline">
            <text class="event-title">{{event.title}}</text>
            <view class="event-meta">
              <text class="event-time">{{event.timeText}}</text>
              <text class="paper-code" wx:if="{{event.showPaperCode}}" catchtap="onTraceableUrlTap" data-url="{{event.paperCodeUrl}}">{{event.paperCode}}</text>
            </view>
          </view>
          <text class="event-summary">{{event.summary}}</text>
          <text class="event-status" wx:if="{{event.statusText}}" catchtap="onTraceableUrlTap" data-url="{{event.statusUrl}}">{{event.statusText}}</text>
          <view class="chips" wx:if="{{event.chipItems.length > 0}}">
            <text class="chip" wx:for="{{event.chipItems}}" wx:key="text" wx:for-item="chip" catchtap="onTraceableUrlTap" data-url="{{chip.url}}">{{chip.text}}</text>
          </view>

          <view class="folded-evidence" wx:if="{{event.foldedEvidence.length > 0}}">
            <view
              class="fold-row"
              wx:for="{{event.foldedEvidence}}"
              wx:key="fileID"
              wx:for-item="evidence"
              wx:for-index="evidenceIndex"
              catchtap="onPreviewFoldedEvidence"
              data-day-index="{{dayIndex}}"
              data-event-index="{{eventIndex}}"
              data-evidence-index="{{evidenceIndex}}"
            >
              <text class="fold-icon">{{evidence.icon}}</text>
              <view class="fold-copy">
                <view class="fold-title-row">
                  <text class="fold-title">{{evidence.title}}</text>
                  <text class="duplicate-badge" wx:if="{{evidence.isDuplicate}}">疑似重复</text>
                </view>
                <text class="fold-summary">{{evidence.summary}}</text>
              </view>
              <text class="preview-arrow">›</text>
            </view>
          </view>
          <text class="fold-remaining" wx:if="{{event.remainingEvidenceCount > 0}}">还有 {{event.remainingEvidenceCount}} 张证据，进入报告查看</text>

          <text class="event-action" wx:if="{{event.actionText}}">{{event.actionText}} ›</text>
        </view>
      </view>
    </view>
  </view>

  <button
    class="load-more-btn"
    wx:if="{{!loading && hasMoreRecords}}"
    bindtap="onLoadMoreRecords"
    disabled="{{loadingMoreRecords}}"
  >
    {{loadingMoreRecords ? '加载中...' : '加载更多记录'}}
  </button>
</view>
