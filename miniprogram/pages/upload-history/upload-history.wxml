<!-- 上传照片历史 -->
<view class="page">
  <view class="header">
    <text class="title">{{studentName}} · {{subjectName}}</text>
    <text class="subtitle">每张上传照片都会保留；疑似重复照片不重复计入诊断。</text>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载上传历史...</view>

  <view class="empty" wx:if="{{!loading && groups.length === 0}}">
    <text class="empty-title">暂无上传照片</text>
    <text class="empty-desc">完成一次拍照诊断后，原始照片会显示在这里。</text>
  </view>

  <view class="report-group" wx:for="{{groups}}" wx:key="reportId" wx:for-index="groupIndex">
    <view class="group-header">
      <view>
        <text class="group-title">{{item.reportTitle}}</text>
        <text class="group-meta">{{item.dateText}} · {{item.photoCount}} 张照片</text>
      </view>
      <view class="group-action" bindtap="onReportTap" data-id="{{item.reportId}}">查看报告 ›</view>
    </view>
    <view class="duplicate-note" wx:if="{{item.duplicateCount > 0}}">
      {{item.duplicateCount}} 张照片疑似重复，已保留原图但未重复计入诊断
    </view>
    <view
      class="photo-row"
      wx:for="{{item.photos}}"
      wx:key="fileID"
      wx:for-item="photo"
      wx:for-index="photoIndex"
      bindtap="onPreviewPhoto"
      data-group-index="{{groupIndex}}"
      data-photo-index="{{photoIndex}}"
    >
      <image class="thumbnail" src="{{photo.tempFileURL}}" mode="aspectFill" />
      <view class="photo-info">
        <view class="photo-title-row">
          <text class="photo-name">{{photo.fileName}}</text>
          <text class="duplicate-badge" wx:if="{{photo.isDuplicate}}">疑似重复</text>
        </view>
        <text class="ocr-summary">{{photo.summaryText}}</text>
      </view>
      <text class="preview-arrow">›</text>
    </view>
  </view>
</view>
