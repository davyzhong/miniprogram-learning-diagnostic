<!-- 学习记录 -->
<view class="page">
  <view class="header">
    <text class="title">{{titleText}}</text>
    <text class="subtitle">按天整理诊断、验证试卷和作答上传，保留每次学习闭环的证据链。</text>
    <view class="filter-bar">
      <view
        class="filter-pill {{item.active ? 'is-active' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        bindtap="onFilterTap"
        data-subject="{{item.key}}"
      >
        <text class="filter-name">{{item.name}}</text>
        <text class="filter-count">{{item.count}}</text>
      </view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载学习记录...</view>

  <view class="empty" wx:if="{{!loading && days.length === 0}}">
    <text class="empty-title">{{emptyTitle}}</text>
    <text class="empty-desc">{{emptyDesc}}</text>
  </view>

  <view class="day-group" wx:for="{{days}}" wx:key="dateKey" wx:for-index="dayIndex">
    <view class="day-header">
      <text class="day-title">{{item.dayLabel}}</text>
      <text class="day-meta">{{item.events.length}} 条学习事件</text>
    </view>

    <view class="timeline">
      <view
        class="record-card record-{{event.kind}}"
        wx:for="{{item.events}}"
        wx:key="id"
        wx:for-item="event"
        wx:for-index="eventIndex"
        bindtap="onEventTap"
        data-day-index="{{dayIndex}}"
        data-event-index="{{eventIndex}}"
      >
        <view class="event-icon">{{event.icon}}</view>
        <view class="event-body">
          <view class="event-topline">
            <text class="event-title">{{event.title}}</text>
            <text class="event-time">{{event.timeText}}</text>
          </view>
          <text class="event-summary">{{event.summary}}</text>
          <view class="chips" wx:if="{{event.chips.length > 0}}">
            <text class="chip" wx:for="{{event.chips}}" wx:key="*this" wx:for-item="chip">{{chip}}</text>
          </view>

          <view class="photo-list" wx:if="{{event.photos.length > 0}}">
            <view
              class="photo-row"
              wx:for="{{event.photos}}"
              wx:key="fileID"
              wx:for-item="photo"
              wx:for-index="photoIndex"
              catchtap="onPreviewPhoto"
              data-day-index="{{dayIndex}}"
              data-event-index="{{eventIndex}}"
              data-photo-index="{{photoIndex}}"
            >
              <image class="thumbnail" src="{{photo.tempFileURL}}" mode="aspectFill" />
              <view class="photo-info">
                <view class="photo-title-row">
                  <text class="photo-name">{{photo.fileName}}</text>
                  <text class="duplicate-badge" wx:if="{{photo.isDuplicate}}">疑似重复</text>
                </view>
                <text class="ocr-summary">{{photo.summaryText}}</text>
              </view>
              <text class="preview-arrow">›</text>
            </view>
          </view>

          <text class="event-action" wx:if="{{event.actionText}}">{{event.actionText}} ›</text>
        </view>
      </view>
    </view>
  </view>
</view>
