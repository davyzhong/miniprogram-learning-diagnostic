.page {
  min-height: 100vh;
  background: #f7fafc;
  padding: 28rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 28rpx;
}

.title {
  display: block;
  color: #1a202c;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.subtitle {
  color: #718096;
  font-size: 24rpx;
  line-height: 1.5;
}

.loading,
.empty {
  color: #718096;
  font-size: 26rpx;
  padding: 100rpx 24rpx;
  text-align: center;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #4a5568;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.report-group {
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.group-title,
.group-meta {
  display: block;
}

.group-title {
  color: #1a202c;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.group-meta,
.group-action {
  color: #718096;
  font-size: 22rpx;
}

.group-action {
  color: #2b6cb0;
}

.duplicate-note {
  background: #fffaf0;
  color: #975a16;
  font-size: 22rpx;
  line-height: 1.4;
  padding: 14rpx 24rpx;
}

.photo-row {
  display: flex;
  align-items: center;
  min-height: 140rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.photo-row:last-child {
  border-bottom: none;
}

.thumbnail {
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: #edf2f7;
  flex-shrink: 0;
}

.photo-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.photo-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.photo-name {
  color: #2d3748;
  font-size: 25rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.duplicate-badge {
  background: #fffaf0;
  border-radius: 6rpx;
  color: #c05621;
  flex-shrink: 0;
  font-size: 20rpx;
  margin-left: 10rpx;
  padding: 3rpx 8rpx;
}

.ocr-summary {
  color: #718096;
  display: -webkit-box;
  font-size: 22rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.preview-arrow {
  color: #cbd5e0;
  flex-shrink: 0;
  font-size: 34rpx;
  margin-left: 10rpx;
}
