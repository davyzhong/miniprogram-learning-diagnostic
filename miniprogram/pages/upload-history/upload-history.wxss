.page {
  min-height: 100vh;
  background: #f5f7fb;
  box-sizing: border-box;
  padding: 24rpx;
}

.header {
  margin-bottom: 18rpx;
}

.compact-header {
  align-items: center;
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.header-illustration {
  align-items: center;
  background: linear-gradient(135deg, #e8f1ff 0%, #e9f8ef 100%);
  border: 1rpx solid #dbe8f4;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(45, 108, 223, 0.08);
  display: flex;
  flex-shrink: 0;
  height: 88rpx;
  justify-content: center;
  position: relative;
  width: 88rpx;
}

.header-illustration-main {
  color: #2d6cdf;
  font-size: 30rpx;
  font-weight: 820;
}

.header-illustration-sub {
  align-items: center;
  background: #34a36f;
  border: 2rpx solid #fff;
  border-radius: 999rpx;
  bottom: 8rpx;
  color: #fff;
  display: flex;
  font-size: 17rpx;
  font-weight: 800;
  height: 34rpx;
  justify-content: center;
  position: absolute;
  right: 4rpx;
  width: 34rpx;
}

.title {
  color: #172033;
  display: block;
  font-size: 34rpx;
  font-weight: 760;
  margin-bottom: 10rpx;
}

.subtitle {
  color: #687588;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
}

.filter-card {
  background: #fff;
  border: 1rpx solid #e7edf5;
  border-radius: 14rpx;
  box-shadow: 0 3rpx 12rpx rgba(23, 32, 51, 0.04);
  margin-bottom: 26rpx;
  padding: 14rpx;
}

.summary-text {
  color: #52667d;
  display: block;
  font-size: 23rpx;
  line-height: 1.45;
  padding: 4rpx 4rpx 14rpx;
}

.summary-grid {
  display: grid;
  gap: 10rpx;
  grid-template-columns: repeat(4, 1fr);
  margin-bottom: 16rpx;
}

.summary-cell {
  background: #f7fafc;
  border: 1rpx solid #e8eef6;
  border-radius: 12rpx;
  padding: 12rpx 6rpx;
  text-align: center;
}

.summary-value {
  color: #1f4f82;
  display: block;
  font-size: 30rpx;
  font-weight: 820;
}

.summary-label {
  color: #7a8899;
  display: block;
  font-size: 19rpx;
  margin-top: 2rpx;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding-bottom: 2rpx;
  white-space: nowrap;
}

.filter-pill {
  align-items: center;
  background: #fff;
  border: 1rpx solid #dce5f0;
  border-radius: 999rpx;
  color: #52667d;
  display: flex;
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 650;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
}

.filter-pill.is-active {
  background: #e7f0ff;
  border-color: #2d6cdf;
  color: #2459a5;
}

.filter-count {
  align-items: center;
  background: rgba(45, 108, 223, 0.1);
  border-radius: 999rpx;
  display: flex;
  font-size: 19rpx;
  height: 30rpx;
  justify-content: center;
  min-width: 30rpx;
  padding: 0 8rpx;
}

.filter-pill.is-active .filter-count {
  background: #2d6cdf;
  color: #fff;
}

.cleanup-card {
  align-items: center;
  background: #fff8ea;
  border: 1rpx solid #f0dfbc;
  border-radius: 14rpx;
  color: #8b5a00;
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
}

.cleanup-copy {
  flex: 1;
  min-width: 0;
}

.cleanup-title,
.cleanup-desc {
  display: block;
}

.cleanup-title {
  font-size: 24rpx;
  font-weight: 780;
}

.cleanup-desc {
  font-size: 21rpx;
  line-height: 1.45;
  margin-top: 5rpx;
  opacity: 0.88;
}

.cleanup-btn {
  background: #fff;
  border: 1rpx solid #e0b75c;
  border-radius: 999rpx;
  color: #8b5a00;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1.2;
  min-width: 92rpx;
  padding: 13rpx 18rpx;
}

.cleanup-btn::after {
  border: 0;
}

.loading,
.empty {
  color: #718096;
  font-size: 26rpx;
  padding: 110rpx 24rpx;
  text-align: center;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.day-group {
  margin-bottom: 30rpx;
}

.day-header {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  margin: 0 4rpx 14rpx;
}

.day-title {
  color: #182235;
  font-size: 31rpx;
  font-weight: 760;
}

.day-meta {
  color: #8a97a8;
  font-size: 22rpx;
}

.status-strip {
  align-items: center;
  background: #fff8ea;
  border: 1rpx solid #f0dfbc;
  border-radius: 12rpx;
  color: #8b5a00;
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
}

.status-failed,
.status-timeout {
  background: #fff1f1;
  border-color: #f4c8c8;
  color: #a43c3c;
}

.status-dot {
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  display: flex;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 850;
  height: 42rpx;
  justify-content: center;
  width: 42rpx;
}

.status-copy {
  flex: 1;
  min-width: 0;
}

.status-title,
.status-text {
  display: block;
}

.status-title {
  font-size: 23rpx;
  font-weight: 760;
}

.status-text {
  font-size: 20rpx;
  line-height: 1.35;
  opacity: 0.86;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-time {
  flex-shrink: 0;
  font-size: 20rpx;
  opacity: 0.72;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.record-card {
  align-items: flex-start;
  background: #fff;
  border: 1rpx solid #e7edf5;
  border-radius: 12rpx;
  box-shadow: 0 3rpx 14rpx rgba(23, 32, 51, 0.05);
  display: flex;
  padding: 18rpx 20rpx;
}

.record-verification-report {
  border-left: 6rpx solid #2f9e67;
}

.record-verification-paper {
  border-left: 6rpx solid #2d6cdf;
}

.record-diagnosis-report {
  border-left: 6rpx solid #e46f2e;
}

.record-english-familiarity-session {
  border-left: 6rpx solid #9b6ad6;
}

.record-english-dictation-session {
  border-left: 6rpx solid #c96b2c;
}

.event-icon {
  align-items: center;
  background: #eef4fb;
  border: 1rpx solid #d8e6fb;
  border-radius: 14rpx;
  color: #27486c;
  display: flex;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  height: 54rpx;
  justify-content: center;
  margin-right: 18rpx;
  width: 54rpx;
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-topline {
  align-items: center;
  display: flex;
  gap: 14rpx;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.event-title {
  color: #25364a;
  font-size: 28rpx;
  font-weight: 720;
}

.event-time {
  color: #9aa7b7;
  flex-shrink: 0;
  font-size: 21rpx;
}

.event-summary {
  color: #5f6f83;
  display: block;
  font-size: 23rpx;
  line-height: 1.48;
}

.paper-code-row {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.paper-code-row:active,
.event-status:active,
.chip:active,
.event-action:active,
.status-strip:active,
.record-card:active {
  opacity: 0.74;
}

.paper-code-label,
.paper-code-value {
  align-items: center;
  border-radius: 8rpx;
  display: flex;
  line-height: 1;
  min-height: 38rpx;
  padding: 0 12rpx;
}

.paper-code-label {
  background: #eef6ff;
  color: #4c6f97;
  font-size: 19rpx;
  font-weight: 700;
}

.paper-code-value {
  background: #dbeafe;
  color: #1f5aa6;
  font-size: 22rpx;
  font-weight: 850;
}

.event-status {
  color: #2d6cdf;
  display: block;
  font-size: 21rpx;
  font-weight: 680;
  margin-top: 8rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.chip {
  background: #f1f5f9;
  border-radius: 7rpx;
  color: #53657a;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 10rpx;
}

.record-verification-paper .event-icon {
  background: #e7f0ff;
  border-color: #b7cff8;
  color: #2459a5;
}

.folded-evidence {
  border-top: 1rpx solid #edf2f7;
  margin-top: 14rpx;
  padding-top: 8rpx;
}

.fold-row {
  align-items: center;
  border-bottom: 1rpx solid #edf2f7;
  display: flex;
  min-height: 64rpx;
  padding: 10rpx 0;
}

.fold-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.fold-icon {
  align-items: center;
  background: #edf6ff;
  border-radius: 8rpx;
  color: #2d6cdf;
  display: flex;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 760;
  height: 42rpx;
  justify-content: center;
  margin-right: 12rpx;
  width: 42rpx;
}

.fold-copy {
  flex: 1;
  min-width: 0;
}

.fold-title-row {
  align-items: center;
  display: flex;
  gap: 8rpx;
  margin-bottom: 2rpx;
}

.fold-title {
  color: #334155;
  font-size: 22rpx;
  font-weight: 680;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fold-summary {
  color: #718096;
  display: block;
  font-size: 20rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-list {
  border-top: 1rpx solid #edf2f7;
  margin-top: 16rpx;
}

.photo-row {
  align-items: center;
  border-bottom: 1rpx solid #edf2f7;
  display: flex;
  min-height: 126rpx;
  padding: 16rpx 0;
}

.photo-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.thumbnail {
  background: #edf2f7;
  border-radius: 8rpx;
  flex-shrink: 0;
  height: 96rpx;
  width: 96rpx;
}

.photo-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.photo-title-row {
  align-items: center;
  display: flex;
  margin-bottom: 6rpx;
}

.photo-name {
  color: #334155;
  font-size: 24rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.duplicate-badge {
  background: #fff5e8;
  border-radius: 6rpx;
  color: #c05621;
  flex-shrink: 0;
  font-size: 19rpx;
  margin-left: 10rpx;
  padding: 3rpx 8rpx;
}

.ocr-summary {
  color: #718096;
  display: -webkit-box;
  font-size: 21rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.preview-arrow {
  color: #cbd5e0;
  flex-shrink: 0;
  font-size: 32rpx;
  margin-left: 10rpx;
}

.event-action {
  color: #2b63ad;
  display: block;
  font-size: 23rpx;
  font-weight: 650;
  margin-top: 14rpx;
}

.load-more-btn {
  background: #ffffff;
  border: 1rpx solid #cfe0f5;
  border-radius: 14rpx;
  color: #2d6cdf;
  font-size: 25rpx;
  font-weight: 720;
  line-height: 1.2;
  margin: 24rpx 0 42rpx;
  padding: 22rpx 24rpx;
}

.load-more-btn::after {
  border: 0;
}
