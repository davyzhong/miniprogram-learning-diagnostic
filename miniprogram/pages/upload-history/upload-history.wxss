.page {
  min-height: 100vh;
  background: #f5f7fb;
  box-sizing: border-box;
  padding: 28rpx;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  color: #172033;
  display: block;
  font-size: 34rpx;
  font-weight: 760;
  margin-bottom: 10rpx;
}

.subtitle {
  color: #687588;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
  overflow-x: auto;
  padding-bottom: 2rpx;
  white-space: nowrap;
}

.filter-pill {
  align-items: center;
  background: #fff;
  border: 1rpx solid #dce5f0;
  border-radius: 999rpx;
  color: #52667d;
  display: flex;
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 650;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
}

.filter-pill.is-active {
  background: #e7f0ff;
  border-color: #2d6cdf;
  color: #2459a5;
}

.filter-count {
  align-items: center;
  background: rgba(45, 108, 223, 0.1);
  border-radius: 999rpx;
  display: flex;
  font-size: 19rpx;
  height: 30rpx;
  justify-content: center;
  min-width: 30rpx;
  padding: 0 8rpx;
}

.filter-pill.is-active .filter-count {
  background: #2d6cdf;
  color: #fff;
}

.loading,
.empty {
  color: #718096;
  font-size: 26rpx;
  padding: 110rpx 24rpx;
  text-align: center;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.day-group {
  margin-bottom: 34rpx;
}

.day-header {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  margin: 0 4rpx 14rpx;
}

.day-title {
  color: #182235;
  font-size: 31rpx;
  font-weight: 760;
}

.day-meta {
  color: #8a97a8;
  font-size: 22rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.record-card {
  align-items: flex-start;
  background: #fff;
  border: 1rpx solid #e7edf5;
  border-radius: 12rpx;
  box-shadow: 0 3rpx 14rpx rgba(23, 32, 51, 0.05);
  display: flex;
  padding: 22rpx;
}

.record-verification-report {
  border-left: 6rpx solid #2f9e67;
}

.record-verification-paper {
  border-left: 6rpx solid #2d6cdf;
}

.record-diagnosis-report {
  border-left: 6rpx solid #e46f2e;
}

.event-icon {
  align-items: center;
  background: #eef4fb;
  border-radius: 10rpx;
  color: #27486c;
  display: flex;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  height: 54rpx;
  justify-content: center;
  margin-right: 18rpx;
  width: 54rpx;
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-topline {
  align-items: center;
  display: flex;
  gap: 14rpx;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.event-title {
  color: #25364a;
  font-size: 28rpx;
  font-weight: 720;
}

.event-time {
  color: #9aa7b7;
  flex-shrink: 0;
  font-size: 21rpx;
}

.event-summary {
  color: #5f6f83;
  display: block;
  font-size: 23rpx;
  line-height: 1.48;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.chip {
  background: #f1f5f9;
  border-radius: 7rpx;
  color: #53657a;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 10rpx;
}

.photo-list {
  border-top: 1rpx solid #edf2f7;
  margin-top: 16rpx;
}

.photo-row {
  align-items: center;
  border-bottom: 1rpx solid #edf2f7;
  display: flex;
  min-height: 126rpx;
  padding: 16rpx 0;
}

.photo-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.thumbnail {
  background: #edf2f7;
  border-radius: 8rpx;
  flex-shrink: 0;
  height: 96rpx;
  width: 96rpx;
}

.photo-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.photo-title-row {
  align-items: center;
  display: flex;
  margin-bottom: 6rpx;
}

.photo-name {
  color: #334155;
  font-size: 24rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.duplicate-badge {
  background: #fff5e8;
  border-radius: 6rpx;
  color: #c05621;
  flex-shrink: 0;
  font-size: 19rpx;
  margin-left: 10rpx;
  padding: 3rpx 8rpx;
}

.ocr-summary {
  color: #718096;
  display: -webkit-box;
  font-size: 21rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.preview-arrow {
  color: #cbd5e0;
  flex-shrink: 0;
  font-size: 32rpx;
  margin-left: 10rpx;
}

.event-action {
  color: #2b63ad;
  display: block;
  font-size: 23rpx;
  font-weight: 650;
  margin-top: 14rpx;
}
