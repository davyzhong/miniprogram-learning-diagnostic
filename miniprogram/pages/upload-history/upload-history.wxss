.page {
  min-height: 100vh;
  background: #f8f5ef;
  box-sizing: border-box;
  padding: 24rpx;
}

.header {
  margin-bottom: 18rpx;
}

.compact-header {
  align-items: stretch;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  justify-content: space-between;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.header-illustration {
  background: linear-gradient(135deg, #e8f1ff 0%, #e9f8ef 100%);
  border: 1rpx solid #dbe8f4;
  border-radius: 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(45, 108, 223, 0.08);
  flex-shrink: 0;
  height: 390rpx;
  width: 100%;
  order: -1;
}

.header-illustration-main {
  color: #2d6cdf;
  font-size: 30rpx;
  font-weight: 820;
}

.header-illustration-sub {
  align-items: center;
  background: #34a36f;
  border: 2rpx solid #fff;
  border-radius: 999rpx;
  bottom: 8rpx;
  color: #fff;
  display: flex;
  font-size: 20rpx;
  font-weight: 800;
  height: 34rpx;
  justify-content: center;
  position: absolute;
  right: 4rpx;
  width: 34rpx;
}

.title {
  color: #26383a;
  display: block;
  font-size: 34rpx;
  font-weight: 760;
  margin-bottom: 10rpx;
}

.subtitle {
  color: #566568;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
}

.filter-card {
  background: #fffdfa;
  border: 1rpx solid #dedbd2;
  border-radius: 12rpx;
  box-shadow: none;
  margin-bottom: 12rpx;
  padding: 14rpx;
}

.summary-text {
  color: #566568;
  display: block;
  font-size: 23rpx;
  line-height: 1.45;
  padding: 4rpx 4rpx 10rpx;
}

.filter-bar {
  display: grid;
  gap: 8rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.filter-pill {
  align-items: center;
  background: #fffdfa;
  border: 1rpx solid #dedbd2;
  border-radius: 8rpx;
  color: #566568;
  display: flex;
  font-size: 21rpx;
  font-weight: 600;
  gap: 4rpx;
  justify-content: center;
  min-height: 52rpx;
  padding: 0 6rpx;
}

.filter-pill.is-active {
  background: #e1e8fa;
  border-color: #4168b7;
  color: #253436;
}

.filter-count {
  align-items: center;
  background: #f8f5ef;
  border-radius: 6rpx;
  display: flex;
  font-size: 20rpx;
  height: 30rpx;
  justify-content: center;
  min-width: 30rpx;
  padding: 0 8rpx;
}

.filter-pill.is-active .filter-count {
  background: #4168b7;
  color: #fffdfa;
}

.cleanup-card {
  align-items: center;
  background: #fff8ea;
  border: 1rpx solid #f0dfbc;
  border-radius: 14rpx;
  color: #8b5a00;
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
}

.cleanup-copy {
  flex: 1;
  min-width: 0;
}

.cleanup-title,
.cleanup-desc {
  display: block;
}

.cleanup-title {
  font-size: 24rpx;
  font-weight: 780;
}

.cleanup-desc {
  font-size: 21rpx;
  line-height: 1.45;
  margin-top: 5rpx;
  opacity: 0.88;
}

.cleanup-btn {
  background: #fff;
  border: 1rpx solid #e0b75c;
  border-radius: 999rpx;
  color: #8b5a00;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1.2;
  min-width: 92rpx;
  padding: 13rpx 18rpx;
}

.cleanup-btn::after {
  border: 0;
}

.loading,
.empty {
  color: #718096;
  font-size: 26rpx;
  padding: 40rpx 24rpx;
  text-align: center;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #334155;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.day-group {
  margin-bottom: 14rpx;
}

.day-header {
  align-items: baseline;
  display: flex;
  justify-content: space-between;
  margin: 0 4rpx 10rpx;
}

.day-title {
  color: #182235;
  font-size: 31rpx;
  font-weight: 760;
}

.day-meta {
  color: #8a97a8;
  font-size: 22rpx;
}

.status-strip {
  align-items: center;
  background: #fff8ea;
  border: 1rpx solid #f0dfbc;
  border-radius: 12rpx;
  color: #8b5a00;
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
  padding: 12rpx 16rpx;
}

.status-failed,
.status-timeout {
  background: #fff1f1;
  border-color: #f4c8c8;
  color: #a43c3c;
}

.status-dot {
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  display: flex;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 850;
  height: 42rpx;
  justify-content: center;
  width: 42rpx;
}

.status-copy {
  flex: 1;
  min-width: 0;
}

.status-title,
.status-text {
  display: block;
}

.status-title {
  font-size: 23rpx;
  font-weight: 760;
}

.status-text {
  font-size: 20rpx;
  line-height: 1.35;
  opacity: 0.86;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-time {
  flex-shrink: 0;
  font-size: 20rpx;
  opacity: 0.72;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-card {
  align-items: flex-start;
  background: #fffdfa;
  border: 1rpx solid #dedbd2;
  border-left: 6rpx solid #778386;
  border-radius: 10rpx;
  box-shadow: none;
  display: flex;
  padding: 12rpx 16rpx;
}

.subject-math { border-left-color: #b37808; }
.subject-chinese { border-left-color: #d4483a; }
.subject-english { border-left-color: #4168b7; }
.subject-general { border-left-color: #16775e; }

.event-marker {
  align-items: center;
  background: #f8f5ef;
  border: 1rpx solid #dedbd2;
  border-radius: 8rpx;
  color: #26383a;
  display: flex;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  height: 48rpx;
  justify-content: center;
  margin-right: 18rpx;
  width: 48rpx;
}

.event-body {
  flex: 1;
  min-width: 0;
}

.event-topline {
  align-items: center;
  display: flex;
  gap: 10rpx;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.event-title {
  color: #26383a;
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  min-width: 0;
}

.event-time {
  color: #9aa7b7;
  flex-shrink: 0;
  font-size: 21rpx;
}

.event-summary {
  color: #566568;
  display: block;
  font-size: 23rpx;
  line-height: 1.48;
}

.event-meta {
  align-items: center;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  gap: 3rpx;
}

.record-verification-paper .event-topline { flex-wrap: wrap; gap: 4rpx 10rpx; }
.record-verification-paper .event-meta { align-items: center; flex-basis: 100%; flex-direction: row; justify-content: space-between; min-width: 0; }

.paper-code:active,
.event-status:active,
.chip:active,
.event-action:active,
.status-strip:active,
.record-card:active {
  opacity: 0.74;
}

.paper-code {
  align-items: center;
  background: #fae9b7;
  border-radius: 6rpx;
  color: #6d5000;
  box-sizing: border-box;
  display: flex;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  max-width: calc(100% - 60rpx);
  min-height: 38rpx;
  overflow: hidden;
  padding: 0 8rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-status {
  background: #e8f4f0;
  border-radius: 6rpx;
  color: #16775e;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  max-width: 45%;
  overflow: hidden;
  padding: 6rpx 10rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.chip {
  background: #f8f5ef;
  border-radius: 6rpx;
  color: #566568;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 10rpx;
}

.record-verification-paper .event-marker {
  background: #e1e8fa;
  border-color: #4168b7;
  color: #253436;
}

.folded-evidence {
  border-top: 1rpx solid #edf2f7;
  max-height: 240rpx;
  margin-top: 10rpx;
  padding-top: 8rpx;
}

.fold-remaining {
  color: #718096;
  display: block;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 6rpx;
}

.fold-row {
  align-items: center;
  border-bottom: 1rpx solid #edf2f7;
  display: flex;
  min-height: 64rpx;
  padding: 10rpx 0;
}

.fold-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.fold-icon {
  align-items: center;
  background: #edf6ff;
  border-radius: 8rpx;
  color: #2d6cdf;
  display: flex;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 760;
  height: 42rpx;
  justify-content: center;
  margin-right: 12rpx;
  width: 42rpx;
}

.fold-copy {
  flex: 1;
  min-width: 0;
}

.fold-title-row {
  align-items: center;
  display: flex;
  gap: 8rpx;
  margin-bottom: 2rpx;
}

.fold-title {
  color: #334155;
  font-size: 22rpx;
  font-weight: 680;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fold-summary {
  color: #718096;
  display: block;
  font-size: 20rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-list {
  border-top: 1rpx solid #edf2f7;
  margin-top: 16rpx;
}

.photo-row {
  align-items: center;
  border-bottom: 1rpx solid #edf2f7;
  display: flex;
  min-height: 126rpx;
  padding: 16rpx 0;
}

.photo-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.thumbnail {
  background: #edf2f7;
  border-radius: 8rpx;
  flex-shrink: 0;
  height: 96rpx;
  width: 96rpx;
}

.photo-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.photo-title-row {
  align-items: center;
  display: flex;
  margin-bottom: 6rpx;
}

.photo-name {
  color: #334155;
  font-size: 24rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.duplicate-badge {
  background: #fff5e8;
  border-radius: 6rpx;
  color: var(--b1-waiting-fg);
  flex-shrink: 0;
  font-size: 20rpx;
  margin-left: 10rpx;
  padding: 3rpx 8rpx;
}

.ocr-summary {
  color: #718096;
  display: -webkit-box;
  font-size: 21rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.preview-arrow {
  color: #cbd5e0;
  flex-shrink: 0;
  font-size: 32rpx;
  margin-left: 10rpx;
}

.event-action {
  color: #4168b7;
  display: block;
  font-size: 23rpx;
  font-weight: 650;
  margin-top: 14rpx;
}

.load-more-btn {
  background: #ffffff;
  border: 1rpx solid #cfe0f5;
  border-radius: 14rpx;
  color: #2d6cdf;
  font-size: 25rpx;
  font-weight: 720;
  line-height: 1.2;
  margin: 24rpx 0;
  padding: 22rpx 24rpx;
}

.load-more-btn::after {
  border: 0;
}

/* 第四批：emoji 符号 */
.title-row { display: flex; align-items: center; gap: 10rpx; }
.title-symbol { font-size: 32rpx; }
.empty-deco { display: block; font-size: 80rpx; line-height: 1; margin-bottom: 16rpx; text-align: center; }
