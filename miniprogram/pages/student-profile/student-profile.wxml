<view class="page">
  <view class="loading-state" wx:if="{{loading}}">
    <text>正在整理学习档案...</text>
  </view>

  <view class="profile-home" wx:elif="{{home}}">
    <view class="top-row">
      <view class="top-left">
        <text class="page-title">{{home.studentName}} · 学习档案</text>
      </view>
      <view class="manage-actions">
        <view class="manage-link" wx:if="{{permissions.canManageParents}}" bindtap="onParentManagement">家长管理</view>
        <view class="switch-student-btn" bindtap="onBackHome">
          <text class="switch-icon">⇄</text>
          <text class="switch-text">切换孩子</text>
        </view>
      </view>
    </view>

    <view class="personal-hero-card" catchtap="onPrimaryAction">
      <view class="personal-hero-copy">
        <view class="student-line">
          <view class="mini-avatar">{{home.avatarText}}</view>
          <view class="student-copy">
            <text class="student-name">{{home.studentName}}</text>
            <text class="student-meta">{{home.gradeText}}<text wx:if="{{home.gradeText}}"> · </text>最近更新：{{home.recentUpdateText}}</text>
          </view>
        </view>
        <text class="section-kicker">个人学习工作台</text>
        <text class="personal-hero-title">{{home.personalHero.title}}</text>
        <text class="personal-hero-summary">{{home.personalHero.summary}}</text>
        <text class="personal-hero-action">{{home.personalHero.actionText}} ›</text>
      </view>
    </view>

    <view class="personal-primary-action" catchtap="onPrimaryAction">
      <view class="personal-action-badge">今日行动</view>
      <view class="personal-primary-copy">
        <text class="personal-primary-title">{{home.primaryActionCard.title}}</text>
        <text class="personal-primary-summary">{{home.primaryActionCard.summary}}</text>
      </view>
      <text class="personal-primary-link">{{home.primaryActionCard.actionText}} ›</text>
    </view>

    <view class="personal-report-card report-{{home.reportPanel.kind}}" wx:if="{{home.reportPanel.visible}}" catchtap="onTraceableUrlTap" data-url="{{home.reportPanel.url}}">
      <view class="report-mark report-{{home.reportPanel.kind}}">{{home.reportPanel.icon}}</view>
      <view class="primary-report-copy">
        <view class="report-title-line">
          <view class="report-title-copy">
            <text class="primary-report-title">{{home.reportPanel.title}}</text>
            <text class="primary-report-time" wx:if="{{home.reportPanel.generatedAtText}}">生成于 {{home.reportPanel.generatedAtText}}</text>
          </view>
          <text class="report-action">{{home.reportPanel.actionText}} ›</text>
        </view>
        <text class="primary-report-finding" wx:if="{{home.reportPanel.findingText}}">{{home.reportPanel.findingText}}</text>
        <text class="primary-report-summary">{{home.reportPanel.summary}}</text>
        <view class="report-info-grid" wx:if="{{home.reportPanel.generatedAtText || home.reportPanel.evidenceTimeText}}">
          <view class="report-info-cell" wx:if="{{home.reportPanel.generatedAtText}}">
            <text class="report-info-label">报告生成</text>
            <text class="report-info-value">{{home.reportPanel.generatedAtText}}</text>
          </view>
          <view class="report-info-cell" wx:if="{{home.reportPanel.evidenceTimeText}}">
            <text class="report-info-label">证据时间</text>
            <text class="report-info-value">{{home.reportPanel.evidenceTimeText}}</text>
          </view>
        </view>
        <view class="report-chip-row">
          <text class="report-chip report-chip-main" wx:if="{{home.reportPanel.bottleneckText}}">{{home.reportPanel.bottleneckText}}</text>
          <text class="report-chip" wx:if="{{home.reportPanel.evidenceText}}">{{home.reportPanel.evidenceText}}</text>
        </view>
      </view>
    </view>

    <view class="section-block personal-action-section">
      <view class="section-heading between">
        <text>接下来可以做什么</text>
        <text class="section-subtitle-inline">每块都可点击</text>
      </view>
      <view class="personal-action-queue">
        <view
          class="personal-action-card personal-action-{{item.key}}"
          wx:for="{{home.personalActionQueue}}"
          wx:key="key"
          catchtap="onTraceableUrlTap"
          data-url="{{item.url}}"
        >
          <text class="personal-action-title">{{item.title}}</text>
          <text class="personal-action-summary">{{item.summary}}</text>
          <text class="personal-action-link">{{item.actionText}} ›</text>
        </view>
      </view>
    </view>

    <view class="section-block personal-subject-section">
      <view class="section-heading">三科学习入口</view>
      <view class="personal-subject-list">
        <view
          class="personal-subject-row personal-subject-{{item.key}}"
          wx:for="{{home.subjects}}"
          wx:key="key"
          catchtap="onTraceableUrlTap"
          data-url="{{item.url}}"
        >
          <view class="personal-subject-copy">
            <text class="personal-subject-name">{{item.name}}</text>
            <text class="personal-subject-summary">{{item.summary}}</text>
          </view>
          <view class="personal-subject-right">
            <text class="personal-subject-status">{{item.statusText}}</text>
            <text class="personal-subject-action">{{item.actionText}} ›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="text">没有找到学习档案</text>
    <text class="sub-text">请回到首页重新选择孩子。</text>
    <view class="empty-action" bindtap="onBackHome">重新选择孩子</view>
  </view>
</view>
