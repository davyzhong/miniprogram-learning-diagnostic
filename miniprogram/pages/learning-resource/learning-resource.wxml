<view class="page b1-page">
  <status-view wx:if="{{loading}}" state="loading" text="正在整理学习任务..." />

  <status-view wx:elif="{{errorText}}" state="error" text="{{errorText}}" retryText="重新加载" bind:retry="loadPack" />

  <view wx:else>
    <view class="hero">
      <view class="hero-copy">
        <text class="kicker"><text class="b1-symbol kicker-symbol">{{view.practiceSymbol}}</text>学习任务包</text>
        <text class="title">{{view.title}}</text>
        <text class="meta">{{view.timeText}} · {{view.practiceCount}} 道练习</text>
      </view>
    </view>

    <!-- 概述板块 -->
    <view class="block block-summary" wx:if="{{view.summaryBlock}}">
      <text class="block-title">{{view.summaryBlock.title}}</text>
      <text class="block-body">{{view.summaryBlock.body}}</text>
    </view>

    <!-- 错因分析板块（症状 + 根因 + 真实错例）-->
    <view class="block block-concept" wx:if="{{view.conceptBlock}}">
      <text class="block-title">{{view.conceptBlock.title}}</text>
      <text class="block-body">{{view.conceptBlock.body}}</text>
    </view>

    <!-- 正确解题路径（例题 + 分步）-->
    <view class="block block-worked_example" wx:if="{{view.workedExampleBlock}}">
      <text class="block-title">{{view.workedExampleBlock.title}}</text>
      <view class="example-question" wx:if="{{view.workedExampleBlock.question}}">
        <text class="example-q-label">例题</text>
        <text class="example-q-text">{{view.workedExampleBlock.question}}</text>
      </view>
      <view class="step-list" wx:if="{{view.workedExampleBlock.steps.length > 0}}">
        <view class="step-row" wx:for="{{view.workedExampleBlock.steps}}" wx:key="*this">
          <text class="step-num">{{index + 1}}</text>
          <text class="step-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 易错对比（错误做法 vs 正确做法 + 判断方法）-->
    <view class="block block-common_mistake" wx:if="{{view.commonMistakeBlock}}">
      <text class="block-title">{{view.commonMistakeBlock.title}}</text>
      <view class="mistake-row mistake-wrong" wx:if="{{view.commonMistakeBlock.mistake}}">
        <text class="mistake-icon">错误</text>
        <view class="mistake-copy">
          <text class="mistake-label">常见错误</text>
          <text class="mistake-text">{{view.commonMistakeBlock.mistake}}</text>
        </view>
      </view>
      <view class="mistake-row mistake-right" wx:if="{{view.commonMistakeBlock.correction}}">
        <text class="mistake-icon">正确</text>
        <view class="mistake-copy">
          <text class="mistake-label">正确做法</text>
          <text class="mistake-text">{{view.commonMistakeBlock.correction}}</text>
        </view>
      </view>
      <view class="mistake-hint" wx:if="{{view.commonMistakeBlock.explanation}}">
        <text class="mistake-hint-icon">提示</text>
        <text class="mistake-hint-text">{{view.commonMistakeBlock.explanation}}</text>
      </view>
    </view>

    <!-- 练三道（题目 + 折叠答案/解题关键）-->
    <view class="block block-practice" wx:if="{{view.practiceBlock}}">
      <text class="block-title">{{view.practiceBlock.title}}</text>
      <view class="practice-list">
        <view class="practice-row" wx:for="{{view.practiceBlock.questions}}" wx:key="questionId">
          <view class="practice-q-line">
            <text class="practice-num">{{index + 1}}</text>
            <text class="practice-question">{{item.question}}</text>
          </view>
          <view class="practice-reveal-btn" wx:if="{{!item.revealed}}"
                catchtap="onPracticeToggle" data-question-id="{{item.questionId}}">
            <text class="practice-reveal-text">想一想后点开看答案</text>
            <text class="practice-reveal-arrow">▸</text>
          </view>
          <view class="practice-revealed" wx:if="{{item.revealed}}">
            <view class="practice-a-line">
              <text class="practice-answer-label">答案</text>
              <text class="practice-answer">{{item.answer}}</text>
            </view>
            <view class="practice-exp-line" wx:if="{{item.explanation}}">
              <text class="practice-exp-label">解题关键</text>
              <text class="practice-exp">{{item.explanation}}</text>
            </view>
            <view class="practice-collapse-btn"
                  catchtap="onPracticeToggle" data-question-id="{{item.questionId}}">
              <text class="practice-collapse-text">收起</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 怎么算学会了（达标标准）-->
    <view class="block block-mastery_check" wx:if="{{view.masteryBlock}}">
      <text class="block-title">{{view.masteryBlock.title}}</text>
      <text class="block-body">{{view.masteryBlock.body}}</text>
    </view>

    <!-- 外部参考资源 -->
    <view class="external-resources" wx:if="{{view.hasExternalResources}}">
      <view class="section-header">
        <text class="section-title"><text class="b1-symbol section-symbol">{{view.linkSymbol}}</text>外部参考</text>
        <text class="section-hint">由家长打开，不建议孩子直接浏览</text>
      </view>
      <view class="resource-card" wx:for="{{view.resourceCards}}" wx:key="resourceId"
            bindtap="onExternalResourceTap" data-url="{{item.url}}" data-platform="{{item.platform}}" data-can-jump="{{item.canJump}}">
        <view class="resource-info">
          <text class="resource-platform-label">{{item.platformLabel}}</text>
          <view class="resource-text">
            <text class="resource-title">{{item.title}}</text>
            <text class="resource-platform">{{item.platform}} · {{item.role}}</text>
          </view>
        </view>
        <text class="resource-action {{item.canJump ? 'jump' : 'copy'}}">{{item.actionText}}</text>
      </view>
    </view>

    <view class="actions">
      <button class="secondary" bindtap="onScheduleTap">加入下次验证</button>
      <button class="primary" bindtap="onCompleteTap" disabled="{{view.completed}}">
        {{view.completed ? '已完成' : '完成学习'}}
      </button>
    </view>
  </view>
</view>
