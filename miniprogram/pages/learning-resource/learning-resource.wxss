.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 148rpx;
  box-sizing: border-box;
  background: #f5f8fc;
  color: #172033;
}

.loading,
.empty {
  min-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #718096;
  font-size: 26rpx;
  text-align: center;
}

.hero {
  padding: 32rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #eaf5ff, #fff7e8);
  box-shadow: 0 12rpx 30rpx rgba(26, 54, 93, 0.08);
}

.kicker {
  display: block;
  color: #2b6cb0;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #10233f;
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.3;
}

.meta {
  display: block;
  margin-top: 12rpx;
  color: #5b6b82;
  font-size: 26rpx;
}

.block {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(26, 54, 93, 0.06);
}

.block-title {
  display: block;
  color: #172033;
  font-size: 32rpx;
  font-weight: 850;
}

.block-body,
.step {
  display: block;
  margin-top: 14rpx;
  color: #42526a;
  font-size: 28rpx;
  line-height: 1.7;
}

.practice-row {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f7fafc;
}

.practice-question,
.practice-answer {
  display: block;
  color: #2d3748;
  font-size: 28rpx;
  line-height: 1.6;
}

.practice-answer {
  margin-top: 8rpx;
  color: #4a5568;
}

.parent-ref {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #fff7e8;
  color: #7b4b19;
  font-size: 25rpx;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.actions button {
  flex: 1;
  height: 88rpx;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.secondary {
  background: #ffffff;
  color: #2b6cb0;
  border: 2rpx solid #2b6cb0;
}

.primary {
  background: #2b6cb0;
  color: #ffffff;
}

/* 外部参考区 */
.external-resources {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a365d;
}

.section-hint {
  font-size: 22rpx;
  color: #a0aec0;
}

.resource-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  margin-bottom: 12rpx;
  background: #f7fafc;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.resource-card:active {
  background: #edf2f7;
}

.resource-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.resource-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.resource-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.resource-title {
  font-size: 28rpx;
  color: #2d3748;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.resource-platform {
  font-size: 22rpx;
  color: #718096;
  margin-top: 4rpx;
}

.resource-action {
  font-size: 24rpx;
  white-space: nowrap;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}

.resource-action.jump {
  color: #2b6cb0;
  background: #ebf8ff;
}

.resource-action.copy {
  color: #718096;
  background: #edf2f7;
}

/* === 例题+分步 === */
.example-question {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #f0f7ff;
  border-radius: 12rpx;
  border-left: 6rpx solid #2b6cb0;
}

.example-q-label {
  display: inline-block;
  font-size: 22rpx;
  color: #2b6cb0;
  font-weight: 600;
  margin-right: 12rpx;
}

.example-q-text {
  font-size: 28rpx;
  color: #1a365d;
  line-height: 1.6;
}

.step-list {
  margin-top: 16rpx;
}

.step-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.step-row:last-child {
  border-bottom: none;
}

.step-num {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #2b6cb0;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.step-text {
  flex: 1;
  font-size: 27rpx;
  color: #2d3748;
  line-height: 1.6;
}

/* === 易错对比 === */
.mistake-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 20rpx;
  margin-top: 14rpx;
  border-radius: 12rpx;
}

.mistake-wrong {
  background: #fff5f5;
  border-left: 6rpx solid #fc8181;
}

.mistake-right {
  background: #f0fff4;
  border-left: 6rpx solid #68d391;
}

.mistake-icon {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 14rpx;
  margin-top: 2rpx;
}

.mistake-wrong .mistake-icon {
  background: #fc8181;
  color: #fff;
}

.mistake-right .mistake-icon {
  background: #68d391;
  color: #fff;
}

.mistake-copy {
  flex: 1;
}

.mistake-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.mistake-wrong .mistake-label {
  color: #c53030;
}

.mistake-right .mistake-label {
  color: #276749;
}

.mistake-text {
  font-size: 27rpx;
  color: #2d3748;
  line-height: 1.6;
}

.mistake-hint {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background: #fffbeb;
  border-radius: 10rpx;
}

.mistake-hint-icon {
  flex-shrink: 0;
  font-size: 28rpx;
  margin-right: 10rpx;
}

.mistake-hint-text {
  flex: 1;
  font-size: 25rpx;
  color: #744210;
  line-height: 1.6;
}

/* === 练习题（增强版：题号+答案+解题关键）=== */
.practice-list {
  margin-top: 12rpx;
}

.practice-row {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f7fafc;
  border: 1rpx solid #e2e8f0;
}

.practice-q-line {
  display: flex;
  align-items: flex-start;
}

.practice-num {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: #2b6cb0;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 14rpx;
  margin-top: 2rpx;
}

.practice-question {
  flex: 1;
  font-size: 28rpx;
  color: #1a365d;
  font-weight: 500;
  line-height: 1.6;
}

.practice-a-line {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.practice-answer-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #68d391;
  font-weight: 600;
  margin-right: 10rpx;
}

.practice-answer {
  font-size: 26rpx;
  color: #2d3748;
}

.practice-exp-line {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

.practice-exp-label {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #f6ad55;
  font-weight: 600;
  margin-right: 10rpx;
}

.practice-exp {
  flex: 1;
  font-size: 25rpx;
  color: #4a5568;
  line-height: 1.5;
}

/* === 练习题折叠/展开按钮 === */
.practice-reveal-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  margin-left: 50rpx;
  background: #ebf8ff;
  border-radius: 10rpx;
  border: 1rpx dashed #63b3ed;
}

.practice-reveal-btn:active {
  background: #bee3f8;
}

.practice-reveal-text {
  font-size: 24rpx;
  color: #2b6cb0;
  font-weight: 500;
}

.practice-reveal-arrow {
  font-size: 22rpx;
  color: #63b3ed;
}

.practice-revealed {
  margin-top: 14rpx;
  padding: 18rpx 20rpx 10rpx 50rpx;
  background: #f0fff4;
  border-radius: 10rpx;
  border-left: 4rpx solid #68d391;
}

.practice-collapse-btn {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
  padding: 4rpx 0;
}

.practice-collapse-text {
  font-size: 22rpx;
  color: #a0aec0;
  padding: 4rpx 12rpx;
}
