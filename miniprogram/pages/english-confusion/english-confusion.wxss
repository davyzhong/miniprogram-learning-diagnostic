.page{padding:32rpx;background:#f7f8ff;min-height:100vh}.title,.hint,.prompt{display:block;margin:20rpx 0}.title{font-size:42rpx;font-weight:700;color:#312e81}.hint{color:#51627d;line-height:1.6}.prompt{font-size:32rpx}.choices button{margin:12rpx 0;border-radius:14rpx}.selected{border:2rpx solid #4f46e5;background:#eef2ff;color:#4338ca}.bplus-action{background:#4f46e5;color:#fff;border-radius:14rpx}

/* 第四批：emoji 符号 */
.hero-symbol, .title-symbol, .eyebrow-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
.finish-mark.b1-symbol { font-size: 64rpx; }
