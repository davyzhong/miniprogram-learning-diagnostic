<view class="page bplus-page b1-page b1-subject-english"><view class="bplus-state" wx:if="{{loading}}">正在准备易混词…</view><view class="bplus-empty" wx:elif="{{items.length === 0}}">暂时没有需要辨析的易混词，先完成认词或听写。</view><view wx:else><text class="title"><text class="b1-symbol title-symbol">{{confusionSymbol}}</text>辨析 {{currentItem.words[0]}} / {{currentItem.words[1]}}</text><text class="hint">{{currentItem.explanation}}</text><view class="bplus-section"><text class="prompt">{{currentItem.prompt}}</text><view class="choices"><button wx:for="{{currentItem.words}}" wx:key="*this" data-word="{{item}}" bindtap="onChoose" class="{{selected === item ? 'selected' : ''}}">{{item}}</button></view></view><button class="bplus-action" bindtap="onCheck">检查答案</button><text wx:if="{{result}}">{{result}}</text><button class="bplus-action" wx:if="{{index + 1 < items.length}}" bindtap="onNext">下一题</button></view></view>
