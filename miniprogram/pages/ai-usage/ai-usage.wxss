.page {
  padding: 0 0 120rpx;
  min-height: 100vh;
  background: var(--b1-canvas);
  box-sizing: border-box;
}

/* 月份切换 */
.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 8rpx;
  background: var(--b1-surface);
  border-bottom: 1rpx solid var(--b1-border);
}
.month-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--b1-ink-muted);
}
.month-label {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--b1-ink-strong);
  margin: 0 48rpx;
}

/* 内测估算提示 */
.notice-bar {
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: var(--b1-waiting-bg);
  border-radius: 10rpx;
  font-size: 24rpx;
  color: var(--b1-waiting-fg);
  line-height: 1.5;
}

/* 汇总卡片 */
.summary-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx 16rpx 0;
}
.summary-card {
  width: 50%;
  box-sizing: border-box;
  padding: 8rpx;
}
.summary-card .summary-value {
  background: var(--b1-surface);
  border: 1rpx solid var(--b1-border);
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--b1-ink-strong);
}
.summary-card .summary-label {
  padding: 8rpx 24rpx 0;
  font-size: 24rpx;
  color: var(--b1-ink-muted);
}
.summary-hint {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: var(--b1-waiting-fg);
}

.usage-summary-0 .summary-value { border-left: 6rpx solid var(--b1-improved-fg); }
.usage-summary-1 .summary-value { border-left: 6rpx solid var(--b1-subject-math-fg); }
.usage-summary-2 .summary-value { border-left: 6rpx solid var(--b1-subject-english-fg); }
.usage-summary-3 .summary-value { border-left: 6rpx solid var(--b1-neutral-fg); }

/* 功能拆分 */
.section {
  margin: 32rpx 24rpx 0;
  background: var(--b1-surface);
  border: 1rpx solid var(--b1-border);
  border-radius: 10rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--b1-ink-strong);
  margin-bottom: 16rpx;
}
.breakdown-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--b1-border);
}
.breakdown-row:last-child {
  border-bottom: none;
}
.breakdown-name {
  flex: 0 0 180rpx;
  font-size: 26rpx;
  color: var(--b1-ink);
}
.breakdown-meta {
  flex: 1;
  font-size: 22rpx;
  color: var(--b1-ink-subtle);
}
.breakdown-cost {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--b1-improved-fg);
}

.usage-category-photo_analysis .breakdown-cost { color: var(--b1-subject-chinese-fg); }
.usage-category-paper_generation .breakdown-cost { color: var(--b1-subject-math-fg); }
.usage-category-learning_resource_pack .breakdown-cost { color: var(--b1-subject-english-fg); }
.usage-category-dictation_grading .breakdown-cost { color: var(--b1-improved-fg); }

/* 筛选 */
.filter-bar {
  white-space: nowrap;
  padding: 24rpx 16rpx 8rpx;
}
.filter-chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 8rpx;
  border-radius: 32rpx;
  background: var(--b1-surface);
  border: 1rpx solid var(--b1-border);
  font-size: 24rpx;
  color: var(--b1-ink-muted);
}
.filter-chip.active {
  background: var(--b1-ink-strong);
  color: var(--b1-surface);
}

/* 明细按天 */
.day-group {
  margin: 16rpx 24rpx 0;
}
.day-label {
  font-size: 24rpx;
  color: var(--b1-ink-subtle);
  padding: 16rpx 8rpx 8rpx;
}
.event-row {
  display: flex;
  align-items: flex-start;
  background: var(--b1-surface);
  border: 1rpx solid var(--b1-border);
  border-radius: 10rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.event-main {
  flex: 1;
  min-width: 0;
}
.event-name {
  font-size: 28rpx;
  color: var(--b1-ink);
  font-weight: 500;
}
.event-status {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--b1-improved-bg);
  color: var(--b1-improved-fg);
}
.event-status.failed {
  background: var(--b1-destructive-bg);
  color: var(--b1-destructive-fg);
}
.event-status.pending {
  background: var(--b1-waiting-bg);
  color: var(--b1-waiting-fg);
}
.event-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--b1-ink-subtle);
}
.event-sub text {
  margin-right: 16rpx;
}
.event-model {
  font-family: monospace;
}
.event-error {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--b1-destructive-fg);
}
.event-cost {
  text-align: right;
  flex: 0 0 140rpx;
}
.cost-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--b1-improved-fg);
}
.cost-tokens {
  font-size: 20rpx;
  color: var(--b1-ink-subtle);
  margin-top: 4rpx;
}
.cost-estimate {
  display: inline-block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--b1-waiting-fg);
  background: var(--b1-waiting-bg);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 空态 */
.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-title {
  font-size: 30rpx;
  color: var(--b1-ink-muted);
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: var(--b1-ink-subtle);
  line-height: 1.6;
}

/* 删除入口 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--b1-surface);
  border-top: 1rpx solid var(--b1-border);
  box-shadow: none;
}
.deletion-btn {
  text-align: center;
  padding: 24rpx;
  border: 1rpx solid var(--b1-destructive-fg);
  border-radius: 10rpx;
  background: var(--b1-destructive-bg);
  color: var(--b1-destructive-fg);
  font-size: 26rpx;
}
.deletion-btn.submitting {
  opacity: 0.6;
}
.deletion-btn.submitted {
  background: var(--b1-neutral-bg);
  border-color: var(--b1-neutral-fg);
  color: var(--b1-neutral-fg);
}

/* 第四批：emoji 符号 */
.month-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
