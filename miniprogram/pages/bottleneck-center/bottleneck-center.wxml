<view class="page">
  <view class="loading-state" wx:if="{{loading}}">
    <text>正在整理学习卡点...</text>
  </view>

  <view wx:else>
    <view class="header">
      <text class="kicker">{{studentName || '学习档案'}}</text>
      <text class="title">学习卡点中心</text>
      <text class="summary">按学科和状态查看当前需要验证、持续观察和已经改善的卡点。</text>
    </view>

    <view class="stats-grid">
      <view class="stat-card" bindtap="onStatTap" data-status="all">
        <text class="stat-value">{{stats.totalCount}}</text>
        <text class="stat-label">全部卡点</text>
      </view>
      <view class="stat-card" bindtap="onStatTap" data-status="active">
        <text class="stat-value">{{stats.activeCount}}</text>
        <text class="stat-label">待跟进</text>
      </view>
      <view class="stat-card" bindtap="onStatTap" data-status="persisting">
        <text class="stat-value">{{stats.persistingCount}}</text>
        <text class="stat-label">持续出现</text>
      </view>
      <view class="stat-card" bindtap="onStatTap" data-status="improved">
        <text class="stat-value">{{stats.improvedCount}}</text>
        <text class="stat-label">已改善</text>
      </view>
    </view>

    <scroll-view class="filter-row" scroll-x>
      <view
        class="filter-chip {{activeSubject === item.key ? 'active' : ''}}"
        wx:for="{{subjectFilters}}"
        wx:key="key"
        bindtap="onSubjectFilterTap"
        data-subject="{{item.key}}"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view class="filter-row status-row" scroll-x>
      <view
        class="filter-chip status-chip {{activeStatus === item.key ? 'active' : ''}}"
        wx:for="{{statusFilters}}"
        wx:key="key"
        bindtap="onStatusFilterTap"
        data-status="{{item.key}}"
      >{{item.name}}</view>
    </scroll-view>

    <view class="bottleneck-list" wx:if="{{filteredBottlenecks.length > 0}}">
      <view
        class="bottleneck-card bottleneck-{{item.statusClass}}"
        wx:for="{{filteredBottlenecks}}"
        wx:key="lpCode"
        bindtap="onBottleneckTap"
        data-subject="{{item.subject}}"
        data-lp-code="{{item.lpCode}}"
      >
        <view class="bottleneck-status-badge status-badge-{{item.statusClass}}">
          <text>{{item.statusBadgeText}}</text>
        </view>
        <view class="bottleneck-copy">
          <view class="title-line">
            <text class="bottleneck-name">{{item.displayName}}</text>
            <text class="subject-tag">{{item.subjectName}}</text>
          </view>
          <text class="bottleneck-desc">{{item.evidenceText}}</text>
          <text class="bottleneck-time" wx:if="{{item.timeText}}">{{item.timeText}}</text>
          <view class="chip-row">
            <text class="chip priority-{{item.priorityClass}}">{{item.priorityText}}</text>
            <text class="chip state-{{item.statusClass}}">{{item.statusText}}</text>
            <text class="chip" wx:if="{{item.weightText}}">{{item.weightText}}</text>
          </view>
        </view>
        <view
          class="card-action"
          catchtap="onGenerateForBottleneck"
          data-subject="{{item.subject}}"
          data-lp-code="{{item.lpCode}}"
        >验证</view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-title">{{emptyText}}</text>
      <text class="empty-desc">上传试卷或完成验证卷后，这里会自动更新。</text>
      <view class="refresh-btn" bindtap="onRefresh">刷新</view>
    </view>
  </view>
</view>
