.page {
  min-height: 100vh;
  background: #f4f7fa;
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.loading-state,
.empty-state {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
}

.header {
  align-items: stretch;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 18rpx 4rpx 22rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.header-illustration {
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 79, 130, .08);
  flex-shrink: 0;
  height: 390rpx;
  width: 100%;
  background: #eef7ff;
  order: -1;
}

.kicker {
  display: block;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 800;
}

.title {
  display: block;
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.25;
  margin-top: 8rpx;
}

.summary {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 10rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.stat-card {
  min-height: 96rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 47, 82, .05);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 14rpx;
}

.stat-card:active,
.bottleneck-card:active,
.card-action:active {
  opacity: 0.74;
}

.stat-value {
  color: #173f6b;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.stat-label {
  color: #64748b;
  font-size: 19rpx;
  margin-top: 5rpx;
}

.filter-row {
  white-space: nowrap;
  margin-bottom: 14rpx;
}

.status-row {
  margin-bottom: 18rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #dbe7f4;
  color: #52677d;
  font-size: 23rpx;
  font-weight: 800;
}

.filter-chip.active {
  border-color: #3b82f6;
  background: #eff6ff;
  color: #1d4ed8;
}

.bottleneck-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.bottleneck-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff;
  border-left: 8rpx solid #3b82f6;
  box-shadow: 0 8rpx 24rpx rgba(31, 79, 130, .08);
}

.bottleneck-recurring,
.bottleneck-persisting {
  border-left-color: #f97316;
}

.bottleneck-improved,
.bottleneck-declining {
  border-left-color: #22c55e;
}

.bottleneck-status-badge {
  width: 82rpx;
  min-height: 72rpx;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.18;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bottleneck-status-badge text {
  max-width: 4em;
}

.status-badge-recurring,
.status-badge-persisting {
  background: #fff7ed;
  color: #c2410c;
}

.status-badge-pending {
  background: #eff6ff;
  color: #1d4ed8;
}

.status-badge-improved,
.status-badge-declining {
  background: #dcfce7;
  color: #15803d;
}

.bottleneck-copy {
  flex: 1;
  min-width: 0;
}

.title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.bottleneck-name {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.subject-tag {
  padding: 5rpx 10rpx;
  border-radius: 9rpx;
  background: #e0f2fe;
  color: #1d4ed8;
  font-size: 18rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.bottleneck-desc,
.bottleneck-time {
  display: block;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 7rpx;
}

.bottleneck-time {
  color: #8a97a8;
  margin-top: 3rpx;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.chip {
  padding: 7rpx 10rpx;
  border-radius: 9rpx;
  background: #f1f5f9;
  color: #52677d;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
}

.priority-high {
  background: #ffedd5;
  color: #c2410c;
}

.priority-medium {
  background: #fef3c7;
  color: #92400e;
}

.priority-low {
  background: #ecfdf5;
  color: #15803d;
}

.state-recurring,
.state-persisting {
  background: #fff7ed;
  color: #c2410c;
}

.state-pending {
  background: #eff6ff;
  color: #1d4ed8;
}

.state-improved,
.state-declining {
  background: #dcfce7;
  color: #15803d;
}

.card-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}

.card-action {
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #2563eb;
  color: #fff;
  font-size: 21rpx;
  font-weight: 850;
  white-space: nowrap;
  flex-shrink: 0;
  text-align: center;
}

.card-action.learn {
  background: #fff7ed;
  color: #c2410c;
  border: 1rpx solid #fed7aa;
}

.card-action.verify {
  background: #2563eb;
  color: #fff;
}

.empty-title {
  display: block;
  color: #172033;
  font-size: 30rpx;
  font-weight: 850;
}

.empty-desc {
  display: block;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 10rpx;
}

.refresh-btn {
  margin-top: 24rpx;
  padding: 18rpx 42rpx;
  border-radius: 16rpx;
  background: #2563eb;
  color: #fff;
  font-size: 24rpx;
  font-weight: 850;
}
