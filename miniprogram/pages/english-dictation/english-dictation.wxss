.page {
  min-height: 100vh;
  background: #f7fafc;
  padding-bottom: 48rpx;
}

.hero {
  background: var(--b1-subject-english-fg);
  color: #fff;
  padding: 42rpx 28rpx 34rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  align-items: stretch;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-illustration {
  width: 100%;
  height: 390rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, .15);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .14);
  order: -1;
}

.eyebrow,
.subtitle {
  display: block;
  opacity: .86;
  font-size: 23rpx;
  line-height: 1.45;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  margin: 8rpx 0;
}

.state-card,
.dictation-wrap {
  margin: 24rpx 28rpx 0;
}

.state-card,
.progress-card,
.prompt-card,
.upload-card,
.result-card,
.ready-card,
.finished-card,
.fold-card {
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, .06);
}

.state-card {
  padding: 28rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
}

.state-card.error {
  background: #fff1f2;
  border-color: #fecdd3;
}

.state-title,
.upload-title,
.ready-title {
  display: block;
  color: #25364a;
  font-size: 30rpx;
  font-weight: 750;
}

.state-desc,
.prompt-desc,
.upload-desc,
.voice-hint,
.upload-status,
.ready-desc,
.command-hint {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.dictation-wrap {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.progress-card {
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-label {
  color: #64748b;
  font-size: 24rpx;
}

.progress-value {
  color: var(--b1-subject-english-fg);
  font-size: 30rpx;
  font-weight: 800;
}

.prompt-card,
.upload-card,
.result-card,
.ready-card,
.finished-card,
.fold-card {
  padding: 30rpx;
}

.ready-title {
  font-size: 32rpx;
  font-weight: 800;
}

.voice-start-btn {
  margin-top: 16rpx;
}

.prompt-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.prompt-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #fff7ed;
  color: var(--b1-subject-english-fg);
}

.state-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 750;
  background: #e2e8f0;
  color: #475569;
}

.state-speaking {
  background: #dbeafe;
  color: #1d4ed8;
}

.state-writing {
  background: #fef3c7;
  color: #b45309;
}

.state-waitingCommand {
  background: #dcfce7;
  color: #15803d;
}

.state-idle {
  background: #e2e8f0;
  color: #475569;
}

.prompt-title {
  display: block;
  color: #1f2937;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.play-btn {
  margin-top: 24rpx;
  border: 2rpx solid var(--b1-subject-english-fg);
  background: #fff;
  color: var(--b1-subject-english-fg);
  border-radius: 14rpx;
}

.nav-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1.2fr;
  gap: 18rpx;
}

.secondary-btn {
  border-radius: 16rpx;
  border: 2rpx solid #cbd5e1;
  color: #25364a;
  background: #fff;
  font-weight: 700;
}

.voice-next-btn {
  border-color: #fed7aa;
  color: var(--b1-subject-english-fg);
  background: #fff7ed;
}

.primary-btn {
  margin-top: 22rpx;
  background: var(--b1-subject-english-fg);
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.fold-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.fold-title {
  color: #25364a;
  font-size: 28rpx;
  font-weight: 800;
}

.fold-action {
  color: var(--b1-subject-english-fg);
  font-size: 24rpx;
  font-weight: 750;
}

.word-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.word-list.compact {
  margin-top: 18rpx;
  max-height: 520rpx;
  overflow: auto;
}

.word-row {
  display: grid;
  grid-template-columns: 48rpx 1fr auto;
  gap: 14rpx;
  align-items: center;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.word-order {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 999rpx;
  text-align: center;
  background: #fff7ed;
  color: var(--b1-subject-english-fg);
  font-weight: 800;
  font-size: 22rpx;
}

.word-main {
  min-width: 0;
}

.word-en {
  display: block;
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 800;
  word-break: break-all;
}

.word-cn,
.word-meta {
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.4;
}

.result-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.result-summary-item {
  text-align: center;
}

.summary-num {
  display: block;
  color: var(--b1-subject-english-fg);
  font-size: 30rpx;
  font-weight: 800;
}

.summary-label {
  display: block;
  color: #64748b;
  font-size: 21rpx;
  margin-top: 2rpx;
}

.result-row {
  margin-top: 18rpx;
  padding: 18rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e2e8f0;
}

.result-row:last-child {
  border-bottom: 0;
}

.result-word {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 750;
}

.result-verdict {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 750;
  background: #e2e8f0;
  color: #475569;
}

.verdict-correct {
  background: #dcfce7;
  color: #15803d;
}

.verdict-incorrect {
  background: #ffedd5;
  color: #c2410c;
}

.verdict-unclear {
  background: #e2e8f0;
  color: #475569;
}

/* English B1 uses an indigo learning surface; red is kept for error states. */
.page { background: #f7f8ff; }
.hero, .primary-btn { background: #4f46e5; }
.state-card { background: #eef2ff; border-color: #c7d2fe; }
.state-card.error { background: #fff1f2; border-color: #fecdd3; }
.progress-value, .prompt-pill, .voice-next-btn, .fold-action, .word-order, .summary-num { color: #4338ca; }
.prompt-pill, .voice-next-btn, .word-order { background: #eef2ff; border-color: #c7d2fe; }
.state-speaking { background: #e0e7ff; color: #4338ca; }
.state-writing { background: #fff7e6; color: #9a6700; }
.state-waitingCommand { background: #fff7e6; color: #9a6700; }
.voice-next-btn { border-color: #c7d2fe; }
.result-verdict.verdict-incorrect { background: #fff7e6; color: #9a6700; }

/* 第四批：emoji 符号 */
.hero-symbol, .title-symbol, .eyebrow-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
.finish-mark.b1-symbol { font-size: 64rpx; }
