<view class="page bplus-page">
  <view class="hero bplus-section">
    <view class="hero-copy">
      <text class="eyebrow">{{studentName || '钟青羽'}} · 英语</text>
      <text class="title">纸面听写</text>
      <text class="subtitle">看提示在纸上写英文，完成后拍照上传识别。</text>
    </view>
  </view>

  <view class="state-card" wx:if="{{loading}}">
    <text class="state-title">正在准备听写词</text>
    <text class="state-desc">优先抽取拼写薄弱、待复测和未听写的单词。</text>
  </view>

  <view class="state-card error" wx:elif="{{error}}">
    <text class="state-title">暂时无法继续</text>
    <text class="state-desc">{{error}}</text>
  </view>

  <view wx:else class="dictation-wrap">
    <view class="ready-card" wx:if="{{dictationPhase === 'ready'}}">
      <text class="ready-title">本轮词单</text>
      <text class="ready-desc">共 {{queue.length}} 个词。准备一张纸，按题号一行一个词写英文。</text>
      <button class="primary-btn" bindtap="onStartTap">开始听写</button>
      <button class="secondary-btn voice-start-btn" bindtap="onVoiceNextTap">{{recordingCommand ? '停止语音' : '语音开始'}}</button>
      <text class="voice-hint" wx:if="{{voiceUnavailableText}}">{{voiceUnavailableText}}</text>
      <text class="command-hint">{{commandHint}}</text>
      <view class="word-list">
        <view class="word-row" wx:for="{{queue}}" wx:key="queueKey">
          <text class="word-order">{{index + 1}}</text>
          <view class="word-main">
            <text class="word-en">{{item.word}}</text>
            <text class="word-cn">{{item.meaningText}}</text>
          </view>
          <text class="word-meta">{{item.unit || '未分单元'}}</text>
        </view>
      </view>
    </view>

    <block wx:elif="{{dictationPhase === 'running' || dictationPhase === 'paused'}}">
      <view class="progress-card">
        <text class="progress-label">纸面听写进行中</text>
        <text class="progress-value">第 {{currentIndex + 1}} / {{queue.length}} 题</text>
      </view>

      <view class="prompt-card">
        <view class="prompt-top">
          <text class="prompt-pill">{{currentItem.promptTypeText}}</text>
          <text class="state-pill state-{{playbackState}}">{{playbackStateText}}</text>
        </view>
        <text class="prompt-title" wx:if="{{currentItem.promptType === 'chinese'}}">{{currentItem.meaningText}}</text>
        <text class="prompt-title" wx:else>请听英文发音，并在纸上写出这个单词</text>
        <text class="prompt-desc">{{paperInstruction}}</text>
        <text class="command-hint">{{commandHint}}</text>
        <text class="voice-hint" wx:if="{{voiceUnavailableText}}">{{voiceUnavailableText}}</text>
      </view>

      <view class="nav-row">
        <button class="secondary-btn" bindtap="onPlayPromptTap">重读</button>
        <button class="secondary-btn" bindtap="onNextTap">下一个</button>
        <button class="secondary-btn voice-next-btn" bindtap="onVoiceNextTap">{{recordingCommand ? '停止语音' : '说“好了”'}}</button>
      </view>

      <view class="fold-card">
        <view class="fold-header" bindtap="onToggleWordList">
          <text class="fold-title">本轮词单</text>
          <text class="fold-action">{{wordListExpanded ? '收起' : '展开给家长看'}}</text>
        </view>
        <view class="word-list compact" wx:if="{{wordListExpanded}}">
          <view class="word-row" wx:for="{{queue}}" wx:key="queueKey">
            <text class="word-order">{{index + 1}}</text>
            <view class="word-main">
              <text class="word-en">{{item.word}}</text>
              <text class="word-cn">{{item.meaningText}}</text>
            </view>
            <text class="word-meta">{{item.unit || '未分单元'}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="finished-card" wx:elif="{{dictationPhase === 'finished' || dictationPhase === 'reviewed'}}">
      <text class="ready-title">本轮听写已完成</text>
      <text class="ready-desc">{{queue.length}} 个词已经报完，请拍照上传听写纸。</text>
      <text class="prompt-desc">{{paperInstruction}}</text>
    </view>

    <view class="upload-card" wx:if="{{dictationPhase === 'finished' || dictationPhase === 'reviewed' || uploadedPhotoCount > 0}}">
      <text class="upload-title">完成后上传听写纸</text>
      <text class="upload-desc">上传后会进行 AI 批改，并把逐词拼写结果写入本次听写记录。</text>
      <button class="primary-btn" loading="{{uploading}}" bindtap="onChoosePhotoTap">拍照上传</button>
      <text class="upload-progress" wx:if="{{uploadProgress}}">{{uploadProgress}}</text>
      <text class="upload-status" wx:if="{{uploadedPhotoCount > 0}}">
        <block wx:if="{{analysisStatus === 'completed'}}">已批改</block>
        <block wx:elif="{{analysisStatus}}">批改中</block>
        <block wx:else>已上传</block>
        · {{uploadedPhotoCount}} 张听写纸
      </text>
    </view>

    <view class="result-card" wx:if="{{dictationResults.length > 0}}">
      <text class="upload-title">AI 批改结果</text>
      <view class="result-summary" wx:if="{{resultSummary}}">
        <view class="result-summary-item">
          <text class="summary-num">{{resultSummary.correct}}</text>
          <text class="summary-label">写对</text>
        </view>
        <view class="result-summary-item">
          <text class="summary-num">{{resultSummary.incorrect}}</text>
          <text class="summary-label">待加强</text>
        </view>
        <view class="result-summary-item">
          <text class="summary-num">{{resultSummary.unclear}}</text>
          <text class="summary-label">看不清</text>
        </view>
      </view>
      <view class="result-row" wx:for="{{dictationResults}}" wx:key="wordId">
        <text class="result-word">{{item.targetWord}}</text>
        <text class="result-verdict verdict-{{item.verdict}}">
          <block wx:if="{{item.verdict === 'correct'}}">写对</block>
          <block wx:elif="{{item.verdict === 'incorrect'}}">待加强</block>
          <block wx:else>看不清</block>
        </text>
      </view>
    </view>
  </view>
</view>
