<view class="page b1-page">
  <view class="state-card" wx:if="{{loading}}">
    <text class="state-title">正在准备认词练习</text>
    <text class="state-desc">优先抽取薄弱词、待复测词和未测词。</text>
  </view>

  <view class="state-card error" wx:elif="{{error}}">
    <text class="state-title">{{errorTitle || '生成失败'}}</text>
    <text class="state-desc">{{error}}</text>
    <button class="retry-btn" bindtap="onRegenerateTap">重新生成</button>
  </view>

  <view wx:elif="{{finished}}" class="finish-card">
    <text class="finish-mark">OK</text>
    <text class="finish-title">本轮认词练习完成</text>
    <text class="finish-desc">不熟悉和听不清的单词已经记录，后续会提高出现频率。</text>
    <button class="primary-btn" bindtap="onFinishTap">完成并返回</button>
  </view>

  <view wx:else class="practice-shell">
    <view class="practice-topbar">
      <view class="practice-title-wrap">
        <text class="practice-kicker">{{studentName || '钟青羽'}} · 英语</text>
        <text class="practice-title">认词练习</text>
      </view>
      <view class="progress-pill">
        <text class="progress-now">{{currentIndex + 1}}</text>
        <text class="progress-total">/ {{queue.length}}</text>
      </view>
    </view>

    <view class="progress-track">
      <view class="progress-fill" style="width: {{progressPercent}}%;"></view>
    </view>

    <view class="word-stage-card">
      <view class="prompt-tag-row">
        <text class="prompt-tag">{{currentItem.promptModeText}}</text>
        <text class="retry-tag" wx:if="{{currentItem.retryCount > 0}}">再次出现</text>
      </view>
      <text class="primary-prompt">{{currentItem.promptMainText}}</text>
      <text class="answer-instruction">{{currentItem.answerInstruction}}</text>
      <text class="answer-hint">{{currentItem.answerHintText}}</text>
      <button class="play-chip" wx:if="{{currentItem.canPlayPrompt}}" bindtap="onPlayPromptTap">播放发音</button>
    </view>

    <view class="voice-dock">
      <button class="mic-orb {{recording ? 'recording' : ''}} {{recognizing || submitting ? 'busy' : ''}}" loading="{{submitting}}" disabled="{{submitting || recognizing}}" bindtap="onRecordTap">
        <text class="mic-dot"></text>
        <text class="mic-label">{{recordButtonText}}</text>
      </button>
      <text class="voice-hint" wx:if="{{voiceUnavailableText}}">{{voiceUnavailableText}}</text>
      <text class="voice-hint" wx:else>{{recording ? '回答完后再点一次，系统会开始识别。' : (recognizing ? '正在识别刚才的回答，请稍等。' : (submitting ? '正在判断回答是否正确。' : '准备好后点击按钮回答。'))}}</text>
    </view>

    <view class="result-sheet result-{{lastResult.status}}" wx:if="{{lastResult}}">
      <text class="result-title">
        <block wx:if="{{lastResult.status === 'correct'}}">已经熟悉</block>
        <block wx:elif="{{lastResult.status === 'incorrect'}}">稍后再见一次</block>
        <block wx:else>刚才没听清</block>
      </text>
      <text class="result-desc">{{lastResult.reason}}</text>
      <text class="answer-line">目标单词：{{lastAnsweredItem ? lastAnsweredItem.word : ''}}</text>
      <text class="result-hint" wx:if="{{lastResult.shouldRepeat}}">本题稍后会在本轮末尾再次出现</text>
    </view>
  </view>
</view>
