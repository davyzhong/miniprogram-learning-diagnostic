<view class="page">
  <view class="hero">
    <view class="hero-copy">
      <text class="eyebrow">{{studentName || '钟青羽'}} · 英语</text>
      <text class="title">认词练习</text>
      <text class="subtitle">看中文或英文提示，录音说出对应内容。</text>
    </view>
    <image class="hero-illustration" src="/assets/images/english-practice-hero.jpg" mode="aspectFill"></image>
  </view>

  <view class="state-card" wx:if="{{loading}}">
      <text class="state-title">正在准备认词练习</text>
    <text class="state-desc">优先抽取薄弱词、待复测词和未测词。</text>
  </view>

  <view class="state-card error" wx:elif="{{error}}">
    <text class="state-title">{{errorTitle || '生成失败'}}</text>
    <text class="state-desc">{{error}}</text>
    <button class="retry-btn" bindtap="onRegenerateTap">重新生成</button>
  </view>

  <view wx:elif="{{finished}}" class="finish-card">
    <text class="finish-mark">✓</text>
      <text class="finish-title">本轮认词练习完成</text>
    <text class="finish-desc">不熟悉和听不清的单词已经记录，后续会提高出现频率。</text>
    <button class="primary-btn" bindtap="onFinishTap">完成并返回</button>
  </view>

  <view wx:else class="dictation-wrap">
    <view class="progress-card">
      <text class="progress-label">当前进度</text>
      <text class="progress-value">{{currentIndex + 1}} / {{queue.length}}</text>
    </view>

    <view class="prompt-card">
      <view class="prompt-top">
      <text class="prompt-pill">{{currentItem.promptTypeText}}</text>
      <text class="retry-pill" wx:if="{{currentItem.retryCount > 0}}">第 {{currentItem.retryCount + 1}} 次出现</text>
    </view>
    <text class="prompt-title">{{currentItem.promptText}}</text>
      <text class="prompt-desc">看清提示后，点击录音按钮说出对应的英文单词或中文意思。系统会把不熟的词安排稍后再出现。</text>
      <button class="play-btn" wx:if="{{currentItem.canPlayPrompt}}" bindtap="onPlayPromptTap">辅助播放提示</button>
    </view>

    <view class="voice-card">
      <button class="record-btn {{recording ? 'recording' : ''}}" loading="{{submitting}}" disabled="{{submitting || recognizing}}" bindtap="onRecordTap">
        {{recordButtonText}}
      </button>
      <text class="voice-hint" wx:if="{{voiceUnavailableText}}">{{voiceUnavailableText}}</text>
      <text class="voice-hint" wx:else>{{recording ? '正在录音，回答完后再次点击识别。' : (recognizing ? '正在识别刚才的回答，请稍等。' : '准备好后点击按钮开始录音。')}}</text>
    </view>

    <view class="result-card result-{{lastResult.status}}" wx:if="{{lastResult}}">
      <text class="result-title">
        <block wx:if="{{lastResult.status === 'correct'}}">这个词已经比较熟了</block>
        <block wx:elif="{{lastResult.status === 'incorrect'}}">这个词还需要再见几次</block>
        <block wx:else>刚才没听清，再试一次</block>
      </text>
      <text class="result-desc">{{lastResult.reason}}</text>
      <text class="answer-line">目标单词：{{lastAnsweredItem ? lastAnsweredItem.word : ''}}</text>
      <text class="result-hint" wx:if="{{lastResult.shouldRepeat}}">本题稍后会在本轮末尾再次出现</text>
    </view>
  </view>
</view>
