.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff7ed 0%, #f5f8fc 34%, #eef4f8 100%);
  padding: 28rpx 28rpx 56rpx;
  box-sizing: border-box;
}

.practice-shell {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.practice-topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 2rpx 0;
}

.practice-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.practice-kicker {
  color: #8a4b22;
  font-size: 24rpx;
  font-weight: 700;
}

.practice-title {
  color: #162033;
  font-size: 46rpx;
  font-weight: 850;
  line-height: 1.14;
}

.progress-pill {
  min-width: 112rpx;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #f1d4bd;
  box-shadow: 0 8rpx 24rpx rgba(130, 75, 33, .08);
  text-align: center;
  white-space: nowrap;
}

.progress-now {
  color: var(--b1-subject-english-fg);
  font-size: 34rpx;
  font-weight: 850;
}

.progress-total {
  color: #8aa0b8;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(156, 79, 36, .13);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #d97706, #2f8f83);
  transition: width .22s ease;
}

.state-card,
.finish-card,
.word-stage-card,
.voice-dock,
.result-sheet {
  background: rgba(255, 255, 255, .96);
  border: 1rpx solid rgba(203, 213, 225, .82);
  border-radius: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, .07);
}

.state-card,
.finish-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.state-card {
  background: #fff7ed;
  border-color: #fed7aa;
}

.state-card.error {
  background: #fff1f2;
  border-color: #fecdd3;
}

.state-title,
.finish-title,
.result-title {
  display: block;
  color: #1f2937;
  font-size: 31rpx;
  font-weight: 800;
}

.state-desc,
.finish-desc,
.result-desc,
.voice-hint,
.answer-hint {
  display: block;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.state-desc,
.finish-desc,
.result-desc,
.voice-hint {
  margin-top: 10rpx;
}

.retry-btn,
.primary-btn {
  margin-top: 22rpx;
  background: var(--b1-subject-english-fg);
  color: #fff;
  border-radius: 14rpx;
}

.word-stage-card {
  min-height: 480rpx;
  padding: 36rpx 34rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.prompt-tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.prompt-tag,
.retry-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.prompt-tag {
  background: #fff7ed;
  color: var(--b1-subject-english-fg);
}

.retry-tag {
  background: #e0f2fe;
  color: #0369a1;
}

.primary-prompt {
  display: block;
  color: #111827;
  font-size: 58rpx;
  font-weight: 850;
  line-height: 1.22;
  word-break: break-word;
}

.answer-instruction {
  display: block;
  margin-top: 28rpx;
  color: #2f8f83;
  font-size: 34rpx;
  font-weight: 850;
}

.answer-hint {
  margin-top: 12rpx;
}

.play-chip {
  align-self: flex-start;
  margin: 26rpx 0 0;
  padding: 0 24rpx;
  min-width: 0;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  border: 1rpx solid #bfdbfe;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 750;
}

.voice-dock {
  padding: 30rpx 28rpx;
  text-align: center;
}

.mic-orb {
  width: 260rpx;
  min-width: 260rpx;
  max-width: 260rpx;
  height: 260rpx;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 130rpx;
  background: #2563eb;
  color: #fff;
  box-shadow: 0 20rpx 36rpx rgba(37, 99, 235, .24);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.2;
}

.mic-orb.recording {
  background: #c2410c;
  box-shadow: 0 20rpx 36rpx rgba(194, 65, 12, .24);
}

.mic-orb.busy {
  background: #64748b;
  box-shadow: none;
}

.mic-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  opacity: .95;
}

.mic-orb.recording .mic-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
}

.mic-label {
  max-width: 184rpx;
  text-align: center;
}

.result-sheet {
  padding: 28rpx 30rpx;
  border-left: 8rpx solid #94a3b8;
}

.result-correct {
  border-left-color: #2f8f83;
  background: #f0fdf4;
}

.result-incorrect {
  border-left-color: #d97706;
  background: #fff7ed;
}

.result-unclear {
  border-left-color: #64748b;
  background: #f8fafc;
}

.answer-line,
.result-hint {
  display: block;
  margin-top: 14rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 750;
}

.result-hint {
  color: var(--b1-subject-english-fg);
}

.finish-card {
  text-align: center;
}

.finish-mark {
  display: block;
  width: 78rpx;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0 auto 18rpx;
  border-radius: 24rpx;
  background: #dcfce7;
  color: #15803d;
  font-size: 30rpx;
  font-weight: 850;
}

/* English B1: indigo is reserved for the learning flow; green marks completion. */
.page { background: linear-gradient(180deg, #f5f7ff 0%, #eef2ff 34%, #f8fafc 100%); }
.practice-kicker, .progress-now, .prompt-tag, .result-hint { color: #4338ca; }
.progress-pill { border-color: #c7d2fe; box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, .10); }
.progress-track { background: rgba(79, 70, 229, .14); }
.progress-fill, .retry-btn, .primary-btn { background: #4f46e5; }
.state-card { background: #eef2ff; border-color: #c7d2fe; }
.state-card.error { background: #fff1f2; border-color: #fecdd3; }
.prompt-tag { background: #eef2ff; }
.retry-tag { background: #e0e7ff; color: #4338ca; }
.answer-instruction { color: #4338ca; }
.play-chip { border-color: #c7d2fe; background: #eef2ff; color: #4338ca; }
.mic-orb { background: #4f46e5; box-shadow: 0 20rpx 36rpx rgba(79, 70, 229, .24); }
.mic-orb.recording { background: #4f46e5; box-shadow: 0 20rpx 36rpx rgba(79, 70, 229, .30); }
.result-incorrect { border-left-color: #9a6700; background: #fff7e6; }

/* 第四批：emoji 符号 */
.hero-symbol, .title-symbol, .eyebrow-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
.finish-mark.b1-symbol { font-size: 64rpx; }
