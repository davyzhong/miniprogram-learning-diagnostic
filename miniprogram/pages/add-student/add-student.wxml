<!--pages/add-student/add-student.wxml-->
<view class="page b1-page">
  <view class="setup-hero">
    <view class="setup-copy">
      <text class="setup-title">添加孩子档案</text>
      <text class="setup-desc">先建立学生、年级和头像颜色，后面就可以按学科整理诊断、卡点和验证卷。</text>
    </view>
  </view>

  <view class="form b1-card form-card">
    <!-- 姓名 -->
    <view class="form-item">
      <text class="label">学生姓名</text>
      <input
        class="input form-input"
        placeholder="请输入学生姓名"
        value="{{name}}"
        bindinput="onNameInput"
        maxlength="10"
      />
    </view>

    <!-- 年级 -->
    <view class="form-item">
      <text class="label">年级</text>
      <view class="grade-options">
        <view
          class="grade-btn {{grade === item ? 'active' : ''}}"
          wx:for="{{grades}}"
          wx:key="*this"
          data-grade="{{item}}"
          bindtap="onGradeTap"
        >
          {{item}}年级
        </view>
      </view>
    </view>

    <!-- 头像颜色预览 -->
    <view class="form-item">
      <text class="label">头像颜色</text>
      <view class="color-options">
        <view
          class="color-dot {{avatarColor === item ? 'active' : ''}}"
          wx:for="{{colorOptions}}"
          wx:key="*this"
          style="background:{{item}};"
          data-color="{{item}}"
          bindtap="onColorTap"
        >
          <text wx:if="{{avatarColor === item}}" class="check">已选</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="bottom-bar">
    <button class="b1-button-primary form-primary btn-save" bindtap="onSave" disabled="{{!canSave || saving}}">
      {{saving ? '保存中...' : '保存'}}
    </button>
  </view>
</view>
