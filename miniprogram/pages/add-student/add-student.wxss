/* pages/add-student/add-student.wxss */

.page {
  min-height: 100vh;
  background: var(--b1-canvas);
  padding-bottom: 160rpx;
}

.setup-hero {
  align-items: center;
  background: var(--b1-canvas);
  border-bottom: 1rpx solid var(--b1-border);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx 28rpx;
}

.setup-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.setup-title {
  color: var(--b1-ink-strong);
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.setup-desc {
  color: var(--b1-ink-muted);
  display: block;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.setup-illustration {
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(43, 108, 176, .10);
  flex-shrink: 0;
  height: 390rpx;
  width: 100%;
  background: rgba(255, 255, 255, .6);
  order: -1;
}

/* ========== 表单 ========== */
.form {
  margin: 20rpx 28rpx;
  padding: 18rpx;
}

.form-item {
  margin-bottom: 16rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--b1-ink-muted);
  margin-bottom: 12rpx;
}

.input {
  background: var(--b1-surface);
  border: 2rpx solid var(--b1-border);
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  color: var(--b1-ink);
}

.input:focus {
  border-color: var(--b1-improved-fg);
}

/* ========== 年级选择 ========== */
.grade-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grade-btn {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: var(--b1-neutral-bg);
  color: var(--b1-ink-muted);
  font-weight: 500;
}

.grade-btn.active {
  background: var(--b1-improved-bg);
  color: var(--b1-improved-fg);
  font-weight: 600;
}

/* ========== 颜色选择 ========== */
.color-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.color-dot.active {
  border-color: var(--b1-improved-fg);
  transform: scale(1.1);
}

.color-dot .check {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

/* ========== 底部按钮 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--b1-surface);
  border-top: 1rpx solid var(--b1-border);
  box-shadow: none;
  z-index: 100;
}

.form-primary.btn-save {
  background: var(--b1-improved-fg);
  color: var(--b1-surface);
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 0 24rpx;
  border: none;
  width: 100%;
  line-height: 88rpx;
}

.btn-save::after { border: none; }

.btn-save[disabled] {
  background: var(--b1-neutral-bg);
  color: var(--b1-ink-subtle);
}

/* 第四批：emoji 符号（setup-deco 内联进标题行，≤64rpx） */
.setup-deco { font-size: 40rpx; line-height: 1; }
.eyebrow-symbol, .section-symbol { font-size: 28rpx; margin-right: 6rpx; }
.state-icon.b1-symbol { font-size: 56rpx; }
