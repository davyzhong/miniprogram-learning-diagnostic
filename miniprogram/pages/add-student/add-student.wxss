/* pages/add-student/add-student.wxss */

.page {
  min-height: 100vh;
  background: #f7fafc;
  padding-bottom: 160rpx;
}

.setup-hero {
  align-items: center;
  background: linear-gradient(135deg, #ffffff 0%, #eaf4ff 100%);
  border-bottom: 1rpx solid #dbe8f4;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
}

.setup-copy {
  flex: 1;
  min-width: 0;
}

.setup-title {
  color: #17365d;
  display: block;
  font-size: 36rpx;
  font-weight: 850;
}

.setup-desc {
  color: #53657a;
  display: block;
  font-size: 23rpx;
  line-height: 1.5;
  margin-top: 8rpx;
}

.setup-illustration {
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(43, 108, 176, .10);
  flex-shrink: 0;
  height: 390rpx;
  width: 100%;
  background: rgba(255, 255, 255, .6);
  order: -1;
}

/* ========== 表单 ========== */
.form {
  padding: 32rpx 28rpx;
}

.form-item {
  margin-bottom: 36rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #4a5568;
  margin-bottom: 16rpx;
}

.input {
  background: #ffffff;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #1a202c;
}

.input:focus {
  border-color: #2b6cb0;
}

/* ========== 年级选择 ========== */
.grade-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.grade-btn {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  background: #edf2f7;
  color: #4a5568;
  font-weight: 500;
}

.grade-btn.active {
  background: #2b6cb0;
  color: #ffffff;
  font-weight: 600;
}

/* ========== 颜色选择 ========== */
.color-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.color-dot.active {
  border-color: #1a202c;
  transform: scale(1.1);
}

.color-dot .check {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

/* ========== 底部按钮 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-save {
  background: linear-gradient(135deg, #2b6cb0 0%, #3182ce 100%);
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
  width: 100%;
  line-height: 1.4;
}

.btn-save::after { border: none; }

.btn-save[disabled] {
  background: #a0aec0;
  color: #ffffff;
}
