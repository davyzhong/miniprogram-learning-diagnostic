.page {
  min-height: 100vh;
  padding: 28rpx;
  background: var(--b1-canvas);
  color: var(--b1-ink);
}

.header {
  align-items: stretch;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 12rpx 0 16rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.header-illustration {
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(26, 54, 93, .08);
  flex-shrink: 0;
  height: 390rpx;
  width: 100%;
  background: #eef7ff;
  order: -1;
}

.eyebrow {
  color: var(--b1-improved-fg);
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.subtitle,
.hint,
.member-role,
.empty {
  color: var(--b1-ink-muted);
  font-size: 26rpx;
}

.notice,
.error,
.card {
  border-radius: 16rpx;
  background: var(--b1-surface);
  box-shadow: none;
}

.notice {
  padding: 22rpx 24rpx;
  color: var(--b1-neutral-fg);
  background: var(--b1-neutral-bg);
}

.error {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  color: var(--b1-destructive-fg);
  background: var(--b1-destructive-bg);
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.member {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--b1-border);
}

.member:last-child {
  border-bottom: 0;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 10rpx;
  background: var(--b1-improved-bg);
  color: var(--b1-improved-fg);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.member-main {
  margin-left: 20rpx;
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  font-weight: 700;
}

.member-edit {
  margin-left: 16rpx;
  padding: 0 18rpx;
  height: 56rpx;
  min-height: 56rpx;
  border-radius: 8rpx;
  background: var(--b1-surface);
  color: var(--b1-ink);
  border: 1rpx solid var(--b1-border);
  font-size: 24rpx;
  line-height: 56rpx;
}

.member-edit::after {
  border: none;
}

.management-primary {
  margin-top: 28rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: var(--b1-improved-fg);
  color: var(--b1-surface);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 96rpx;
}

.b1-button-secondary.inline-btn {
  margin-top: 28rpx;
  height: 96rpx;
  border-radius: 10rpx;
  background: var(--b1-surface);
  color: var(--b1-ink);
  border: 2rpx solid var(--b1-border);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.management-primary::after,
.b1-button-secondary.inline-btn::after {
  border: none;
}

.invite-path {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--b1-neutral-bg);
  color: var(--b1-ink-muted);
  font-size: 24rpx;
  word-break: break-all;
}

.invite-code {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: var(--b1-improved-bg);
  color: var(--b1-improved-fg);
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  letter-spacing: 6rpx;
}

.form-row {
  margin-top: 24rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: var(--b1-ink-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.text-input,
.picker-value {
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f7fafc;
  color: #1a202c;
  font-size: 28rpx;
  line-height: 72rpx;
}

.inline-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.inline-btn {
  flex: 1;
  margin-top: 0;
}

.hint {
  margin-top: 16rpx;
}
