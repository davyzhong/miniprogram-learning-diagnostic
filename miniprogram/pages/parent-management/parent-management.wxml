<view class="page b1-page">
  <view class="header">
    <view class="header-copy">
      <view class="eyebrow"><text class="b1-symbol eyebrow-symbol">{{parentSymbol}}</text>家庭成员</view>
      <view class="title">{{student.name || '孩子档案'}}</view>
      <view class="subtitle" wx:if="{{student.grade}}">{{student.grade}} 年级 · {{role === 'owner' ? '创建者' : '共同家长'}}</view>
    </view>
  </view>

  <view class="notice b1-neutral" wx:if="{{role === 'viewer'}}">你可以参与孩子的学习诊断，查看资料、上传试卷和下载纸面验证卷；家庭成员管理由创建者操作。</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>

  <view class="card b1-card">
    <view class="section-title"><text class="b1-symbol section-symbol">{{parentSymbol}}</text>已加入家长</view>
    <view class="member" wx:for="{{members}}" wx:key="memberOpenId" wx:for-index="index">
      <view class="avatar">{{item.avatarText}}</view>
      <view class="member-main">
        <view class="member-name">{{item.displayText}}</view>
        <view class="member-role">{{item.relationText}} · {{item.roleText}}</view>
      </view>
      <button wx:if="{{canInvite}}" class="b1-button-secondary member-edit" size="mini" data-index="{{index}}" bindtap="onEditMember">编辑</button>
      <button wx:if="{{canInvite && item.role !== 'owner'}}" class="b1-button-secondary member-edit" size="mini" data-index="{{index}}" bindtap="onRemoveMember">移除</button>
    </view>
    <view class="empty" wx:if="{{!loading && members.length === 0}}">暂无家长成员</view>
  </view>

  <view class="card b1-card edit-card" wx:if="{{editingMemberIndex >= 0}}">
    <view class="section-title"><text class="b1-symbol section-symbol">{{editSymbol}}</text>编辑家长信息</view>
    <view class="form-row">
      <view class="form-label">显示名称</view>
      <input class="text-input" value="{{editingDisplayName}}" placeholder="例如：青羽妈妈" bindinput="onDisplayNameInput" />
    </view>
    <view class="form-row">
      <view class="form-label">身份</view>
      <picker mode="selector" range="{{relationOptions}}" range-key="name" value="{{editingRelationIndex}}" bindchange="onRelationChange">
        <view class="picker-value">{{relationOptions[editingRelationIndex].name}}</view>
      </picker>
    </view>
    <view class="inline-actions">
      <button class="b1-button-secondary inline-btn" bindtap="onCancelEditMember">取消</button>
      <button class="b1-button-primary management-primary inline-btn" loading="{{saving}}" bindtap="onSaveMemberProfile">保存</button>
    </view>
  </view>

  <view class="card b1-card invite-setup" wx:if="{{canInvite}}">
    <view class="section-title"><text class="b1-symbol section-symbol">{{inviteSymbol}}</text>邀请家长</view>
    <view class="form-row">
      <view class="form-label">邀请身份</view>
      <picker mode="selector" range="{{relationOptions}}" range-key="name" value="{{inviteRelationIndex}}" bindchange="onInviteRelationChange">
        <view class="picker-value">{{relationOptions[inviteRelationIndex].name}}</view>
      </picker>
    </view>
    <button wx:if="{{canInvite}}" class="b1-button-primary management-primary" loading="{{creating}}" bindtap="onCreateInvite">生成邀请</button>
  </view>

  <view class="card b1-card invite-card" wx:if="{{invite}}">
    <view class="section-title"><text class="b1-symbol section-symbol">{{inviteSymbol}}</text>邀请已生成</view>
    <view class="invite-code" wx:if="{{invite.inviteCode}}">{{invite.inviteCode}}</view>
    <view class="hint" wx:if="{{invite.presetRelationText}}">建议身份：{{invite.presetRelationText}}</view>
    <view class="invite-path">{{invite.path}}</view>
    <view class="hint">把这个路径转发给另一位家长，或让对方在小程序里输入邀请码加入。</view>
  </view>
</view>
