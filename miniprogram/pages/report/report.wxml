<!--pages/report/report.wxml-->
<view class="page">
  <view class="report-header {{isVerification ? 'header-verify' : 'header-diagnosis'}}">
    <view class="report-header-inner">
      <view class="report-header-copy">
        <text class="report-type">{{isVerification ? '验证报告' : '诊断报告'}}</text>
        <text class="report-date">{{dateText}}</text>
        <text class="report-date traceable-text" wx:if="{{evidenceTimeText}}" bindtap="onTraceableUrlTap" data-url="{{evidenceTimeUrl}}">证据时间：{{evidenceTimeText}}</text>
        <text class="paper-code-chip" wx:if="{{paperCodeText}}" bindtap="onTraceableUrlTap" data-url="{{paperCodeUrl}}">验证卷 {{paperCodeText}}</text>
        <text class="report-headline">{{headline}}</text>
        <text class="report-summary" wx:if="{{trendSummaryText}}">{{trendSummaryText}}</text>
        <text class="report-summary" wx:if="{{reportSummaryText}}">{{reportSummaryText}}</text>
        <view class="quality-chip quality-chip-{{qualityClass}}" wx:if="{{hasQuality}}">{{qualityLabel}}</view>
      </view>
    </view>
  </view>

  <view class="status-card" wx:if="{{report.status === 'analyzing'}}">
    <view class="state-icon">···</view>
    <view class="status-copy">
      <text class="status-title">{{analysisStatusText || '正在整理试卷中的学习线索'}}</text>
      <text class="status-desc">完成后将自动刷新，历史综合诊断不会受到影响。</text>
      <view class="progress-bar" wx:if="{{hasAnalysisProgress}}">
        <view class="progress-fill" style="width: {{analysisProgress || 0}}%;"></view>
      </view>
      <button class="retry-analysis-btn" wx:if="{{analysisTaskMissing && canRetryAnalysis}}" bindtap="onRetryAnalysis" disabled="{{retryingAnalysis}}">{{retryingAnalysis ? '正在重新启动...' : '重新分析'}}</button>
    </view>
  </view>

  <view class="content" wx:if="{{report.status !== 'analyzing'}}">
    <view class="card conclusion-card">
      <view class="section-heading"><view class="heading-icon">◎</view><text>本次诊断结论</text></view>
      <text class="conclusion-text">{{headline}}</text>
      <view class="explanation-box">
        <text class="explanation-title">{{explanationTitle}}</text>
        <view class="explanation-row">
          <text class="explanation-label">结论</text>
          <text class="explanation-value">{{explanationConclusion}}</text>
        </view>
        <view class="explanation-row">
          <text class="explanation-label">依据</text>
          <text class="explanation-value">{{explanationEvidence}}</text>
        </view>
        <view class="explanation-row">
          <text class="explanation-label">注意</text>
          <text class="explanation-value">{{explanationUncertainty}}</text>
        </view>
        <view class="explanation-action" wx:if="{{explanationActionText}}" bindtap="onReportExplanationAction">{{explanationActionText}}</view>
      </view>
      <view class="quality-box quality-box-{{qualityClass}}" wx:if="{{hasQuality}}">
        <view class="quality-title-row">
          <text class="quality-title">{{qualityLabel}}</text>
          <text class="quality-sample">{{qualitySampleSummary}}</text>
        </view>
        <text class="quality-reason" wx:for="{{qualityReasons}}" wx:key="index">{{item}}</text>
      </view>
      <view class="report-metrics">
        <view bindtap="onTraceableUrlTap" data-url="{{metricActions.errorsUrl}}"><text>{{report.totalErrors || 0}}</text><text>相关错题</text></view>
        <view bindtap="onTraceableUrlTap" data-url="{{metricActions.bottlenecksUrl}}"><text>{{bottleneckCount}}</text><text>学习卡点</text></view>
        <view bindtap="onTraceableUrlTap" data-url="{{metricActions.sourcesUrl}}"><text>{{sourceImageCount}}</text><text>试卷图片</text></view>
      </view>
      <view class="feedback-line" bindtap="onOpenFeedback" data-target-type="report" data-target-id="" data-type="unclear_result">这份报告不准确？点这里反馈</view>
    </view>

    <view class="card chinese-error-card" wx:if="{{hasChineseErrorItems}}">
      <view class="section-heading"><view class="heading-icon">字</view><text>语文具体错项</text></view>
      <view class="chinese-error-item" wx:for="{{chineseErrorItems}}" wx:key="viewId">
        <view class="chinese-error-head">
          <text class="chinese-error-index">{{item.displayIndex}}</text>
          <text class="chinese-error-title">{{item.displayName}}</text>
          <text class="chinese-error-type">{{item.typeText}}</text>
        </view>
        <text class="chinese-error-line" wx:if="{{item.answerText}}">{{item.answerText}}</text>
        <text class="chinese-error-line wrong" wx:if="{{item.studentText}}">{{item.studentText}}</text>
        <text class="chinese-error-line" wx:if="{{item.sourceText}}">{{item.sourceText}}</text>
        <text class="chinese-error-line" wx:if="{{item.mistakeText}}">{{item.mistakeText}}</text>
        <text class="chinese-error-method">{{item.methodText}}</text>
      </view>
    </view>

    <view class="card bottleneck-group-card" wx:if="{{hasBottleneckGroups}}">
      <view class="section-heading"><view class="heading-icon">⌁</view><text>发现的学习卡点</text></view>
      <view class="bottleneck-group" wx:for="{{bottleneckGroups}}" wx:for-item="group" wx:key="categoryId">
        <view class="bottleneck-group-head">
          <text class="bottleneck-group-title">{{group.title}}</text>
          <text class="bottleneck-group-count">{{group.summaryText}}</text>
        </view>
        <view class="bottleneck-family" wx:for="{{group.families}}" wx:for-item="family" wx:key="familyId">
          <view class="bottleneck-family-head">
            <text class="bottleneck-family-title">{{family.title}}</text>
            <text class="bottleneck-family-count">{{family.summaryText}}</text>
          </view>
          <view class="bottleneck-mini-item" wx:for="{{family.items}}" wx:for-item="item" wx:key="viewId" bindtap="onTraceableUrlTap" data-url="{{item.detailUrl}}">
            <view class="status-dot status-dot-{{item.statusClass}}"></view>
            <view class="bottleneck-mini-copy">
              <view class="bottleneck-mini-title-row">
                <text class="bottleneck-mini-title">{{item.displayName}}</text>
                <text class="status-label status-label-{{item.statusClass}}">{{item.statusText}}</text>
              </view>
              <text class="bottleneck-mini-meta">{{item.evidenceText || item.metaText}}</text>
              <text class="feedback-link" catchtap="onOpenFeedback" data-target-type="bottleneck" data-target-id="{{item.bottleneckId || item.lpCode}}" data-type="wrong_bottleneck">反馈这个卡点</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{showFlatBottleneckList}}">
      <view class="section-heading"><view class="heading-icon">⌁</view><text>发现的学习卡点</text></view>
      <view class="bottleneck-item" wx:for="{{bottleneckList}}" wx:key="viewId" bindtap="onTraceableUrlTap" data-url="{{item.detailUrl}}">
        <view class="status-icon status-icon-{{item.statusClass}}">{{item.statusIcon}}</view>
        <view class="bottleneck-copy">
          <view class="bottleneck-title-row">
            <text class="bottleneck-title">{{item.displayName}}</text>
            <text class="confidence-tag {{item.confidenceLevel}}">{{item.confidenceDots}}</text>
            <text class="status-label status-label-{{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <text class="bottleneck-desc">{{item.rootCause || item.suggestion || '建议结合相关错题进一步观察。'}}</text>
          <text class="bottleneck-meta">{{item.confidenceLabel}} · {{item.confidenceDetail}} · {{item.metaText}}</text>
          <text class="feedback-link" catchtap="onOpenFeedback" data-target-type="bottleneck" data-target-id="{{item.bottleneckId || item.lpCode}}" data-type="wrong_bottleneck">反馈这个卡点</text>
        </view>
      </view>
    </view>

    <view class="card learning-map-card" wx:if="{{hasLearningMap}}">
      <view class="section-heading"><view class="heading-icon">⌘</view><text>知识地图下一步</text></view>
      <view class="learning-map-item" wx:for="{{learningMapItems}}" wx:key="lpCode">
        <text class="learning-node">{{item.nodeText}}</text>
        <text class="learning-node-detail" wx:if="{{item.nodeDetailText}}">{{item.nodeDetailText}}</text>
        <text class="learning-bottleneck" wx:if="{{item.bottleneckText}}">细卡点：{{item.bottleneckText}}</text>
        <text class="learning-action">{{item.nextActionText}}</text>
        <text class="learning-resource-summary" wx:if="{{item.resourceSummary}}">{{item.resourceSummary}}</text>
        <view class="learning-resource-list" wx:if="{{item.hasResources}}">
          <view
            class="learning-resource {{resource.hasUrl ? 'learning-resource-clickable' : ''}}"
            wx:for="{{item.resources}}"
            wx:for-item="resource"
            wx:key="resourceId"
            bindtap="onLearningResourceTap"
            data-url="{{resource.url}}"
            data-title="{{resource.displayTitle}}"
            data-platform="{{resource.platform}}"
          >
            <view class="learning-resource-head">
              <text class="learning-resource-role">{{resource.role}}</text>
              <text class="learning-resource-type">{{resource.typeLabel}}</text>
            </view>
            <text class="learning-resource-title">{{resource.platform}} · {{resource.displayTitle}}</text>
            <text class="learning-resource-summary-line" wx:if="{{resource.summary}}">{{resource.summary}}</text>
            <view class="learning-resource-action" wx:if="{{resource.hasUrl}}">
              <text>{{resource.actionText}}</text>
              <text class="resource-arrow">›</text>
            </view>
            <text class="learning-resource-usage">{{resource.usageText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{hasVerificationEvidence}}">
      <view class="section-heading"><view class="heading-icon">✓</view><text>验证证据</text></view>
      <view class="evidence-item" wx:for="{{verificationEvidenceItems}}" wx:key="lpCode">
        <view class="evidence-title-row">
          <text class="evidence-name">{{item.displayName}}</text>
          <text class="evidence-status evidence-status-{{item.statusClass}}">{{item.statusText}}</text>
        </view>
        <text class="evidence-reason">{{item.evidenceReason}}</text>
      </view>
    </view>

    <view class="card source-card" bindtap="onViewSources">
      <view class="section-heading"><view class="heading-icon">▧</view><text>本次使用的试卷</text></view>
      <view class="source-row">
        <view class="source-copy">
          <text class="source-title">{{sourceImageCount}} 张试卷图片</text>
          <text class="source-desc">查看原始照片、OCR 摘要和重复记录</text>
        </view>
        <text class="source-arrow">›</text>
      </view>
      <view class="source-evidence-list" wx:if="{{hasSourceEvidence}}">
        <view class="source-evidence" wx:for="{{sourceEvidenceItems}}" wx:key="fileID">
          <view class="source-evidence-head">
            <text class="source-evidence-title">{{item.sourceText}} · {{item.title}}</text>
            <text class="source-evidence-status">{{item.duplicateText || item.statusText}}</text>
          </view>
          <text class="source-evidence-summary">{{item.summary}}</text>
          <text class="source-evidence-errors" wx:if="{{item.relatedErrorText}}">关联错题：{{item.relatedErrorText}}</text>
        </view>
        <view class="source-evidence-more" wx:if="{{hasMoreSourceEvidence}}" catchtap="onExpandSourceEvidence">
          展开剩余 {{hiddenSourceEvidenceCount}} 条来源摘要
        </view>
      </view>
    </view>

    <view class="card" wx:if="{{hasErrorDetails}}">
      <view class="section-heading"><view class="heading-icon">?</view><text>相关错题详情</text></view>
      <view class="error-item" wx:for="{{errorDetailList}}" wx:key="index" bindtap="onToggleError" data-index="{{index}}">
        <view class="error-question"><text class="error-index">{{item.displayIndex}}</text><text class="error-content">{{item.questionContent}}</text></view>
        <view class="error-expand" wx:if="{{item.expanded}}">
          <view class="error-row"><text class="error-label">学生答案</text><text class="error-value wrong">{{item.studentAnswer}}</text></view>
          <view class="error-row"><text class="error-label">正确答案</text><text class="error-value correct">{{item.correctAnswer}}</text></view>
          <view class="error-row" wx:if="{{item.sourceText}}"><text class="error-label">来源</text><text class="error-value">{{item.sourceText}}</text></view>
          <view class="error-row" wx:if="{{item.rootCause}}"><text class="error-label">分析</text><text class="error-value">{{item.rootCause}}</text></view>
          <view class="feedback-link error-feedback" catchtap="onOpenFeedback" data-target-type="errorDetail" data-target-id="{{item.feedbackTargetId}}" data-type="wrong_question">这道题识别错了</view>
        </view>
        <text class="expand-hint">{{item.expanded ? '收起' : '展开详情'}}</text>
      </view>
      <view class="error-detail-more" wx:if="{{hasMoreErrorDetails}}" catchtap="onExpandErrorDetails">
        展开剩余 {{hiddenErrorDetailCount}} 道错题
      </view>
    </view>

    <view class="knowledge-map-snapshot" wx:if="{{hasKnowledgeMapSnapshot && !isVerification}}">
      <view class="map-snapshot-header">🗺️ 知识地图更新</view>
      <view class="map-snapshot-list">
        <view class="map-snapshot-item {{item.statusClass}}" wx:for="{{knowledgeMapSnapshot}}" wx:key="lpCode"
              catchtap="onBottleneckSnapshotTap" data-lp-code="{{item.lpCode}}" data-lp-name="{{item.displayName}}">
          <text class="snapshot-icon">{{item.statusIcon}}</text>
          <view class="snapshot-text">
            <text class="snapshot-name">{{item.displayName}}</text>
            <text class="snapshot-meta">{{item.statusText}}</text>
          </view>
          <text class="snapshot-arrow">查看讲解 ›</text>
        </view>
      </view>
    </view>

    <view class="primary-action" wx:if="{{showNextStep && canGeneratePaper}}" bindtap="onGenerateVerification"><text>＋</text><text>查看验证卷</text></view>
    <view class="bottom-actions">
      <button class="btn-secondary action-btn" bindtap="onShare">分享</button>
      <button class="btn-secondary action-btn" bindtap="onDownloadPDF" disabled="{{generatingPdf}}">{{generatingPdf ? '生成中...' : '下载 PDF'}}</button>
    </view>
  </view>

  <view class="dialog-mask" wx:if="{{feedbackDialog.visible}}" bindtap="onCloseFeedback">
    <view class="feedback-dialog" catchtap="noop">
      <text class="dialog-title">反馈诊断问题</text>
      <text class="dialog-desc">反馈只会作为复核记录，不会直接修改原报告。</text>
      <view class="feedback-type-list">
        <view
          class="feedback-type {{feedbackDialog.type === item.type ? 'feedback-type-active' : ''}}"
          wx:for="{{feedbackTypes}}"
          wx:key="type"
          bindtap="onFeedbackTypeTap"
          data-type="{{item.type}}"
        >{{item.label}}</view>
      </view>
      <textarea class="feedback-input" placeholder="请简单说明哪里不准确" value="{{feedbackDialog.reason}}" bindinput="onFeedbackReasonInput" maxlength="120" />
      <textarea class="feedback-input feedback-note" placeholder="补充说明（可选）" value="{{feedbackDialog.note}}" bindinput="onFeedbackNoteInput" maxlength="500" />
      <view class="dialog-actions">
        <button class="dialog-btn dialog-cancel" bindtap="onCloseFeedback">取消</button>
        <button class="dialog-btn dialog-submit" bindtap="onSubmitFeedback" disabled="{{submittingFeedback}}">{{submittingFeedback ? '提交中...' : '提交反馈'}}</button>
      </view>
    </view>
  </view>
</view>
