.dialog-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(15,23,42,.42); display: flex; align-items: flex-end; z-index: 30; }.feedback-dialog { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 30rpx 28rpx 44rpx; box-sizing: border-box; }.dialog-title { display: block; color: #25364a; font-size: 30rpx; font-weight: 760; }.dialog-desc { display: block; color: #718096; font-size: 22rpx; line-height: 1.5; margin-top: 8rpx; }.feedback-type-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }.feedback-type { padding: 10rpx 16rpx; border-radius: 999rpx; background: #f1f5f9; color: #52677d; font-size: 22rpx; font-weight: 650; }.feedback-type-active { background: #dbeafe; color: #1d4ed8; }.feedback-input { width: 100%; min-height: 118rpx; box-sizing: border-box; background: #f8fafc; border: 1rpx solid #e2e8f0; border-radius: 14rpx; color: #25364a; font-size: 24rpx; line-height: 1.5; padding: 16rpx; margin-top: 18rpx; }.feedback-note { min-height: 90rpx; }.dialog-actions { display: flex; gap: 14rpx; margin-top: 20rpx; }.dialog-btn { flex: 1; border-radius: 14rpx; font-size: 25rpx; padding: 14rpx 0; }.dialog-btn::after { border: 0; }.dialog-cancel { background: #f1f5f9; color: #52677d; }.dialog-submit { background: #2768b4; color: #fff; }

