.bottleneck-family {
  background: transparent;
  border: 0;
  border-radius: 0;
  margin-top: 10rpx;
  padding: 0;
}

.bottleneck-mini-item {
  gap: 10rpx;
  margin-top: 10rpx;
  padding: 14rpx 0 0;
}

.bottleneck-mini-title {
  font-size: 24rpx;
}

.bottleneck-score-line {
  align-items: center;
  display: flex;
  gap: 14rpx;
  margin-top: 9rpx;
}

.bottleneck-score-line .bottleneck-score-track {
  flex: 1;
  margin-top: 0;
}

.bottleneck-score-line .bottleneck-score-value {
  flex-shrink: 0;
  font-size: 20rpx;
  white-space: nowrap;
}

.bottleneck-score-value {
  color: var(--b1-ink-strong);
  font-size: 23rpx;
  font-weight: 700;
}

.bottleneck-score-track {
  background: var(--b1-neutral-bg);
  border-radius: 4rpx;
  height: 7rpx;
  margin-top: 5rpx;
  overflow: hidden;
}

.bottleneck-score-fill {
  height: 100%;
}

.bottleneck-score-fill.confidence-high { background: var(--b1-priority-fg); }
.bottleneck-score-fill.confidence-medium { background: var(--b1-waiting-fg); }
.bottleneck-score-fill.confidence-low { background: var(--b1-informational-fg); }

.bottleneck-evidence-grid {
  display: grid;
  gap: 6rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 9rpx;
}

.bottleneck-evidence-cell {
  background: var(--b1-neutral-bg);
  border-radius: 6rpx;
  min-width: 0;
  padding: 7rpx 5rpx;
  text-align: center;
}

.bottleneck-evidence-value {
  color: var(--b1-ink-strong);
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.bottleneck-evidence-label {
  color: var(--b1-ink-subtle);
  display: block;
  font-size: 20rpx;
  margin-top: 1rpx;
}

.bottleneck-time-line {
  color: var(--b1-ink-muted);
  display: block;
  font-size: 20rpx;
  line-height: 1.35;
  margin-top: 8rpx;
}
