.report-section-anchor { height: 1rpx; scroll-margin-top: 82rpx; }

/* 第三批：变化构成色带（页头）+ 验证通过率色带（报告顶部） */
.trend-band { margin-top: 16rpx; }
.trend-band-legend .b1-seg-legend-item { color: rgba(255, 255, 255, 0.82); }
.report-layer-symbol { font-size: 28rpx; }
.verification-outcome-card { background: #fff; border-radius: 15rpx; padding: 20rpx 25rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }
.verification-outcome-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 12rpx; }
.verification-outcome-title { color: #25364a; font-size: 26rpx; font-weight: 700; }
.verification-outcome-rate { color: var(--b1-improved-fg); font-size: 24rpx; font-weight: 750; }
.status-icon.b1-symbol { font-size: 30rpx; }
.report-type-symbol, .action-symbol { font-size: 28rpx; margin-right: 6rpx; }
