.page { min-height: 100vh; background: #f4f7fa; padding-bottom: 40rpx; }
.report-header { padding: 44rpx 32rpx 46rpx; color: #fff; }.header-diagnosis { background: #1f4f82; }.header-verify { background: #276749; }
.report-type,.report-date { display: block; font-size: 23rpx; opacity: .78; }.report-date { margin-top: 3rpx; }.paper-code-chip { align-self: flex-start; background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.28); border-radius: 999rpx; color: #fff; display: inline-flex; font-size: 22rpx; font-weight: 760; margin-top: 12rpx; padding: 7rpx 14rpx; }.report-headline { display: block; font-size: 34rpx; line-height: 1.4; font-weight: 750; margin-top: 18rpx; }.report-summary { display: block; font-size: 24rpx; line-height: 1.55; opacity: .82; margin-top: 8rpx; }
.content { padding: 0 28rpx 24rpx; }.card { background: #fff; border-radius: 15rpx; padding: 25rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.04); }.conclusion-card { margin-top: -22rpx; position: relative; }
.section-heading { display: flex; align-items: center; gap: 10rpx; color: #25364a; font-size: 29rpx; font-weight: 700; margin-bottom: 16rpx; }.heading-icon { width: 40rpx; height: 40rpx; border-radius: 10rpx; background: #eaf4ff; color: #2b6cb0; display: flex; align-items: center; justify-content: center; font-size: 23rpx; }
.conclusion-text { display: block; color: #52677d; font-size: 26rpx; line-height: 1.6; }.report-metrics { display: flex; margin-top: 20rpx; background: #f7fafc; border-radius: 12rpx; padding: 16rpx 0; }.report-metrics view { flex: 1; text-align: center; border-left: 1rpx solid #e5ebf1; }.report-metrics view:first-child { border-left: 0; }.report-metrics text:first-child { display: block; color: #25364a; font-size: 32rpx; font-weight: 750; }.report-metrics text:last-child { display: block; color: #8b98a7; font-size: 21rpx; }
.bottleneck-item { display: flex; gap: 14rpx; padding: 20rpx 0; border-top: 1rpx solid #edf2f7; }.bottleneck-item:first-of-type { border-top: 0; }.status-icon { width: 54rpx; height: 54rpx; border-radius: 13rpx; display: flex; align-items: center; justify-content: center; font-weight: 800; flex-shrink: 0; }.status-icon-persisting { background: #fee2e2; color: #b91c1c; }.status-icon-pending { background: #fef3c7; color: #a16207; }.status-icon-improved { background: #dcfce7; color: #166534; }
.bottleneck-copy { flex: 1; min-width: 0; }.bottleneck-title-row { display: flex; align-items: center; gap: 10rpx; }.bottleneck-title { flex: 1; color: #25364a; font-size: 27rpx; font-weight: 650; }.status-label { padding: 4rpx 9rpx; border-radius: 7rpx; font-size: 19rpx; font-weight: 700; white-space: nowrap; }.status-label-persisting { background: #fee2e2; color: #b91c1c; }.status-label-pending { background: #fef3c7; color: #a16207; }.status-label-improved { background: #dcfce7; color: #166534; }.bottleneck-desc { display: block; color: #697b8e; font-size: 23rpx; line-height: 1.5; margin-top: 6rpx; }.bottleneck-meta { display: block; color: #a0adba; font-size: 20rpx; margin-top: 5rpx; }
.source-row { display: flex; align-items: center; }.source-copy { flex: 1; }.source-title { display: block; color: #25364a; font-size: 27rpx; font-weight: 650; }.source-desc { display: block; color: #8b98a7; font-size: 22rpx; margin-top: 4rpx; }.source-arrow { color: #aebaca; font-size: 36rpx; }
.error-item { padding: 18rpx 0; border-top: 1rpx solid #edf2f7; }.error-item:first-of-type { border-top: 0; }.error-question { display: flex; color: #25364a; font-size: 26rpx; line-height: 1.5; }.error-index { color: #8b98a7; margin-right: 8rpx; }.error-content { flex: 1; }.error-expand { margin-top: 12rpx; padding: 16rpx; background: #f7fafc; border-radius: 10rpx; }.error-row { display: flex; gap: 10rpx; margin-bottom: 7rpx; font-size: 23rpx; line-height: 1.5; }.error-label { color: #8795a5; }.error-value { color: #52677d; }.wrong { color: #c24131; }.correct { color: #25845f; }.expand-hint { display: block; text-align: right; color: #2b6cb0; font-size: 21rpx; margin-top: 6rpx; }
.primary-action { min-height: 90rpx; border-radius: 14rpx; background: #2768b4; color: #fff; display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: 28rpx; font-weight: 700; box-shadow: 0 7rpx 18rpx rgba(39,104,180,.22); margin-bottom: 20rpx; }.bottom-actions { display: flex; gap: 16rpx; }.action-btn { flex: 1; font-size: 25rpx; padding: 17rpx 0; }
.status-card { margin: -22rpx 28rpx 0; position: relative; background: #fff; border-radius: 15rpx; padding: 25rpx; display: flex; gap: 15rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,.05); }.state-icon { width: 58rpx; height: 58rpx; border-radius: 14rpx; background: #fef3c7; color: #a16207; display: flex; align-items: center; justify-content: center; font-weight: 800; }.status-copy { flex: 1; }.status-title { display: block; color: #25364a; font-size: 27rpx; font-weight: 650; }.status-desc { display: block; color: #8291a3; font-size: 22rpx; line-height: 1.45; margin-top: 4rpx; }.progress-bar { height: 10rpx; background: #e5ebf1; border-radius: 5rpx; overflow: hidden; margin-top: 14rpx; }.progress-fill { height: 100%; background: #3b82f6; }.retry-analysis-btn { margin-top: 14rpx; background: #fff; color: #a16207; border: 2rpx solid #f59e0b; font-size: 23rpx; }.retry-analysis-btn::after { border: 0; }
