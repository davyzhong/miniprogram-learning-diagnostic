/* pages/paper-preview/paper-preview.wxss */

.page {
  min-height: 100vh;
  background: #f5f8fb;
  padding-bottom: 200rpx;
}

.paper-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 28rpx 12rpx;
}

.tag {
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 650;
  padding: 5rpx 14rpx;
}

.tag-verification {
  background: #dff7ea;
  color: #27704b;
}

.tag-diagnosis {
  background: #e6f0ff;
  color: #23599c;
}

.tag-subject {
  background: #eadcff;
  color: #5a39a0;
}

.tag-student {
  background: #ffdede;
  color: #982d35;
}

.workbench-card,
.card {
  background: #fff;
  border: 1rpx solid #e6edf5;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(19, 43, 72, 0.05);
  margin: 0 28rpx 20rpx;
}

.workbench-card {
  padding: 28rpx;
}

.workbench-top {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.code-block {
  flex: 1;
  min-width: 0;
}

.traceable-block {
  position: relative;
}

.traceable-block:active,
.status-pill:active,
.question-tag:active,
.feedback-chip:active,
.section-action:active {
  opacity: 0.72;
}

.code-label {
  color: #718096;
  display: block;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.paper-code {
  color: #17365d;
  display: block;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 1.25;
  word-break: break-all;
}

.status-pill {
  border-radius: 999rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 720;
  padding: 8rpx 16rpx;
}

.status-waiting {
  background: #fff7df;
  color: #9a5b00;
}

.status-generated {
  background: #fff7df;
  color: #9a5b00;
}

.status-downloaded {
  background: #edf7f1;
  color: #2f704d;
}

.status-analyzing {
  background: #e6f0ff;
  color: #245ea8;
}

.status-completed {
  background: #e5f8ee;
  color: #26704a;
}

.status-failed {
  background: #ffe8e8;
  color: #9b2c2c;
}

.status-desc {
  color: #53657a;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 16rpx;
}

.lifecycle-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
}

.lifecycle-step {
  align-items: center;
  background: #f4f7fb;
  border-radius: 12rpx;
  display: flex;
  gap: 8rpx;
  min-width: 0;
  padding: 12rpx 10rpx;
}

.step-dot {
  background: #a7b4c4;
  border-radius: 50%;
  flex-shrink: 0;
  height: 12rpx;
  width: 12rpx;
}

.step-text {
  color: #53657a;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.25;
}

.lifecycle-completed {
  background: #edf7f1;
}

.lifecycle-completed .step-dot {
  background: #2f9d63;
}

.lifecycle-active {
  background: #eaf2ff;
}

.lifecycle-active .step-dot {
  background: #2d6cdf;
}

.lifecycle-failed {
  background: #fff0ee;
}

.lifecycle-failed .step-dot {
  background: #d84a2b;
}

.lifecycle-waiting .step-dot {
  background: #b8c4d2;
}

.meta-grid {
  border-top: 1rpx solid #eef3f8;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx 22rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
}

.meta-cell {
  min-width: 0;
}

.meta-label {
  color: #8794a6;
  display: block;
  font-size: 21rpx;
  margin-bottom: 6rpx;
}

.meta-value {
  color: #1f2937;
  display: block;
  font-size: 25rpx;
  font-weight: 680;
  line-height: 1.35;
}

.date-strong {
  color: #17365d;
  font-size: 30rpx;
  font-weight: 850;
}

.paper-info {
  padding: 22rpx 28rpx;
}

.info-row {
  display: flex;
}

.info-label {
  color: #718096;
  flex-shrink: 0;
  font-size: 25rpx;
  width: 150rpx;
}

.info-value {
  color: #1f2937;
  flex: 1;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.45;
}

.question-card,
.feedback-card {
  padding: 26rpx 28rpx;
}

.section-title-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 760;
}

.section-action {
  color: #2d6cdf;
  font-size: 24rpx;
  font-weight: 680;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.question-item {
  border-bottom: 1rpx solid #edf2f7;
  padding-bottom: 20rpx;
}

.question-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.question-head {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.question-no {
  color: #245ea8;
  font-size: 31rpx;
  font-weight: 820;
  min-width: 32rpx;
}

.question-tag {
  background: #f1f5f9;
  border-radius: 8rpx;
  color: #53657a;
  font-size: 21rpx;
  padding: 6rpx 12rpx;
}

.question-content {
  color: #202733;
  display: block;
  font-size: 27rpx;
  line-height: 1.55;
}

.answer-space {
  align-items: center;
  border: 2rpx dashed #c7d6e7;
  border-radius: 10rpx;
  color: #98a9bc;
  display: flex;
  font-size: 22rpx;
  height: 74rpx;
  margin-top: 14rpx;
  padding-left: 18rpx;
}

.empty-preview {
  color: #718096;
  font-size: 24rpx;
  padding: 32rpx 0;
  text-align: center;
}

.feedback-title {
  color: #1f2937;
  display: block;
  font-size: 28rpx;
  font-weight: 720;
  margin-bottom: 8rpx;
}

.feedback-summary {
  color: #5f6f83;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
}

.feedback-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.feedback-chip {
  background: #edf7f1;
  border-radius: 8rpx;
  color: #2f704d;
  font-size: 21rpx;
  padding: 7rpx 10rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx;
}

.action-bar .action-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 18rpx 0;
}

.bottom-bar {
  background: #fff;
  bottom: 0;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  left: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 100;
}

.bottom-bar .btn-main {
  background: linear-gradient(135deg, #2b6cb0 0%, #3182ce 100%);
  border: none;
  border-radius: 16rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
  padding: 24rpx 0;
  width: 100%;
}

.btn-main::after {
  border: none;
}
