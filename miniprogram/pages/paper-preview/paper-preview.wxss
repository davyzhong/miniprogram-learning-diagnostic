/* pages/paper-preview/paper-preview.wxss */

.page {
  min-height: 100vh;
  background: #f5f8fb;
  padding-bottom: 200rpx;
}

.paper-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 28rpx 12rpx;
}

.chinese-review-paper-row {
  align-items: center;
  border-top: 1rpx solid #edf2f7;
  display: flex;
  gap: 16rpx;
  padding: 17rpx 22rpx;
}
.chinese-review-paper-row:first-of-type { border-top: 0; }
.chinese-review-paper-main { flex: 1; min-width: 0; }
.chinese-review-paper-title { align-items: center; display: flex; gap: 10rpx; }
.chinese-target-name { color: #25364a; font-size: 27rpx; font-weight: 800; }
.chinese-stage-tag { background: #e8f2fb; border-radius: 6rpx; color: #245b89; font-size: 20rpx; font-weight: 700; padding: 4rpx 9rpx; }
.chinese-review-paper-desc,
.chinese-extension-text { color: #64748b; display: block; font-size: 21rpx; line-height: 1.45; margin-top: 7rpx; }
.chinese-extension-text { color: #7c3f00; }
.chinese-feedback { color: #64748b; flex-shrink: 0; font-size: 20rpx; font-weight: 750; }
.chinese-feedback-passed { color: #26704a; }
.chinese-feedback-failed { color: #b45309; }
.chinese-feedback-unclear,
.chinese-feedback-incomplete { color: #9a5b00; }

.tag {
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 650;
  padding: 5rpx 14rpx;
}

.tag-verification {
  background: #dff7ea;
  color: #27704b;
}

.tag-diagnosis {
  background: #e6f0ff;
  color: #23599c;
}

.tag-subject {
  background: #eadcff;
  color: #5a39a0;
}

.tag-student {
  background: #ffdede;
  color: #982d35;
}

.workbench-card,
.card {
  background: #fff;
  border: 1rpx solid #e6edf5;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 18rpx rgba(19, 43, 72, 0.05);
  margin: 0 28rpx 20rpx;
}

.workbench-card {
  padding: 28rpx;
}

.workbench-hero {
  align-items: stretch;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.workbench-main {
  flex: 1;
  min-width: 0;
}

.workbench-illustration {
  border-radius: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(19, 43, 72, 0.08);
  flex-shrink: 0;
  height: 390rpx;
  width: 100%;
  background: #eef7ff;
  order: -1;
}

.workbench-top {
  align-items: flex-start;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.code-block {
  flex: 1;
  min-width: 0;
}

.traceable-block {
  position: relative;
}

.traceable-block:active,
.status-pill:active,
.question-tag:active,
.feedback-chip:active,
.section-action:active {
  opacity: 0.72;
}

.code-label {
  color: #718096;
  display: block;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.paper-code {
  color: #17365d;
  display: block;
  font-size: 34rpx;
  font-weight: 820;
  line-height: 1.25;
  word-break: break-all;
}

.status-pill {
  border-radius: 999rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 720;
  padding: 8rpx 16rpx;
}

.status-waiting {
  background: #fff7df;
  color: #9a5b00;
}

.status-generated {
  background: #fff7df;
  color: #9a5b00;
}

.status-downloaded {
  background: #edf7f1;
  color: #2f704d;
}

.status-analyzing {
  background: #e6f0ff;
  color: #245ea8;
}

.status-completed {
  background: #e5f8ee;
  color: #26704a;
}

.status-failed {
  background: #ffe8e8;
  color: #9b2c2c;
}

.status-desc {
  color: #53657a;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  margin-top: 16rpx;
}

.lifecycle-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
}

.lifecycle-step {
  align-items: center;
  background: #f4f7fb;
  border-radius: 12rpx;
  display: flex;
  gap: 8rpx;
  min-width: 0;
  padding: 12rpx 10rpx;
}

.step-dot {
  background: #a7b4c4;
  border-radius: 50%;
  flex-shrink: 0;
  height: 12rpx;
  width: 12rpx;
}

.step-text {
  color: #53657a;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.25;
}

.lifecycle-completed {
  background: #edf7f1;
}

.lifecycle-completed .step-dot {
  background: #2f9d63;
}

.lifecycle-active {
  background: #eaf2ff;
}

.lifecycle-active .step-dot {
  background: #2d6cdf;
}

.lifecycle-failed {
  background: #fff0ee;
}

.lifecycle-failed .step-dot {
  background: #d84a2b;
}

.lifecycle-waiting .step-dot {
  background: #b8c4d2;
}

.meta-grid {
  border-top: 1rpx solid #eef3f8;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx 22rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
}

.meta-cell {
  min-width: 0;
}

.meta-label {
  color: #8794a6;
  display: block;
  font-size: 21rpx;
  margin-bottom: 6rpx;
}

.meta-value {
  color: #1f2937;
  display: block;
  font-size: 25rpx;
  font-weight: 680;
  line-height: 1.35;
}

.date-strong {
  color: #17365d;
  font-size: 30rpx;
  font-weight: 850;
}

.coverage-card {
  padding: 26rpx 28rpx;
}

.coverage-group {
  border-top: 1rpx solid #edf2f7;
  padding: 20rpx 0 4rpx;
}

.coverage-group:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.coverage-group-head,
.coverage-family-head {
  align-items: center;
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
}

.coverage-group-title {
  color: #17365d;
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
  min-width: 0;
}

.coverage-group-count {
  background: #eaf2ff;
  border-radius: 999rpx;
  color: #245ea8;
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 750;
  padding: 5rpx 12rpx;
}

.coverage-family {
  background: #f8fafc;
  border: 1rpx solid #e5edf5;
  border-radius: 14rpx;
  margin-top: 14rpx;
  padding: 14rpx;
}

.coverage-family-title {
  color: #304155;
  flex: 1;
  font-size: 24rpx;
  font-weight: 760;
  line-height: 1.35;
  min-width: 0;
}

.coverage-family-count {
  color: #7b8ca1;
  flex-shrink: 0;
  font-size: 20rpx;
}

.coverage-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.coverage-chip {
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 8rpx;
  max-width: 100%;
  padding: 8rpx 12rpx;
}

.coverage-chip-title {
  color: #25364a;
  display: block;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.35;
}

.question-card,
.feedback-card {
  padding: 26rpx 28rpx;
}

.task-pack-card {
  padding: 26rpx 28rpx;
}

.section-title-row {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 760;
}

.section-action {
  color: #2d6cdf;
  font-size: 24rpx;
  font-weight: 680;
}

.task-page-row {
  align-items: center;
  border-bottom: 1rpx solid #edf2f7;
  display: flex;
  gap: 18rpx;
  justify-content: space-between;
  padding: 18rpx 0;
}

.task-page-row:last-child {
  border-bottom: none;
}

.task-page-main {
  flex: 1;
  min-width: 0;
}

.task-page-title {
  color: #1f2937;
  display: block;
  font-size: 26rpx;
  font-weight: 750;
}

.task-page-code {
  color: #2d6cdf;
  display: block;
  font-size: 21rpx;
  line-height: 1.45;
  margin-top: 4rpx;
}

.task-page-targets {
  color: #6b7280;
  display: block;
  font-size: 22rpx;
  line-height: 1.45;
  margin-top: 4rpx;
}

.task-page-status {
  border-radius: 999rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 720;
  padding: 7rpx 14rpx;
}

.task-page-pending .task-page-status {
  background: #fff7ed;
  color: #9a3412;
}

.task-page-completed .task-page-status {
  background: #ecfdf5;
  color: #047857;
}

.question-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.question-item {
  border-bottom: 1rpx solid #edf2f7;
  padding-bottom: 20rpx;
}

.question-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.question-head {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.question-no {
  color: #245ea8;
  font-size: 31rpx;
  font-weight: 820;
  min-width: 32rpx;
}

.question-tag {
  background: #f1f5f9;
  border-radius: 8rpx;
  color: #53657a;
  font-size: 21rpx;
  padding: 6rpx 12rpx;
}

.question-content {
  color: #202733;
  display: block;
  font-size: 27rpx;
  line-height: 1.55;
}

.answer-space {
  align-items: center;
  border: 2rpx dashed #c7d6e7;
  border-radius: 10rpx;
  color: #98a9bc;
  display: flex;
  font-size: 22rpx;
  height: 74rpx;
  margin-top: 14rpx;
  padding-left: 18rpx;
}

.empty-preview {
  color: #718096;
  font-size: 24rpx;
  padding: 32rpx 0;
  text-align: center;
}

.feedback-title {
  color: #1f2937;
  display: block;
  font-size: 28rpx;
  font-weight: 720;
  margin-bottom: 8rpx;
}

.feedback-summary {
  color: #5f6f83;
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
}

.feedback-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.feedback-chip {
  background: #edf7f1;
  border-radius: 8rpx;
  color: #2f704d;
  font-size: 21rpx;
  padding: 7rpx 10rpx;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 0 28rpx;
}

.action-bar .action-btn {
  flex: 1;
  font-size: 28rpx;
  padding: 18rpx 0;
}

.bottom-bar {
  background: #fff;
  bottom: 0;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 16rpx;
  left: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  position: fixed;
  right: 0;
  z-index: 100;
}

.bottom-bar .btn-main {
  border: none;
  border-radius: 16rpx;
  flex: 1;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.4;
  padding: 24rpx 0;
}

.bottom-bar .btn-primary {
  background: var(--b1-informational-fg);
  color: #fff;
}

.bottom-bar .btn-secondary {
  background: #eef6ff;
  color: #245b93;
}

.btn-main::after {
  border: none;
}

/* B1 paper identity and semantic state layer. */
.paper-tags.b1-paper-header {
  background: var(--b1-surface);
  border: 1rpx solid var(--b1-border);
  border-left: 8rpx solid var(--b1-subject-math-fg);
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
}

.paper-tags.b1-subject-chinese { border-left-color: var(--b1-subject-chinese-fg); }
.paper-tags.b1-subject-english { border-left-color: var(--b1-subject-english-fg); }

.paper-tags.b1-subject-math .tag-subject {
  background: var(--b1-subject-math-bg);
  color: var(--b1-subject-math-fg);
}

.paper-tags.b1-subject-chinese .tag-subject {
  background: var(--b1-subject-chinese-bg);
  color: var(--b1-subject-chinese-fg);
}

.paper-tags.b1-subject-english .tag-subject {
  background: var(--b1-subject-english-bg);
  color: var(--b1-subject-english-fg);
}

.b1-state-waiting,
.b1-state-generated,
.b1-state-analyzing {
  background: var(--b1-waiting-bg);
  color: var(--b1-waiting-fg);
}

.b1-state-downloaded,
.b1-state-completed {
  background: var(--b1-improved-bg);
  color: var(--b1-improved-fg);
}

.b1-state-failed {
  background: var(--b1-destructive-bg);
  color: var(--b1-destructive-fg);
}

.workbench-card,
.card {
  border-color: var(--b1-border);
  border-radius: 10rpx;
  box-shadow: none;
}

.bottom-bar .btn-main {
  border-radius: 9rpx;
}

.bottom-bar .btn-primary {
  background: var(--b1-ink-strong);
}

/* 第四批：emoji 符号 */
.paper-tag-symbol { font-size: 30rpx; margin-right: 8rpx; }
.btn-symbol { font-size: 28rpx; margin-right: 6rpx; }
