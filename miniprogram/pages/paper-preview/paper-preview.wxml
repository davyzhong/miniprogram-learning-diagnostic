<!--pages/paper-preview/paper-preview.wxml-->
<view class="page">
  <view class="paper-tags">
    <view class="tag tag-{{paperType}}">{{typeText}}</view>
    <view class="tag tag-subject">{{subjectName}}</view>
    <view class="tag tag-student">{{studentName}}</view>
  </view>

  <view class="workbench-card">
    <view class="workbench-hero">
      <view class="workbench-main">
        <view class="workbench-top">
          <view class="code-block traceable-block" bindtap="onTraceableUrlTap" data-url="{{paperCodeUrl}}">
            <text class="code-label">验证试卷编号</text>
            <text class="paper-code">{{paperCodeText || '待生成编号'}}</text>
          </view>
          <view class="status-pill status-{{workbenchStatus}}" bindtap="onTraceableUrlTap" data-url="{{statusUrl}}">{{workbenchStatusText}}</view>
        </view>
        <text class="status-desc">{{workbenchStatusDesc}}</text>
      </view>
    </view>
    <view class="lifecycle-row" wx:if="{{lifecycleSteps.length > 0}}">
      <view class="lifecycle-step lifecycle-{{item.status}}" wx:for="{{lifecycleSteps}}" wx:key="key">
        <text class="step-dot"></text>
        <text class="step-text">{{item.text}}</text>
      </view>
    </view>
    <view class="meta-grid">
      <view class="meta-cell traceable-block" wx:if="{{paperDate}}" bindtap="onTraceableUrlTap" data-url="{{paperCodeUrl}}">
        <text class="meta-label">试卷日期</text>
        <text class="meta-value date-strong">{{paperDate}}</text>
      </view>
      <view class="meta-cell traceable-block" bindtap="onTraceableUrlTap" data-url="{{paperCodeUrl}}">
        <text class="meta-label">题目数量</text>
        <text class="meta-value">{{questionCount}} 题</text>
      </view>
      <view class="meta-cell traceable-block" bindtap="onTraceableUrlTap" data-url="{{paperCodeUrl}}">
        <text class="meta-label">页数</text>
        <text class="meta-value">{{pageSummary}}</text>
      </view>
      <view class="meta-cell" wx:if="{{estimatedMinutes > 0}}">
        <text class="meta-label">预计用时</text>
        <text class="meta-value">约 {{estimatedMinutes}} 分钟</text>
      </view>
    </view>
  </view>

  <view class="chinese-review-card card" wx:if="{{hasChineseReviewCoverage}}">
    <view class="section-title-row">
      <text class="section-title">语文原项复测</text>
      <text class="section-action">先原项，后举一反三</text>
    </view>
    <view class="chinese-review-paper-row" wx:for="{{chineseReviewCoverage}}" wx:key="viewId">
      <view class="chinese-review-paper-main">
        <view class="chinese-review-paper-title">
          <text class="chinese-target-name">{{item.title}}</text>
          <text class="chinese-stage-tag">{{item.stageText}}</text>
        </view>
        <text class="chinese-review-paper-desc">{{item.methodText}} · {{item.directText}}<text wx:if="{{item.transferText}}"> · {{item.transferText}}</text></text>
        <text class="chinese-extension-text" wx:if="{{item.extensionText}}">{{item.extensionText}}</text>
      </view>
      <text class="chinese-feedback chinese-feedback-{{item.feedbackClass}}">{{item.feedbackText}}</text>
    </view>
  </view>

  <view class="coverage-card card traceable-block" wx:if="{{bottleneckHierarchy.hasHierarchy}}" bindtap="onTraceableUrlTap" data-url="{{bottleneckCenterUrl}}">
    <view class="section-title-row">
      <text class="section-title">覆盖卡点</text>
      <text class="section-action">{{bottleneckHierarchy.summaryText}}</text>
    </view>
    <view class="coverage-group" wx:for="{{bottleneckHierarchy.groups}}" wx:for-item="group" wx:key="categoryId">
      <view class="coverage-group-head">
        <text class="coverage-group-title">{{group.title}}</text>
        <text class="coverage-group-count">{{group.summaryText}}</text>
      </view>
      <view class="coverage-family" wx:for="{{group.families}}" wx:for-item="family" wx:key="familyId">
        <view class="coverage-family-head">
          <text class="coverage-family-title">{{family.title}}</text>
          <text class="coverage-family-count">{{family.summaryText}}</text>
        </view>
        <view class="coverage-chip-list">
          <view class="coverage-chip" wx:for="{{family.items}}" wx:for-item="item" wx:key="viewId">
            <text class="coverage-chip-title">{{item.displayName}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="task-pack-card card" wx:if="{{taskPack.hasTaskPack}}">
    <view class="section-title-row">
      <text class="section-title">作答回传进度</text>
      <text class="section-action">{{taskPack.progressText}}</text>
    </view>
    <view class="task-page-row task-page-{{item.status}}" wx:for="{{taskPackPages}}" wx:key="pageCode">
      <view class="task-page-main">
        <text class="task-page-title">第 {{item.pageIndex}} 页</text>
        <text class="task-page-targets" wx:if="{{item.targetText}}">{{item.targetText}}</text>
      </view>
      <text class="task-page-status">{{item.statusText}}</text>
    </view>
  </view>

  <view class="question-card card">
    <view class="section-title-row">
      <text class="section-title">试卷内容预览</text>
      <text class="section-action" wx:if="{{hasMoreQuestions}}" bindtap="onToggleQuestions">{{allQuestionsExpanded ? '收起' : '展开全部'}}</text>
    </view>
    <view class="question-list" wx:if="{{questionPreview.length > 0}}">
      <view class="question-item" wx:for="{{questionPreview}}" wx:key="number">
        <view class="question-head">
          <text class="question-no">{{item.number}}</text>
          <text class="question-tag" bindtap="onTraceableUrlTap" data-url="{{item.bottleneckUrl}}">{{item.bottleneckName}}</text>
        </view>
        <text class="question-content">{{item.content}}</text>
        <view class="answer-space">
          <text>解题过程 / 演算区</text>
        </view>
      </view>
    </view>
    <view class="empty-preview" wx:else>
      <text>完整内容请下载 PDF 查看。</text>
    </view>
  </view>

  <view class="feedback-card card">
    <view class="section-title-row">
      <text class="section-title">验证反馈</text>
      <text class="section-action" wx:if="{{feedback.reportId}}" bindtap="onTraceableUrlTap" data-url="{{feedback.reportUrl}}">查看报告</text>
    </view>
    <text class="feedback-title">{{feedback.title}}</text>
    <text class="feedback-summary">{{feedback.summary}}</text>
    <view class="feedback-chips" wx:if="{{feedback.chipItems.length > 0}}">
      <text class="feedback-chip" wx:for="{{feedback.chipItems}}" wx:key="text" bindtap="onTraceableUrlTap" data-url="{{item.url}}">{{item.text}}</text>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn-primary btn-main" bindtap="onPrimaryAction" disabled="{{downloading}}">
      {{downloading ? '下载中...' : (primaryActionText || uploadBtnText)}}
    </button>
    <button class="btn-secondary btn-main" wx:if="{{secondaryActionText}}" bindtap="onSecondaryAction">
      {{secondaryActionText}}
    </button>
  </view>
</view>
