/* app.wxss - 全局样式 */

page {
  background-color: #f7fafc;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #1a202c;
  line-height: 1.6;
  box-sizing: border-box;
}

view, text, image {
  box-sizing: border-box;
}

/* ========== 色彩变量（通过 class 覆盖；学科色以 B1 token 为唯一来源） ========== */
.page-math    { --subject-color: var(--b1-subject-math-fg); --subject-bg: var(--b1-subject-math-bg); --subject-light: var(--b1-subject-math-bg); }
.page-chinese { --subject-color: var(--b1-subject-chinese-fg); --subject-bg: var(--b1-subject-chinese-bg); --subject-light: var(--b1-subject-chinese-bg); }
.page-english { --subject-color: var(--b1-subject-english-fg); --subject-bg: var(--b1-subject-english-bg); --subject-light: var(--b1-subject-english-bg); }

/* ========== 通用容器 ========== */
.container {
  padding: 24rpx 28rpx;
  padding-bottom: 160rpx;
}

/* ========== 卡片 ========== */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* ========== 学科卡片（首页/学科选择页） ========== */
.subject-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
}

.subject-card-math    { border-left: 8rpx solid var(--b1-subject-math-fg); }
.subject-card-chinese { border-left: 8rpx solid var(--b1-subject-chinese-fg); }
.subject-card-english { border-left: 8rpx solid var(--b1-subject-english-fg); }

/* ========== 区域标题 ========== */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

/* ========== 按钮 ========== */
.btn-primary {
  background: var(--b1-informational-fg);
  color: #ffffff;
  border-radius: 12rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  width: 100%;
  line-height: 1.4;
}

.btn-primary::after { border: none; }

.btn-primary-disabled {
  background: #a0aec0;
  color: #ffffff;
}

.btn-secondary {
  background: #ffffff;
  color: var(--b1-informational-fg);
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border: 2rpx solid var(--b1-informational-fg);
  width: 100%;
  line-height: 1.4;
}

.btn-secondary::after { border: none; }

/* 学科颜色按钮变体 */
.btn-math    { background: var(--b1-subject-math-fg); }
.btn-chinese { background: var(--b1-subject-chinese-fg); }
.btn-english { background: var(--b1-subject-english-fg); }

.btn-math-outline    { color: var(--b1-subject-math-fg); border-color: var(--b1-subject-math-fg); background: #fff; }
.btn-chinese-outline { color: var(--b1-subject-chinese-fg); border-color: var(--b1-subject-chinese-fg); background: #fff; }
.btn-english-outline { color: var(--b1-subject-english-fg); border-color: var(--b1-subject-english-fg); background: #fff; }

/* ========== Badge 标签 ========== */
.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.badge-high   { background: #fed7d7; color: #9b2c2c; }
.badge-medium { background: #fefcbf; color: #975a16; }
.badge-low    { background: #c6f6d5; color: var(--b1-improved-fg); }
.badge-new    { background: #e9d8fd; color: #553c9a; }

/* ========== 空状态 ========== */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #718096;
}

.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-state .text {
  font-size: 28rpx;
  color: #a0aec0;
}

/* ========== 加载动画 ========== */
.loading-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.88);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-mask .spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: var(--b1-informational-fg);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-mask .text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #4a5568;
}

/* ========== 列表项 ========== */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #edf2f7;
}

.list-item:last-child { border-bottom: none; }

.list-item .content { flex: 1; }

.list-item .arrow {
  color: #cbd5e0;
  font-size: 32rpx;
}

/* ========== 进度条 ========== */
.progress-bar {
  height: 12rpx;
  background: #edf2f7;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar .fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

/* ========== 分隔线 ========== */
.divider {
  height: 1rpx;
  background: #edf2f7;
  margin: 20rpx 0;
}

/* ========== 页面顶部导航栏占位（自定义导航时用） ========== */
.nav-placeholder {
  height: 88rpx;
}

/* ========== 底部固定按钮区 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* ========== B+ high-density semantic visual system ========== */
.bplus-page {
  min-height: 100vh;
  overflow-x: hidden;
  color: #203342;
  background: #f3f6f7;
}

.bplus-section {
  min-width: 0;
}

.bplus-row {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.bplus-icon-label {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  line-height: 1.35;
}

.bplus-icon {
  flex: 0 0 auto;
  width: 46rpx;
  height: 46rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #e7eff2;
  font-size: 28rpx;
  line-height: 1;
}

.bplus-state {
  min-width: 0;
}

.bplus-state-strip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  color: #607483;
  font-size: 22rpx;
  line-height: 1.35;
}

.bplus-state-item {
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  white-space: nowrap;
}

.bplus-state-value {
  color: #294f62;
  font-size: 24rpx;
}

.bplus-action {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.bplus-action-main {
  flex: 1;
  min-width: 0;
}

.bplus-action-button {
  flex: 0 0 auto;
  min-height: 60rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #2468a8;
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.2;
}

.bplus-mini-bars {
  height: 28rpx;
  display: inline-flex;
  align-items: flex-end;
  gap: 4rpx;
}

.bplus-mini-bars > view {
  width: 6rpx;
  min-height: 6rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: #3f8b76;
}

.bplus-mini-bars > view:nth-child(1) { height: 26rpx; }
.bplus-mini-bars > view:nth-child(2) { height: 20rpx; }
.bplus-mini-bars > view:nth-child(3) { height: 13rpx; }

.bplus-empty,
.bplus-loading {
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 36rpx 28rpx;
  text-align: center;
  color: #6b7e8d;
}

.bplus-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* B1 FOUNDATION START */
page {
  --b1-ink-strong: #26383A;
  --b1-canvas: #F8F5EF;
  --b1-surface: #FFFDFA;
  --b1-ink: #253436;
  --b1-ink-muted: #566568;
  --b1-ink-subtle: #778386;
  --b1-border: #DEDBD2;
  --b1-subject-chinese-fg: #D4483A;
  --b1-subject-chinese-bg: #FDE1DC;
  --b1-subject-math-fg: #B37808;
  --b1-subject-math-bg: #FAE9B7;
  --b1-subject-english-fg: #4168B7;
  --b1-subject-english-bg: #E1E8FA;
  --b1-priority-fg: #DF5B3F;
  --b1-priority-bg: #F8E3DF;
  --b1-improved-fg: #16775E;
  --b1-improved-bg: #DFF1E9;
  --b1-informational-fg: #4168B7;
  --b1-informational-bg: #E6ECF8;
  --b1-waiting-fg: #A36C08;
  --b1-waiting-bg: #F8ECCB;
  --b1-destructive-fg: #A52F3A;
  --b1-destructive-bg: #F8DDE1;
  --b1-neutral-fg: #778386;
  --b1-neutral-bg: #F1EEE7;
}

.b1-page {
  min-height: 100vh;
  overflow-x: hidden;
  color: var(--b1-ink);
  background: var(--b1-canvas);
}

.b1-card {
  padding: 20rpx;
  border: 1rpx solid var(--b1-border);
  border-radius: 10rpx;
  background: var(--b1-surface);
}

.b1-dense-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-bottom: 1rpx solid var(--b1-border);
}

.b1-tag {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 12rpx;
  border-radius: 7rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}

.b1-segmented {
  display: flex;
  align-items: center;
  padding: 4rpx;
  border: 1rpx solid var(--b1-border);
  border-radius: 10rpx;
  background: var(--b1-neutral-bg);
}

.b1-button-primary,
.b1-button-secondary,
.b1-button-destructive {
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.b1-button-primary {
  color: var(--b1-surface);
  background: var(--b1-ink-strong);
}

.b1-button-secondary {
  color: var(--b1-ink);
  border: 2rpx solid var(--b1-border);
  background: var(--b1-surface);
}

.b1-button-destructive {
  color: var(--b1-destructive-fg);
  border: 2rpx solid var(--b1-destructive-fg);
  background: var(--b1-destructive-bg);
}

.b1-state-loading,
.b1-state-empty,
.b1-state-error {
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  color: var(--b1-ink-muted);
}

.b1-state-error {
  color: var(--b1-destructive-fg);
  background: var(--b1-destructive-bg);
}

.b1-chevron {
  flex: 0 0 auto;
  color: var(--b1-ink-subtle);
  font-size: 32rpx;
  font-weight: 500;
}

.b1-hit-target {
  min-width: 88rpx;
  min-height: 88rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.b1-subject-chinese {
  color: var(--b1-subject-chinese-fg);
  background: var(--b1-subject-chinese-bg);
}

.b1-subject-math {
  color: var(--b1-subject-math-fg);
  background: var(--b1-subject-math-bg);
}

.b1-subject-english {
  color: var(--b1-subject-english-fg);
  background: var(--b1-subject-english-bg);
}

.b1-priority {
  color: var(--b1-priority-fg);
  background: var(--b1-priority-bg);
}

.b1-improved {
  color: var(--b1-improved-fg);
  background: var(--b1-improved-bg);
}

.b1-informational {
  color: var(--b1-informational-fg);
  background: var(--b1-informational-bg);
}

.b1-waiting {
  color: var(--b1-waiting-fg);
  background: var(--b1-waiting-bg);
}

.b1-destructive {
  color: var(--b1-destructive-fg);
  background: var(--b1-destructive-bg);
}

.b1-neutral {
  color: var(--b1-neutral-fg);
  background: var(--b1-neutral-bg);
}

/* 白名单 emoji 图标统一尺寸（设计基调：28-32rpx，只辅助识别，必须保留文字） */
.b1-symbol {
  flex: 0 0 auto;
  font-size: 30rpx;
  line-height: 1.2;
}

/* 状态构成堆叠条：纯 WXSS 分段条，各页面复用（宽度由内联 style 百分比给出） */
.b1-seg-bar {
  display: flex;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: var(--b1-neutral-bg);
}

.b1-seg {
  height: 100%;
}

.b1-seg-improved { background: var(--b1-improved-fg); }
.b1-seg-waiting { background: var(--b1-waiting-fg); }
.b1-seg-destructive { background: var(--b1-destructive-fg); }
.b1-seg-informational { background: var(--b1-informational-fg); }
.b1-seg-priority { background: var(--b1-priority-fg); }
.b1-seg-neutral { background: var(--b1-border); }

.b1-seg-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 16rpx;
  margin-top: 10rpx;
}

.b1-seg-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--b1-ink-muted);
  line-height: 1.35;
}

.b1-seg-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
}
/* B1 FOUNDATION END */
