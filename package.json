{
  "name": "miniprogram-learning-diagnostic",
  "private": true,
  "bin": {
    "ldx": "cli/ldx.js"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test --test-concurrency=1 $(node scripts/list-unit-tests.js)",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-lines=80 --test-coverage-functions=80 $(node scripts/list-unit-tests.js)",
    "test:e2e:doctor": "node scripts/devtools-cli-doctor.js",
    "test:e2e:core": "node scripts/devtools-e2e-fullpage.js",
    "test:e2e:math": "npm run test:e2e:data-driven && npm run test:e2e:knowledge-map",
    "test:e2e:chinese": "node scripts/devtools-e2e-chinese.js",
    "test:e2e:english": "node scripts/devtools-english-e2e.js",
    "test:e2e:ai-usage": "node scripts/devtools-ai-usage-e2e.js",
    "test:e2e:real-data": "node scripts/devtools-real-data-smoke.js",
    "test:e2e:real-image": "node tests/e2e-real-image.test.js",
    "test:e2e:real-cloud": "RUN_REAL_CLOUD=1 node --test tests/e2e-real-cloud.test.js",
    "test:e2e:fullpage": "npm run test:e2e:core",
    "perf:baseline": "node scripts/performance-report.js",
    "perf:timeline": "node scripts/timeline-payload-baseline.js",
    "test:e2e-real-image": "npm run test:e2e:real-image",
    "test:devtools-english": "npm run test:e2e:english",
    "test:devtools-parent-timeline": "node scripts/devtools-parent-timeline-e2e.js",
    "test:e2e:family-density": "node scripts/devtools-family-density-e2e.js",
    "test:e2e:upload-history-layout": "node scripts/devtools-upload-history-layout.js",
    "test:real-data-smoke": "npm run test:e2e:real-data",
    "test:e2e:data-driven": "node scripts/devtools-e2e-data-driven.js",
    "test:e2e:knowledge-map": "node scripts/devtools-knowledge-map-e2e.js",
    "test:e2e:all": "npm run test:e2e:core && npm run test:e2e:math && npm run test:e2e:chinese && npm run test:e2e:english && npm run test:e2e:family-density && npm run test:e2e:upload-history-layout && node scripts/e2e-report-aggregator.js",
    "test:real-cloud": "npm run test:e2e:real-cloud",
    "vocab:english:build": "node scripts/build-english-vocabulary-seed.js",
    "metrics:student": "node scripts/learning-metrics.js",
    "check": "node scripts/check-js.js",
    "check:docs": "node scripts/check-docs.js",
    "check:indexes": "node scripts/check-database-indexes.js",
    "check:deployment": "npm run check:indexes && node --test tests/deployment-readiness.test.js",
    "predeploy:check": "node scripts/check-database-indexes.js --require-live-ack && npm run release:check",
    "release:check": "npm run check:deployment && npm run verify && npm run test:coverage",
    "verify": "npm run test:unit && npm run check && npm run lint",
    "lint": "eslint .",
    "check:size": "node scripts/check-main-package-size.js",
    "emoji:batch02:verify": "node scripts/emoji-compatibility/validate-batch-02-manifest.js --verify",
    "emoji:batch02:runtime": "node scripts/emoji-compatibility/generate-batch-02-runtime.js --write",
    "emoji:batch02:runtime:verify": "node scripts/emoji-compatibility/generate-batch-02-runtime.js --verify",
    "test:e2e:emoji-compat": "node scripts/devtools-emoji-compatibility-e2e.js",
    "perf:emoji-compat": "node scripts/devtools-emoji-package-metrics.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "adm-zip": "^0.5.16",
    "eslint": "^10.10.0",
    "fast-xml-parser": "^5.3.4"
  }
}
